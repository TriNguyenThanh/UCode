<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:UCode.Desktop.Controls"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <Style TargetType="{x:Type controls:UCodeWindow}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:UCodeWindow}">
                    <Border Background="Transparent">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Title Bar -->
                            <Border x:Name="PART_TitleBar" 
                                    Grid.Row="0" 
                                    Background="#99FFFFFF" 
                                    CornerRadius="12,12,0,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                                        <!-- macOS Buttons -->
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Close (Red) -->
                                            <Button Command="{x:Static SystemCommands.CloseWindowCommand}" Width="14" Height="14" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" Padding="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Width="14" Height="14">
                                                            <Ellipse Fill="#FF5F56" Stroke="#E0443E" StrokeThickness="0.5"/>
                                                            <iconPacks:PackIconMaterial Kind="Close" Width="6" Height="6" Foreground="#4E0002" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0" Name="Icon"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Icon" Property="Opacity" Value="0.5"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Minimize (Yellow) -->
                                            <Button Command="{x:Static SystemCommands.MinimizeWindowCommand}" Width="14" Height="14" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" Padding="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Width="14" Height="14">
                                                            <Ellipse Fill="#FFBD2E" Stroke="#DEA123" StrokeThickness="0.5"/>
                                                            <iconPacks:PackIconMaterial Kind="Minus" Width="6" Height="6" Foreground="#995700" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0" Name="Icon"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Icon" Property="Opacity" Value="0.5"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Maximize (Green) -->
                                            <Button Command="{x:Static SystemCommands.MaximizeWindowCommand}" Width="14" Height="14" BorderThickness="0" Cursor="Hand" Padding="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Width="14" Height="14">
                                                            <Ellipse Fill="#27C93F" Stroke="#1AAB29" StrokeThickness="0.5"/>
                                                            <iconPacks:PackIconMaterial Kind="Plus" Width="6" Height="6" Foreground="#006500" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0" Name="Icon"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Icon" Property="Opacity" Value="0.5"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>

                                        <!-- Divider -->
                                        <Rectangle Width="1" Height="16" Fill="#999" Margin="15,0,15,0"/>

                                        <!-- Favicon & Title -->
                                        <Image Source="{TemplateBinding Icon}" Width="16" Height="16" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{TemplateBinding Title}" VerticalAlignment="Center" FontFamily="Segoe UI, Be Vietnam Pro" FontSize="13" FontWeight="SemiBold" Foreground="#333"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Content -->
                            <Border Grid.Row="1" CornerRadius="0,0,12,12" ClipToBounds="True" Background="{TemplateBinding Background}">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
