<UserControl x:Class="UCode.Desktop.Views.Students.ClassDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:UCode.Desktop.Helpers"
             Background="#F5F5F5">

    <UserControl.Resources>
        <local:AssignmentStatusConverter x:Key="AssignmentStatusConverter"/>
        <local:AssignmentStatusToColorConverter x:Key="AssignmentStatusToColorConverter"/>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:AssignmentTypeConverter x:Key="AssignmentTypeConverter"/>
        <local:AssignmentTypeToColorConverter x:Key="AssignmentTypeToColorConverter"/>
        <local:DeadlineDisplayConverter x:Key="DeadlineDisplayConverter"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30">

                <!-- Class Header -->
                <Border Background="#00275E"
                        CornerRadius="8"
                        Padding="30"
                        Margin="0,0,0,30">
                    <Border.Effect>
                        <DropShadowEffect Color="Black"
                                          BlurRadius="10"
                                          ShadowDepth="2"
                                          Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Background="#FACB01"
                                CornerRadius="4"
                                Padding="8,4"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,15">
                            <TextBlock Text="{Binding ClassData.ClassCode}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       FontFamily="Be Vietnam Pro, Segoe UI"
                                       Foreground="#00275E"/>
                        </Border>
                        <TextBlock Text="{Binding ClassData.ClassName}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   FontFamily="Be Vietnam Pro, Segoe UI"
                                   Foreground="#FACB01"
                                   Margin="0,0,0,15"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#FACB01"
                                    CornerRadius="20"
                                    Padding="12,6"
                                    Margin="0,0,15,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Account"
                                                                Width="18"
                                                                Height="18"
                                                                Foreground="#00275E"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding ClassData.TeacherName}"
                                               Foreground="#00275E"
                                               FontFamily="Be Vietnam Pro, Segoe UI"
                                               FontWeight="Medium"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            
                        </StackPanel>
                        <TextBlock Text="{Binding ClassData.Description}"
                                   Foreground="#FACB01"
                                   FontFamily="Be Vietnam Pro, Segoe UI"
                                   FontSize="14"
                                   Margin="0,15,0,0"
                                   TextWrapping="Wrap"
                                   Opacity="0.9"/>
                    </StackPanel>
                </Border>

                <!-- Assignment Summary -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="Tổng số bài tập"
                                       FontSize="14"
                                       FontFamily="Be Vietnam Pro, Segoe UI"
                                       Foreground="#666"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Assignments.Count}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       FontFamily="Be Vietnam Pro, Segoe UI"
                                       Foreground="#FF9800"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="Tổng điểm tối đa"
                                       FontSize="14"
                                       FontFamily="Be Vietnam Pro, Segoe UI"
                                       Foreground="#666"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding TotalPoints}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       FontFamily="Be Vietnam Pro, Segoe UI"
                                       Foreground="#4CAF50"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Đang diễn ra"
                                       FontSize="14"
                                       FontFamily="Be Vietnam Pro, Segoe UI"
                                       Foreground="#666"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding PublishedCount}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       FontFamily="Be Vietnam Pro, Segoe UI"
                                       Foreground="#2196F3"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Assignments List -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FileDocumentMultiple"
                                                    Width="24"
                                                    Height="24"
                                                    Foreground="#FACB01"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,10,0"/>
                        <TextBlock Text="Danh sách bài tập"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   FontFamily="Be Vietnam Pro, Segoe UI"
                                   Foreground="#00275E"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Refresh Button -->
                    <Button Grid.Column="1"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource MahApps.Styles.Button.Flat}"
                            Background="#00275E"
                            Foreground="White"
                            Padding="12,8"
                            Cursor="Hand"
                            ToolTip="Làm mới dữ liệu">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Refresh"
                                                        Width="18"
                                                        Height="18"
                                                        Foreground="White"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0"/>
                            <TextBlock Text="Làm mới"
                                       FontSize="14"
                                       FontFamily="Be Vietnam Pro, Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding Assignments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,0,0,15"
                                    Padding="20"
                                    Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect Color="#E0E0E0"
                                                      BlurRadius="10"
                                                      ShadowDepth="2"
                                                      Opacity="0.5"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Grid.Column="0"
                                            Background="#00275E"
                                            Width="60"
                                            Height="60"
                                            CornerRadius="8"
                                            Margin="0,0,20,0">
                                        <iconPacks:PackIconMaterial Kind="FileDocumentOutline"
                                                                    Width="32"
                                                                    Height="32"
                                                                    Foreground="White"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Content -->
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="18"
                                                       FontFamily="Be Vietnam Pro, Segoe UI"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,10,0"
                                                       HorizontalAlignment="Left"/>
                                            <Border CornerRadius="12"
                                                    Padding="8,4">
                                                <Border.Background>
                                                    <Binding Path="AssignmentType">
                                                        <Binding.Converter>
                                                            <local:AssignmentTypeToColorConverter/>
                                                        </Binding.Converter>
                                                    </Binding>
                                                </Border.Background>
                                                <TextBlock FontSize="12"
                                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                                           Foreground="White">
                                                    <TextBlock.Text>
                                                        <Binding Path="AssignmentType">
                                                            <Binding.Converter>
                                                                <local:AssignmentTypeConverter/>
                                                            </Binding.Converter>
                                                        </Binding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="14"
                                                   FontFamily="Be Vietnam Pro, Segoe UI"
                                                   Foreground="#666"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,15"
                                                   HorizontalAlignment="Left"/>

                                        <StackPanel Orientation="Horizontal">
                                            <Border CornerRadius="12"
                                                    Padding="8,4"
                                                    Margin="0,0,10,0">
                                                <Border.Background>
                                                    <Binding Path="Status">
                                                        <Binding.Converter>
                                                            <local:AssignmentStatusToColorConverter/>
                                                        </Binding.Converter>
                                                    </Binding>
                                                </Border.Background>
                                                <TextBlock FontSize="12"
                                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                                           Foreground="White">
                                                    <TextBlock.Text>
                                                        <Binding Path="Status">
                                                            <Binding.Converter>
                                                                <local:AssignmentStatusConverter/>
                                                            </Binding.Converter>
                                                        </Binding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>
                                            <Border BorderBrush="#E0E0E0"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="8,4"
                                                    Margin="0,0,10,0">
                                                <TextBlock FontSize="12"
                                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                                           Foreground="#666">
                                                    <Run Text="{Binding TotalPoints}"/>
                                                    <Run Text="điểm"/>
                                                </TextBlock>
                                            </Border>
                                            <Border BorderBrush="#E0E0E0"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="8,4">
                                                <TextBlock FontSize="12"
                                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                                           Foreground="#666">
                                                    <Run Text="{Binding TotalProblems}"/>
                                                    <Run Text="bài"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <!-- Additional Info Row -->
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,10,0,0">
                                            <!-- Start Date -->
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,0,15,0">
                                                <iconPacks:PackIconMaterial Kind="CalendarClock"
                                                                            Width="16"
                                                                            Height="16"
                                                                            Foreground="#666"
                                                                            VerticalAlignment="Center"
                                                                            Margin="0,0,6,0"/>
                                                <TextBlock FontSize="12"
                                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                                           Foreground="#666"
                                                           VerticalAlignment="Center">
                                                    <Run Text="Bắt đầu: "/>
                                                    <Run Text="{Binding StartTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- End Date -->
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,0,15,0">
                                                <iconPacks:PackIconMaterial Kind="CalendarEnd"
                                                                            Width="16"
                                                                            Height="16"
                                                                            Foreground="#FF5722"
                                                                            VerticalAlignment="Center"
                                                                            Margin="0,0,6,0"/>
                                                <TextBlock FontSize="12"
                                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                                           Foreground="#FF5722"
                                                           VerticalAlignment="Center">
                                                    <Run Text="Hết hạn: "/>
                                                    <Run Text="{Binding EndTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}', TargetNullValue='Không giới hạn'}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Time Remaining -->
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,0,15,0">
                                                <iconPacks:PackIconMaterial Kind="TimerSand"
                                                                            Width="16"
                                                                            Height="16"
                                                                            Foreground="#2196F3"
                                                                            VerticalAlignment="Center"
                                                                            Margin="0,0,6,0"/>
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                                           Foreground="#2196F3"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding EndTime, Converter={StaticResource DeadlineDisplayConverter}}"/>
                                            </StackPanel>

                                            <!-- Allow Late Submission -->
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding AllowLateSubmission, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <iconPacks:PackIconMaterial Kind="ClockCheckOutline"
                                                                            Width="16"
                                                                            Height="16"
                                                                            Foreground="#4CAF50"
                                                                            VerticalAlignment="Center"
                                                                            Margin="0,0,6,0"/>
                                                <TextBlock Text="Cho phép nộp muộn"
                                                           FontSize="12"
                                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                                           Foreground="#4CAF50"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick"
                                                  Command="{Binding DataContext.NavigateToAssignmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding AssignmentId}"/>
                                </Border.InputBindings>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border Background="#DD000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="Đang tải dữ liệu..."
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
