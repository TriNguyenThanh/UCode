<mah:MetroWindow x:Class="UCode.Desktop.Views.Students.ClassDetailWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:local="clr-namespace:UCode.Desktop.Helpers"
                 Title="Chi tiết lớp học"
                 Height="800"
                 Width="1400"
                 WindowStartupLocation="CenterScreen"
                 TitleCharacterCasing="Normal"
                 ShowIconOnTitleBar="True"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}">

    <Window.Resources>
        <local:AssignmentStatusConverter x:Key="AssignmentStatusConverter"/>
        <local:AssignmentStatusToColorConverter x:Key="AssignmentStatusToColorConverter"/>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:AssignmentTypeConverter x:Key="AssignmentTypeConverter"/>

        <!-- Custom Navigation Button Style - No gray background -->
        <Style x:Key="NavButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MahApps.Styles.Button.Flat}">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#20FACB01"/>
                    <Setter Property="Foreground"
                            Value="#FACB01"/>
                </Trigger>
                <Trigger Property="IsPressed"
                         Value="True">
                    <Setter Property="Background"
                            Value="#30FACB01"/>
                    <Setter Property="Foreground"
                            Value="#FACB01"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0"
                Background="#00275E"
                Height="64"
                Panel.ZIndex="10">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Grid.Column="0"
                        Style="{StaticResource NavButtonStyle}"
                        Foreground="#FACB01"
                        FontFamily="Be Vietnam Pro, Segoe UI"
                        FontWeight="Medium"
                        Command="{Binding NavigateBackCommand}"
                        Cursor="Hand"
                        Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ArrowLeft"
                                                    Width="20"
                                                    Height="20"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>
                        <TextBlock Text="Quay lại"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Title -->
                <TextBlock Grid.Column="1"
                           Text="Chi tiết lớp học"
                           FontSize="20"
                           FontWeight="Bold"
                           FontFamily="Be Vietnam Pro, Segoe UI"
                           Foreground="#FACB01"
                           VerticalAlignment="Center"/>

                <!-- Refresh Button -->
                <Button Grid.Column="2"
                        Style="{StaticResource NavButtonStyle}"
                        Foreground="#FACB01"
                        Command="{Binding RefreshCommand}"
                        Cursor="Hand"
                        ToolTip="Làm mới">
                    <iconPacks:PackIconMaterial Kind="Refresh"
                                                Width="24"
                                                Height="24"
                                                VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Background="#F5F5F5">
            <StackPanel Margin="40,30">

                <!-- Class Header -->
                <Border Background="#00275E"
                        CornerRadius="8"
                        Padding="30"
                        Margin="0,0,0,30">
                    <Border.Effect>
                        <DropShadowEffect Color="Black"
                                          BlurRadius="10"
                                          ShadowDepth="2"
                                          Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Background="#FACB01"
                                CornerRadius="4"
                                Padding="8,4"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,15">
                            <TextBlock Text="{Binding ClassData.ClassCode}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       FontFamily="Be Vietnam Pro, Segoe UI"
                                       Foreground="#00275E"/>
                        </Border>
                        <TextBlock Text="{Binding ClassData.ClassName}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   FontFamily="Be Vietnam Pro, Segoe UI"
                                   Foreground="#FACB01"
                                   Margin="0,0,0,15"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#FACB01"
                                    CornerRadius="20"
                                    Padding="12,6"
                                    Margin="0,0,15,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Account"
                                                                Width="18"
                                                                Height="18"
                                                                Foreground="#00275E"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding ClassData.TeacherName}"
                                               Foreground="#00275E"
                                               FontFamily="Be Vietnam Pro, Segoe UI"
                                               FontWeight="Medium"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FACB01"
                                    CornerRadius="20"
                                    Padding="12,6">
                                <TextBlock Text="{Binding ClassData.Semester}"
                                           Foreground="#00275E"
                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                           FontWeight="Medium"
                                           FontSize="14"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ClassData.Description}"
                                   Foreground="#FACB01"
                                   FontFamily="Be Vietnam Pro, Segoe UI"
                                   FontSize="14"
                                   Margin="0,15,0,0"
                                   TextWrapping="Wrap"
                                   Opacity="0.9"/>
                    </StackPanel>
                </Border>

                <!-- Assignment Summary -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="Tổng số bài tập"
                                       FontSize="14"
                                       FontFamily="Be Vietnam Pro, Segoe UI"
                                       Foreground="#666"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Assignments.Count}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       FontFamily="Be Vietnam Pro, Segoe UI"
                                       Foreground="#00275E"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="Tổng điểm tối đa"
                                       FontSize="14"
                                       Foreground="#666"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding DataContext.TotalPoints, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#4CAF50"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Đang diễn ra"
                                       FontSize="14"
                                       Foreground="#666"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding DataContext.PublishedCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#2196F3"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Assignments List -->
                <TextBlock Text="Danh sách bài tập"
                           FontSize="24"
                           FontWeight="SemiBold"
                           FontFamily="Be Vietnam Pro, Segoe UI"
                           Foreground="#00275E"
                           Margin="0,0,0,20"/>

                <ItemsControl ItemsSource="{Binding Assignments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.NavigateToAssignmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding AssignmentId}"
                                    Cursor="Hand"
                                    Margin="0,0,0,15">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="White"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="20">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#E0E0E0"
                                                                  BlurRadius="10"
                                                                  ShadowDepth="2"
                                                                  Opacity="0.5"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon -->
                                                <Border Grid.Column="0"
                                                        Background="#00275E"
                                                        Width="60"
                                                        Height="60"
                                                        CornerRadius="8"
                                                        Margin="0,0,20,0">
                                                    <iconPacks:PackIconMaterial Kind="ClipboardText"
                                                                                Width="32"
                                                                                Height="32"
                                                                                Foreground="White"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Content -->
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal"
                                                                Margin="0,0,0,10">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="18"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,0,10,0"
                                                                   HorizontalAlignment="Left"/>
                                                        <Border Background="#E3F2FD"
                                                                CornerRadius="12"
                                                                Padding="8,4">
                                                            <TextBlock FontSize="12"
                                                                       Foreground="#1976D2">
                                                                <TextBlock.Text>
                                                                    <Binding Path="AssignmentType">
                                                                        <Binding.Converter>
                                                                            <local:AssignmentTypeConverter/>
                                                                        </Binding.Converter>
                                                                    </Binding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="14"
                                                               Foreground="#666"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,15"
                                                               HorizontalAlignment="Left"/>

                                                    <StackPanel Orientation="Horizontal">
                                                        <Border CornerRadius="12"
                                                                Padding="8,4"
                                                                Margin="0,0,10,0">
                                                            <Border.Background>
                                                                <Binding Path="Status">
                                                                    <Binding.Converter>
                                                                        <local:AssignmentStatusToColorConverter/>
                                                                    </Binding.Converter>
                                                                </Binding>
                                                            </Border.Background>
                                                            <TextBlock FontSize="12"
                                                                       Foreground="White">
                                                                <TextBlock.Text>
                                                                    <Binding Path="Status">
                                                                        <Binding.Converter>
                                                                            <local:AssignmentStatusConverter/>
                                                                        </Binding.Converter>
                                                                    </Binding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </Border>
                                                        <Border BorderBrush="#E0E0E0"
                                                                BorderThickness="1"
                                                                CornerRadius="12"
                                                                Padding="8,4"
                                                                Margin="0,0,10,0">
                                                            <TextBlock FontSize="12"
                                                                       Foreground="#666">
                                                                <Run Text="{Binding TotalPoints}"/>
                                                                <Run Text="điểm"/>
                                                            </TextBlock>
                                                        </Border>
                                                        <Border BorderBrush="#E0E0E0"
                                                                BorderThickness="1"
                                                                CornerRadius="12"
                                                                Padding="8,4">
                                                            <TextBlock FontSize="12"
                                                                       Foreground="#666">
                                                                <Run Text="{Binding TotalProblems}"/>
                                                                <Run Text="bài"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty State -->
                <Border Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="40">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Assignments.Count}"
                                             Value="0">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Chưa có bài tập nào được giao 📝"
                               FontSize="16"
                               Foreground="#666"
                               HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Background="#DD000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <mah:ProgressRing IsActive="True"
                                  Width="80"
                                  Height="80"
                                  Foreground="White"
                                  Margin="0,0,0,20"/>
                <TextBlock Text="Đang tải dữ liệu..."
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
