<mah:MetroWindow x:Class="UCode.Desktop.Views.Students.TestCaseResultDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
                  Dialog:DialogParticipation.Register="{Binding}"
                  Title="Chi tiết Test Cases"
                  Height="600"
                  Width="1000"
                  WindowStartupLocation="CenterOwner"
                  ShowInTaskbar="True"
                  ResizeMode="NoResize"
                  ShowMinButton="False"
                  ShowMaxRestoreButton="False"
                  Background="#F5F5F7"
                  FontFamily="Be Vietnam Pro, Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">
            <TextBlock Text="Chi tiết Test Cases"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <TextBlock FontSize="13"
                       Foreground="#666">
                <Run Text="Submission: "/>
                <Run Text="{Binding SubmissionId, Mode=OneWay}"
                     FontFamily="Consolas"/>
            </TextBlock>
        </StackPanel>

        <!-- Tổng quan -->
        <Border Grid.Row="1"
                Background="#F0F0F0"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Tổng quan"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>
                <WrapPanel Orientation="Horizontal">
                    <!-- Passed -->
                    <Border Background="#4CAF50"
                            CornerRadius="20"
                            Padding="12,8"
                            Margin="0,0,8,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Grid.Column="0"
                                                        Kind="CheckCircle"
                                                        Width="16"
                                                        Height="16"
                                                        Foreground="White"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center"><Run Text="Passed: "/><Run Text="{Binding PassedTestcase, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding TotalTestcase, Mode=OneWay}"/></TextBlock>
                        </Grid>
                    </Border>

                    <!-- Wrong Answer -->
                    <Border x:Name="WrongAnswerChip"
                            Background="#F44336"
                            CornerRadius="20"
                            Padding="10,6"
                            Margin="0,0,8,8"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Grid.Column="0"
                                                        Kind="CloseCircle"
                                                        Width="14"
                                                        Height="14"
                                                        Foreground="White"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="WrongAnswerText"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Time Limit Exceeded -->
                    <Border x:Name="TLEChip"
                            Background="#FF9800"
                            CornerRadius="20"
                            Padding="10,6"
                            Margin="0,0,8,8"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Grid.Column="0"
                                                        Kind="ClockAlert"
                                                        Width="14"
                                                        Height="14"
                                                        Foreground="White"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="TLEText"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Memory Limit Exceeded -->
                    <Border x:Name="MLEChip"
                            Background="#FF9800"
                            CornerRadius="20"
                            Padding="10,6"
                            Margin="0,0,8,8"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Grid.Column="0"
                                                        Kind="Memory"
                                                        Width="14"
                                                        Height="14"
                                                        Foreground="White"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="MLEText"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Runtime Error -->
                    <Border x:Name="RuntimeErrorChip"
                            Background="#F44336"
                            CornerRadius="20"
                            Padding="10,6"
                            Margin="0,0,8,8"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Grid.Column="0"
                                                        Kind="AlertCircle"
                                                        Width="14"
                                                        Height="14"
                                                        Foreground="White"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="RuntimeErrorText"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Compilation Error -->
                    <Border x:Name="CompilationErrorChip"
                            Background="#F44336"
                            CornerRadius="20"
                            Padding="10,6"
                            Margin="0,0,8,8"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Grid.Column="0"
                                                        Kind="Wrench"
                                                        Width="14"
                                                        Height="14"
                                                        Foreground="White"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="CompilationErrorText"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Internal Error -->
                    <Border x:Name="InternalErrorChip"
                            Background="#F44336"
                            CornerRadius="20"
                            Padding="10,6"
                            Margin="0,0,8,8"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Grid.Column="0"
                                                        Kind="Alert"
                                                        Width="14"
                                                        Height="14"
                                                        Foreground="White"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="InternalErrorText"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Skipped -->
                    <Border x:Name="SkippedChip"
                            Background="#9E9E9E"
                            CornerRadius="20"
                            Padding="10,6"
                            Margin="0,0,8,8"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Grid.Column="0"
                                                        Kind="SkipNext"
                                                        Width="14"
                                                        Height="14"
                                                        Foreground="White"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="SkippedText"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Chi tiết từng test case -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Chi tiết từng test case"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <ItemsControl x:Name="TestCasesItemsControl"
                              ItemsSource="{Binding TestCaseResults}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"
                                         HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1,1,1,1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,12,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="BorderThickness" Value="1,1,1,1"/>
                                        <Style.Triggers>
                                            <!-- Passed - Green border -->
                                            <DataTrigger Binding="{Binding StatusCode}"
                                                         Value="0">
                                                <Setter Property="BorderBrush"
                                                        Value="#4CAF50"/>
                                                <Setter Property="BorderThickness"
                                                        Value="4,1,1,1"/>
                                            </DataTrigger>
                                            <!-- Time Limit Exceeded - Orange border -->
                                            <DataTrigger Binding="{Binding StatusCode}"
                                                         Value="1">
                                                <Setter Property="BorderBrush"
                                                        Value="#FF9800"/>
                                                <Setter Property="BorderThickness"
                                                        Value="4,1,1,1"/>
                                            </DataTrigger>
                                            <!-- Memory Limit Exceeded - Orange border -->
                                            <DataTrigger Binding="{Binding StatusCode}"
                                                         Value="2">
                                                <Setter Property="BorderBrush"
                                                        Value="#FF9800"/>
                                                <Setter Property="BorderThickness"
                                                        Value="4,1,1,1"/>
                                            </DataTrigger>
                                            <!-- Runtime Error - Red border -->
                                            <DataTrigger Binding="{Binding StatusCode}"
                                                         Value="3">
                                                <Setter Property="BorderBrush"
                                                        Value="#F44336"/>
                                                <Setter Property="BorderThickness"
                                                        Value="4,1,1,1"/>
                                            </DataTrigger>
                                            <!-- Internal Error - Red border -->
                                            <DataTrigger Binding="{Binding StatusCode}"
                                                         Value="4">
                                                <Setter Property="BorderBrush"
                                                        Value="#F44336"/>
                                                <Setter Property="BorderThickness"
                                                        Value="4,1,1,1"/>
                                            </DataTrigger>
                                            <!-- Wrong Answer - Red border -->
                                            <DataTrigger Binding="{Binding StatusCode}"
                                                         Value="5">
                                                <Setter Property="BorderBrush"
                                                        Value="#F44336"/>
                                                <Setter Property="BorderThickness"
                                                        Value="4,1,1,1"/>
                                            </DataTrigger>
                                            <!-- Compilation Error - Red border -->
                                            <DataTrigger Binding="{Binding StatusCode}"
                                                         Value="6">
                                                <Setter Property="BorderBrush"
                                                        Value="#F44336"/>
                                                <Setter Property="BorderThickness"
                                                        Value="4,1,1,1"/>
                                            </DataTrigger>
                                            <!-- Skipped - Gray border -->
                                            <DataTrigger Binding="{Binding StatusCode}"
                                                         Value="7">
                                                <Setter Property="BorderBrush"
                                                        Value="#9E9E9E"/>
                                                <Setter Property="BorderThickness"
                                                        Value="4,1,1,1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Test Case Header -->
                                    <Grid Grid.Row="0"
                                          Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center">
                                            <Run Text="Test #"/>
                                            <Run Text="{Binding Number}"/>
                                        </TextBlock>
                                        <iconPacks:PackIconMaterial Grid.Column="1"
                                                                    Width="18"
                                                                    Height="18"
                                                                    VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial.Style>
                                                <Style TargetType="iconPacks:PackIconMaterial">
                                                    <Setter Property="Kind" Value="HelpCircle"/>
                                                    <Setter Property="Foreground" Value="#9E9E9E"/>
                                                    <Style.Triggers>
                                                        <!-- Passed -->
                                                        <DataTrigger Binding="{Binding StatusCode}"
                                                                     Value="0">
                                                            <Setter Property="Kind"
                                                                    Value="CheckCircle"/>
                                                            <Setter Property="Foreground"
                                                                    Value="#4CAF50"/>
                                                        </DataTrigger>
                                                        <!-- Time Limit Exceeded -->
                                                        <DataTrigger Binding="{Binding StatusCode}"
                                                                     Value="1">
                                                            <Setter Property="Kind"
                                                                    Value="ClockAlert"/>
                                                            <Setter Property="Foreground"
                                                                    Value="#FF9800"/>
                                                        </DataTrigger>
                                                        <!-- Memory Limit Exceeded -->
                                                        <DataTrigger Binding="{Binding StatusCode}"
                                                                     Value="2">
                                                            <Setter Property="Kind"
                                                                    Value="Memory"/>
                                                            <Setter Property="Foreground"
                                                                    Value="#FF9800"/>
                                                        </DataTrigger>
                                                        <!-- Runtime Error -->
                                                        <DataTrigger Binding="{Binding StatusCode}"
                                                                     Value="3">
                                                            <Setter Property="Kind"
                                                                    Value="AlertCircle"/>
                                                            <Setter Property="Foreground"
                                                                    Value="#F44336"/>
                                                        </DataTrigger>
                                                        <!-- Internal Error -->
                                                        <DataTrigger Binding="{Binding StatusCode}"
                                                                     Value="4">
                                                            <Setter Property="Kind"
                                                                    Value="Alert"/>
                                                            <Setter Property="Foreground"
                                                                    Value="#F44336"/>
                                                        </DataTrigger>
                                                        <!-- Wrong Answer -->
                                                        <DataTrigger Binding="{Binding StatusCode}"
                                                                     Value="5">
                                                            <Setter Property="Kind"
                                                                    Value="CloseCircle"/>
                                                            <Setter Property="Foreground"
                                                                    Value="#F44336"/>
                                                        </DataTrigger>
                                                        <!-- Compilation Error -->
                                                        <DataTrigger Binding="{Binding StatusCode}"
                                                                     Value="6">
                                                            <Setter Property="Kind"
                                                                    Value="Wrench"/>
                                                            <Setter Property="Foreground"
                                                                    Value="#F44336"/>
                                                        </DataTrigger>
                                                        <!-- Skipped -->
                                                        <DataTrigger Binding="{Binding StatusCode}"
                                                                     Value="7">
                                                            <Setter Property="Kind"
                                                                    Value="SkipNext"/>
                                                            <Setter Property="Foreground"
                                                                    Value="#9E9E9E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </iconPacks:PackIconMaterial.Style>
                                        </iconPacks:PackIconMaterial>
                                    </Grid>

                                    <!-- Status Badge -->
                                    <Border Grid.Row="1"
                                            CornerRadius="20"
                                            Padding="10,6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#9E9E9E"/>
                                                <Style.Triggers>
                                                    <!-- Passed -->
                                                    <DataTrigger Binding="{Binding StatusCode}"
                                                                 Value="0">
                                                        <Setter Property="Background"
                                                                Value="#4CAF50"/>
                                                    </DataTrigger>
                                                    <!-- Time Limit Exceeded -->
                                                    <DataTrigger Binding="{Binding StatusCode}"
                                                                 Value="1">
                                                        <Setter Property="Background"
                                                                Value="#FF9800"/>
                                                    </DataTrigger>
                                                    <!-- Memory Limit Exceeded -->
                                                    <DataTrigger Binding="{Binding StatusCode}"
                                                                 Value="2">
                                                        <Setter Property="Background"
                                                                Value="#FF9800"/>
                                                    </DataTrigger>
                                                    <!-- Runtime Error -->
                                                    <DataTrigger Binding="{Binding StatusCode}"
                                                                 Value="3">
                                                        <Setter Property="Background"
                                                                Value="#F44336"/>
                                                    </DataTrigger>
                                                    <!-- Internal Error -->
                                                    <DataTrigger Binding="{Binding StatusCode}"
                                                                 Value="4">
                                                        <Setter Property="Background"
                                                                Value="#F44336"/>
                                                    </DataTrigger>
                                                    <!-- Wrong Answer -->
                                                    <DataTrigger Binding="{Binding StatusCode}"
                                                                 Value="5">
                                                        <Setter Property="Background"
                                                                Value="#F44336"/>
                                                    </DataTrigger>
                                                    <!-- Compilation Error -->
                                                    <DataTrigger Binding="{Binding StatusCode}"
                                                                 Value="6">
                                                        <Setter Property="Background"
                                                                Value="#F44336"/>
                                                    </DataTrigger>
                                                    <!-- Skipped -->
                                                    <DataTrigger Binding="{Binding StatusCode}"
                                                                 Value="7">
                                                        <Setter Property="Background"
                                                                Value="#9E9E9E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Button Grid.Row="3"
                Content="ĐÓNG"
                Width="120"
                Height="40"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"
                Background="#FACB01"
                Foreground="#00275E"
                BorderThickness="0"
                FontWeight="SemiBold"
                FontSize="14"
                Click="CloseButton_Click"
                Cursor="Hand">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Opacity"
                                    Value="0.9"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</mah:MetroWindow>