<controls:UCodeWindow x:Class="UCode.Desktop.Views.Students.TestCaseResultDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  xmlns:controls="clr-namespace:UCode.Desktop.Controls"
                  Title="Chi tiết Test Cases"
                  Height="600"
                  Width="1000"
                  WindowStartupLocation="CenterOwner"
                  ShowInTaskbar="True"
                  ResizeMode="CanResize"
                  Background="#F5F5F7"
                  FontFamily="Be Vietnam Pro, Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">
            <TextBlock Text="Chi tiết Test Cases"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <TextBlock FontSize="13"
                       Foreground="#666">
                <Run Text="Submission: "/>
                <Run Text="{Binding SubmissionId, Mode=OneWay}"
                     FontFamily="Consolas"/>
            </TextBlock>
        </StackPanel>

        <!-- Tổng quan -->
        <Border Grid.Row="1"
                Background="#F0F0F0"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Tổng quan"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>
                <Border Background="#4CAF50"
                        CornerRadius="20"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   VerticalAlignment="Center">
                            <Run Text="Passed: "/>
                            <Run Text="{Binding PassedTestcase, Mode=OneWay}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding TotalTestcase, Mode=OneWay}"/>
                        </TextBlock>
                        <iconPacks:PackIconMaterial Grid.Column="1"
                                                    Kind="CheckCircle"
                                                    Width="18"
                                                    Height="18"
                                                    Foreground="White"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,0,0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Chi tiết từng test case -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Chi tiết từng test case"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <ItemsControl x:Name="TestCasesItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"
                                         HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,12,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusCode}"
                                                         Value="0">
                                                <Setter Property="BorderBrush"
                                                        Value="#4CAF50"/>
                                                <Setter Property="BorderThickness"
                                                        Value="2,2,2,2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Test Case Header -->
                                    <Grid Grid.Row="0"
                                          Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center">
                                            <Run Text="Test #"/>
                                            <Run Text="{Binding Number}"/>
                                        </TextBlock>
                                        <iconPacks:PackIconMaterial Grid.Column="1"
                                                                    Width="18"
                                                                    Height="18"
                                                                    VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial.Style>
                                                <Style TargetType="iconPacks:PackIconMaterial">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusCode}"
                                                                     Value="0">
                                                            <Setter Property="Kind"
                                                                    Value="CheckCircle"/>
                                                            <Setter Property="Foreground"
                                                                    Value="#4CAF50"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusCode}"
                                                                     Value="5">
                                                            <Setter Property="Kind"
                                                                    Value="CloseCircle"/>
                                                            <Setter Property="Foreground"
                                                                    Value="#F44336"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </iconPacks:PackIconMaterial.Style>
                                        </iconPacks:PackIconMaterial>
                                    </Grid>

                                    <!-- Status Badge -->
                                    <Border Grid.Row="1"
                                            CornerRadius="20"
                                            Padding="10,6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusCode}"
                                                                 Value="0">
                                                        <Setter Property="Background"
                                                                Value="#4CAF50"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusCode}"
                                                                 Value="1">
                                                        <Setter Property="Background"
                                                                Value="#FF9800"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusCode}"
                                                                 Value="2">
                                                        <Setter Property="Background"
                                                                Value="#FF9800"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusCode}"
                                                                 Value="3">
                                                        <Setter Property="Background"
                                                                Value="#F44336"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusCode}"
                                                                 Value="4">
                                                        <Setter Property="Background"
                                                                Value="#F44336"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusCode}"
                                                                 Value="5">
                                                        <Setter Property="Background"
                                                                Value="#F44336"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusCode}"
                                                                 Value="6">
                                                        <Setter Property="Background"
                                                                Value="#F44336"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Button Grid.Row="3"
                Content="ĐÓNG"
                Width="120"
                Height="40"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"
                Background="#FACB01"
                Foreground="#00275E"
                BorderThickness="0"
                FontWeight="SemiBold"
                FontSize="14"
                Click="CloseButton_Click"
                Cursor="Hand">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Opacity"
                                    Value="0.9"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</controls:UCodeWindow>