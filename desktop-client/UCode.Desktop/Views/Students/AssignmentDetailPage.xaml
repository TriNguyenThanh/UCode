<UserControl x:Class="UCode.Desktop.Views.Students.AssignmentDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:UCode.Desktop.Helpers"
             Background="#F5F5F5">

    <UserControl.Resources>
        <local:AssignmentStatusConverter x:Key="AssignmentStatusConverter"/>
        <local:AssignmentStatusToColorConverter x:Key="AssignmentStatusToColorConverter"/>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:AssignmentTypeConverter x:Key="AssignmentTypeConverter"/>
        <local:AssignmentTypeToColorConverter x:Key="AssignmentTypeToColorConverter"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30">

                <!-- Back Button -->
                <Button Style="{DynamicResource MahApps.Styles.Button.Flat}"
                        Foreground="#00275E"
                        Command="{Binding NavigateBackCommand}"
                        Cursor="Hand"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ArrowLeft"
                                                    Width="20"
                                                    Height="20"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>
                        <TextBlock Text="Quay lại"
                                   FontSize="15"
                                   FontFamily="Be Vietnam Pro, Segoe UI"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Assignment Header -->
                <Border Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="30"
                        Margin="0,0,0,30">
                    <Border.Effect>
                        <DropShadowEffect Color="#E0E0E0"
                                          BlurRadius="10"
                                          ShadowDepth="2"
                                          Opacity="0.5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{Binding Assignment.Title}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   FontFamily="Be Vietnam Pro, Segoe UI"
                                   Margin="0,0,0,15"/>
                        <TextBlock Text="{Binding Assignment.Description}"
                                   FontSize="14"
                                   FontFamily="Be Vietnam Pro, Segoe UI"
                                   Foreground="#666"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,15">
                            <Border CornerRadius="12"
                                    Padding="8,4"
                                    Margin="0,0,10,0">
                                <Border.Background>
                                    <Binding Path="Assignment.AssignmentType">
                                        <Binding.Converter>
                                            <local:AssignmentTypeToColorConverter/>
                                        </Binding.Converter>
                                    </Binding>
                                </Border.Background>
                                <TextBlock FontSize="12"
                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                           Foreground="White">
                                    <TextBlock.Text>
                                        <Binding Path="Assignment.AssignmentType">
                                            <Binding.Converter>
                                                <local:AssignmentTypeConverter/>
                                            </Binding.Converter>
                                        </Binding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>
                            <Border CornerRadius="12"
                                    Padding="8,4"
                                    Margin="0,0,10,0">
                                <Border.Background>
                                    <Binding Path="Assignment.Status">
                                        <Binding.Converter>
                                            <local:AssignmentStatusToColorConverter/>
                                        </Binding.Converter>
                                    </Binding>
                                </Border.Background>
                                <TextBlock FontSize="12"
                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                           Foreground="White">
                                    <TextBlock.Text>
                                        <Binding Path="Assignment.Status">
                                            <Binding.Converter>
                                                <local:AssignmentStatusConverter/>
                                            </Binding.Converter>
                                        </Binding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>
                            <Border BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8,4">
                                <TextBlock FontSize="12"
                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                           Foreground="#666">
                                    <Run Text="{Binding Assignment.TotalPoints}"/>
                                    <Run Text="điểm"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <!-- Statistics Cards -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Problem Count -->
                            <Border Grid.Column="0"
                                    Background="#F5F5F5"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20"
                                    Margin="0,0,15,0">
                                <StackPanel>
                                    <TextBlock Text="Số câu hỏi"
                                               FontSize="14"
                                               FontFamily="Be Vietnam Pro, Segoe UI"
                                               Foreground="#666"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Problems.Count}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               FontFamily="Be Vietnam Pro, Segoe UI"
                                               Foreground="#00275E"/>
                                </StackPanel>
                            </Border>

                            <!-- Total Points -->
                            <Border Grid.Column="1"
                                    Background="#F5F5F5"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20"
                                    Margin="0,0,15,0">
                                <StackPanel>
                                    <TextBlock Text="Tổng điểm"
                                               FontSize="14"
                                               FontFamily="Be Vietnam Pro, Segoe UI"
                                               Foreground="#666"
                                               Margin="0,0,0,8"/>
                                    <TextBlock FontSize="28"
                                               FontWeight="Bold"
                                               FontFamily="Be Vietnam Pro, Segoe UI"
                                               Foreground="#4CAF50">
                                        <Run Text="{Binding Assignment.TotalPoints}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- User Score -->
                            <Border Grid.Column="2"
                                    Background="#F5F5F5"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Điểm của bạn"
                                               FontSize="14"
                                               FontFamily="Be Vietnam Pro, Segoe UI"
                                               Foreground="#666"
                                               Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UserScore, FallbackValue=0}"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   FontFamily="Be Vietnam Pro, Segoe UI"
                                                   Foreground="#2196F3"/>
                                        <TextBlock Text="/"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   FontFamily="Be Vietnam Pro, Segoe UI"
                                                   Foreground="#666"
                                                   Margin="4,0"/>
                                        <TextBlock Text="{Binding Assignment.TotalPoints}"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   FontFamily="Be Vietnam Pro, Segoe UI"
                                                   Foreground="#666"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Progress Bar -->
                        <StackPanel Margin="0,20,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Tiến độ hoàn thành"
                                           FontSize="14"
                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                           FontWeight="SemiBold"/>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">
                                    <TextBlock FontSize="14"
                                               FontFamily="Be Vietnam Pro, Segoe UI"
                                               FontWeight="SemiBold">
                                        <Run Text="{Binding CompletedProblemsCount, Mode=OneWay}"/>
                                        <Run Text="/"/>
                                        <Run Text="{Binding Problems.Count, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text=" - "
                                               FontSize="14"
                                               FontFamily="Be Vietnam Pro, Segoe UI"
                                               Margin="4,0"/>
                                    <TextBlock FontSize="14"
                                               FontFamily="Be Vietnam Pro, Segoe UI"
                                               FontWeight="SemiBold"
                                               Foreground="#4CAF50">
                                        <Run Text="{Binding ProgressPercentage, Mode=OneWay, StringFormat='{}{0:F0}'}"/>
                                        <Run Text="%"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ProgressPercentage, Mode=OneWay}"
                                         Height="10"
                                         Foreground="#4CAF50"
                                         Background="#E0E0E0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Problems List -->
                <TextBlock Text="Danh sách câu hỏi"
                           FontSize="24"
                           FontWeight="SemiBold"
                           FontFamily="Be Vietnam Pro, Segoe UI"
                           Margin="0,0,0,20"/>

                <ItemsControl ItemsSource="{Binding Problems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,0,0,15"
                                    Padding="20"
                                    Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect Color="#E0E0E0"
                                                      BlurRadius="10"
                                                      ShadowDepth="2"
                                                      Opacity="0.5"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Problem Number -->
                                    <Border Grid.Column="0"
                                            Background="#00275E"
                                            Width="50"
                                            Height="50"
                                            CornerRadius="25"
                                            Margin="0,0,20,0">
                                        <TextBlock Text="{Binding OrderIndex}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Problem Info -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Be Vietnam Pro, Segoe UI"
                                                   Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#FACB01"
                                                    CornerRadius="12"
                                                    Padding="8,4"
                                                    Margin="0,0,10,0">
                                                <TextBlock FontSize="12"
                                                           Foreground="#00275E"
                                                           FontFamily="Be Vietnam Pro, Segoe UI">
                                                    <Run Text="{Binding Points}"/>
                                                    <Run Text="điểm"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick"
                                                  Command="{Binding DataContext.NavigateToProblemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding ProblemId}"/>
                                </Border.InputBindings>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border Background="#DD000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="Đang tải dữ liệu..."
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
