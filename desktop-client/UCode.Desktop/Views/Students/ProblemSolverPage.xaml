<UserControl x:Class="UCode.Desktop.Views.Students.ProblemSolverPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:UCode.Desktop.Helpers"
             Background="#F8F9FA">

    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <local:InverseCountToVisibilityConverter x:Key="InverseCountToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#00275E"
                Height="64">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Grid.Column="0"
                        Style="{DynamicResource MahApps.Styles.Button.Flat}"
                        Foreground="White"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Command="{Binding NavigateBackCommand}"
                        VerticalAlignment="Center"
                        Padding="8,6">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ArrowLeft"
                                                    Width="20"
                                                    Height="20"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>
                        <TextBlock Text="Quay lại"
                                   FontFamily="Be Vietnam Pro, Segoe UI"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Title -->
                <TextBlock Grid.Column="1"
                           Text="{Binding Problem.Title}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           FontFamily="Be Vietnam Pro, Segoe UI"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"/>

                <!-- Difficulty Badge -->
                <Border Grid.Column="2"
                        Background="#FACB01"
                        CornerRadius="4"
                        Padding="10,6"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Problem.Difficulty}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               FontFamily="Be Vietnam Pro, Segoe UI"
                               Foreground="#00275E"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1"
              Background="#F8F9FA">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Problem Description -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,1,1,0">
                <mah:MetroTabControl mah:TabControlHelper.Underlined="SelectedTabItem"
                                     mah:TabControlHelper.UnderlineBrush="#FACB01"
                                     mah:TabControlHelper.UnderlineSelectedBrush="#FACB01"
                                     Background="White"
                                     FontSize="13"
                                     FontFamily="Be Vietnam Pro, Segoe UI">
                    <mah:MetroTabControl.Resources>
                        <Style TargetType="mah:MetroTabItem"
                               BasedOn="{StaticResource MahApps.Styles.TabItem}">
                            <Setter Property="FontSize"
                                    Value="13"/>
                            <Setter Property="FontFamily"
                                    Value="Be Vietnam Pro, Segoe UI"/>
                            <Setter Property="Foreground"
                                    Value="#666"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected"
                                         Value="True">
                                    <Setter Property="Foreground"
                                            Value="#00275E"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </mah:MetroTabControl.Resources>
                    <!-- Tab: Đề bài -->
                    <mah:MetroTabItem Header="Đề bài">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Padding="30">
                            <StackPanel>
                                <!-- Problem Statement -->
                                <TextBlock Text="Mô tả"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                           Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding Problem.Statement}"
                                           FontSize="14"
                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                           TextWrapping="Wrap"
                                           LineHeight="22"
                                           Foreground="#333"
                                           Margin="0,0,0,24"/>

                                <!-- Constraints -->
                                <TextBlock Text="Ràng buộc"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                           Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,8">
                                    <Border Background="#E8F0FE"
                                            BorderBrush="#00275E"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,6"
                                            Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="ClockOutline"
                                                                        Width="14"
                                                                        Height="14"
                                                                        Foreground="#00275E"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,6,0"/>
                                            <TextBlock FontFamily="Be Vietnam Pro, Segoe UI"
                                                       FontSize="12"
                                                       Foreground="#00275E">
                                        <Run Text="Time: "/>
                                        <Run Text="{Binding Problem.TimeLimitMs, Mode=OneWay}"/>
                                        <Run Text="ms"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#E8F0FE"
                                            BorderBrush="#00275E"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,6">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Memory"
                                                                        Width="14"
                                                                        Height="14"
                                                                        Foreground="#00275E"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,6,0"/>
                                            <TextBlock FontFamily="Be Vietnam Pro, Segoe UI"
                                                       FontSize="12"
                                                       Foreground="#00275E">
                                        <Run Text="Memory: "/>
                                        <Run Text="{Binding Problem.MemoryLimitKb, Mode=OneWay}"/>
                                        <Run Text="KB"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Problem.Constraints}"
                                           FontSize="14"
                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                           TextWrapping="Wrap"
                                           Foreground="#333"
                                           Margin="0,0,0,24"/>

                                <!-- Input Format -->
                                <TextBlock Text="Định dạng Input"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                           Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding Problem.InputFormat, FallbackValue='Chưa có thông tin'}"
                                           FontSize="14"
                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                           TextWrapping="Wrap"
                                           Foreground="#333"
                                           Margin="0,0,0,24"/>

                                <!-- Output Format -->
                                <TextBlock Text="Định dạng Output"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                           Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding Problem.OutputFormat, FallbackValue='Chưa có thông tin'}"
                                           FontSize="14"
                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                           TextWrapping="Wrap"
                                           Foreground="#333"
                                           Margin="0,0,0,24"/>

                                <!-- Tags -->
                                <TextBlock Text="Tags"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                           Margin="0,0,0,12"/>
                                <ItemsControl ItemsSource="{Binding Problem.TagNames}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#E8F0FE"
                                                    BorderBrush="#00275E"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="10,5"
                                                    Margin="0,0,8,8">
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                                           FontSize="12"
                                                           Foreground="#00275E"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Height="24"/>

                                <!-- Sample Test Cases -->
                                <TextBlock Text="Test case mẫu"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                           Margin="0,0,0,12"/>
                                <ItemsControl ItemsSource="{Binding SampleTestCases}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F9F9F9"
                                                    BorderBrush="#E0E0E0"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="16"
                                                    Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Grid.Row="0"
                                                                Margin="0,0,0,10">
                                                        <TextBlock Text="Input:"
                                                                   FontFamily="Be Vietnam Pro, Segoe UI"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   Foreground="#666"
                                                                   Margin="0,0,0,6"/>
                                                        <TextBlock Text="{Binding InputRef}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="13"
                                                                   Background="#FFF"
                                                                   Padding="8"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1">
                                                        <TextBlock Text="Output:"
                                                                   FontFamily="Be Vietnam Pro, Segoe UI"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   Foreground="#666"
                                                                   Margin="0,0,0,6"/>
                                                        <TextBlock Text="{Binding OutputRef}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="13"
                                                                   Background="#FFF"
                                                                   Padding="8"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </mah:MetroTabItem>

                    <!-- Tab: Hướng dẫn -->
                    <mah:MetroTabItem Header="Hướng dẫn">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Padding="30">
                            <StackPanel>
                                <TextBlock Text="Hướng dẫn giải"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                           Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding Problem.Solution, FallbackValue='Nội dung hướng dẫn sẽ được cập nhật sau...'}"
                                           FontSize="14"
                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                           TextWrapping="Wrap"
                                           LineHeight="22"
                                           Foreground="#333"/>
                            </StackPanel>
                        </ScrollViewer>
                    </mah:MetroTabItem>

                    <!-- Tab: Lịch sử nộp bài -->
                    <mah:MetroTabItem Header="Lịch sử nộp bài">
                        <Grid Margin="20">
                            <DataGrid ItemsSource="{Binding Submissions}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      SelectionMode="Single"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      BorderBrush="#E0E0E0"
                                      BorderThickness="1"
                                      FontFamily="Be Vietnam Pro, Segoe UI"
                                      FontSize="13"
                                      RowHeight="48"
                                      Background="White">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background"
                                                Value="#F5F5F5"/>
                                        <Setter Property="Foreground"
                                                Value="#333"/>
                                        <Setter Property="FontWeight"
                                                Value="SemiBold"/>
                                        <Setter Property="FontSize"
                                                Value="13"/>
                                        <Setter Property="Padding"
                                                Value="12,10"/>
                                        <Setter Property="BorderBrush"
                                                Value="#E0E0E0"/>
                                        <Setter Property="BorderThickness"
                                                Value="0,0,0,1"/>
                                        <Setter Property="HorizontalContentAlignment"
                                                Value="Left"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background"
                                                Value="White"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter Property="Background"
                                                        Value="#F9F9F9"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness"
                                                Value="0"/>
                                        <Setter Property="Padding"
                                                Value="12,0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Padding="{TemplateBinding Padding}"
                                                            Background="{TemplateBinding Background}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.CellStyle>

                                <DataGrid.Columns>
                                    <!-- Thời gian -->
                                    <DataGridTextColumn Header="Thời gian"
                                                        Binding="{Binding SubmittedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}"
                                                        Width="150"/>

                                    <!-- Ngôn ngữ -->
                                    <DataGridTemplateColumn Header="Ngôn ngữ"
                                                            Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="Transparent"
                                                        BorderBrush="#00275E"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,3"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding LanguageCode}"
                                                               FontSize="11"
                                                               Foreground="#00275E"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Status -->
                                    <DataGridTemplateColumn Header="Status"
                                                            Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4"
                                                        Padding="8,4"
                                                        HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}"
                                                                             Value="Passed">
                                                                    <Setter Property="Background"
                                                                            Value="#E8F5E9"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}"
                                                                             Value="Failed">
                                                                    <Setter Property="Background"
                                                                            Value="#FFEBEE"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <iconPacks:PackIconMaterial Width="14"
                                                                                    Height="14"
                                                                                    VerticalAlignment="Center"
                                                                                    Margin="0,0,4,0">
                                                            <iconPacks:PackIconMaterial.Style>
                                                                <Style TargetType="iconPacks:PackIconMaterial">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}"
                                                                                     Value="Passed">
                                                                            <Setter Property="Kind"
                                                                                    Value="CheckCircle"/>
                                                                            <Setter Property="Foreground"
                                                                                    Value="#2E7D32"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}"
                                                                                     Value="Failed">
                                                                            <Setter Property="Kind"
                                                                                    Value="CloseCircle"/>
                                                                            <Setter Property="Foreground"
                                                                                    Value="#C62828"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </iconPacks:PackIconMaterial.Style>
                                                        </iconPacks:PackIconMaterial>
                                                        <TextBlock FontSize="12"
                                                                   FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}"
                                                                                     Value="Passed">
                                                                            <Setter Property="Text"
                                                                                    Value="Passed"/>
                                                                            <Setter Property="Foreground"
                                                                                    Value="#2E7D32"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}"
                                                                                     Value="Failed">
                                                                            <Setter Property="Text"
                                                                                    Value="Failed"/>
                                                                            <Setter Property="Foreground"
                                                                                    Value="#C62828"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Điểm -->
                                    <DataGridTemplateColumn Header="Điểm"
                                                            Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           TextDecorations="Underline"
                                                           Cursor="Hand">
                                                    <TextBlock.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.ViewTestCaseResultsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </TextBlock.InputBindings>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text"
                                                                    Value="{Binding Score}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}"
                                                                             Value="Passed">
                                                                    <Setter Property="Foreground"
                                                                            Value="#2E7D32"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}"
                                                                             Value="Failed">
                                                                    <Setter Property="Foreground"
                                                                            Value="#C62828"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                    <Setter Property="Opacity"
                                                                            Value="0.8"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Time -->
                                    <DataGridTemplateColumn Header="Time (ms)"
                                                            Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TotalTime}"
                                                           HorizontalAlignment="Right"
                                                           Foreground="#666"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Memory -->
                                    <DataGridTemplateColumn Header="Memory (KB)"
                                                            Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TotalMemory}"
                                                           HorizontalAlignment="Right"
                                                           Foreground="#666"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Chi tiết -->
                                    <DataGridTemplateColumn Header="Chi tiết"
                                                            Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ViewSubmissionDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MahApps.Styles.Button.Circle}"
                                                        Width="32"
                                                        Height="32"
                                                        Background="Transparent"
                                                        BorderBrush="#00275E"
                                                        ToolTip="Xem chi tiết">
                                                    <iconPacks:PackIconMaterial Kind="Eye"
                                                                                Width="16"
                                                                                Height="16"
                                                                                Foreground="#00275E"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty State -->
                            <TextBlock Text="Chưa có lần nộp bài nào"
                                       FontFamily="Be Vietnam Pro, Segoe UI"
                                       FontSize="14"
                                       Foreground="#999"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Submissions.Count, Converter={StaticResource InverseCountToVisibilityConverter}}"/>
                        </Grid>
                    </mah:MetroTabItem>
                </mah:MetroTabControl>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#00275E"
                          Width="5"/>

            <!-- Right Panel - Code Editor -->
            <Grid Grid.Column="2"
                  Background="#1E1E1E">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="250"
                                   MinHeight="100"/>
                </Grid.RowDefinitions>

                <!-- Editor Toolbar -->
                <Border Grid.Row="0"
                        Background="#2D2D2D"
                        BorderBrush="#3D3D3D"
                        BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Language Selector -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal">
                            <TextBlock Text="Ngôn ngữ:"
                                       VerticalAlignment="Center"
                                       Foreground="#D4D4D4"
                                       FontFamily="Be Vietnam Pro, Segoe UI"
                                       FontSize="13"
                                       Margin="0,0,10,0"/>
                            <ComboBox Width="200"
                                      SelectedItem="{Binding SelectedLanguage}"
                                      ItemsSource="{Binding AvailableLanguages}"
                                      DisplayMemberPath="LanguageDisplayName"
                                      Background="#3D3D3D"
                                      Foreground="White"
                                      BorderBrush="#FACB01"
                                      FontFamily="Be Vietnam Pro, Segoe UI"
                                      FontSize="13"/>
                        </StackPanel>

                        <!-- Reset Button -->
                        <Button Grid.Column="1"
                                Command="{Binding ResetCodeCommand}"
                                Style="{DynamicResource MahApps.Styles.Button.Flat}"
                                Foreground="#86868B"
                                Background="Transparent"
                                HorizontalAlignment="Left"
                                Margin="20,0,0,0"
                                Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Restore"
                                                            Width="14"
                                                            Height="14"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,6,0"/>
                                <TextBlock Text="Reset Code"
                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal">
                            <Button Command="{Binding RunCodeCommand}"
                                    Style="{DynamicResource MahApps.Styles.Button.Flat}"
                                    Background="Transparent"
                                    BorderBrush="#FACB01"
                                    BorderThickness="1.5"
                                    Foreground="#FACB01"
                                    Margin="0,0,10,0"
                                    Padding="14,7">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Play"
                                                                Width="15"
                                                                Height="15"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,6,0"/>
                                    <TextBlock Text="Chạy thử"
                                               FontFamily="Be Vietnam Pro, Segoe UI"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SubmitCodeCommand}"
                                    Style="{DynamicResource MahApps.Styles.Button.Flat}"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    Padding="14,7">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Send"
                                                                Width="15"
                                                                Height="15"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,6,0"/>
                                    <TextBlock Text="Nộp bài"
                                               FontFamily="Be Vietnam Pro, Segoe UI"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Code Editor -->
                <TextBox Grid.Row="1"
                         Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         FontFamily="Consolas"
                         FontSize="14"
                         Padding="16"
                         TextWrapping="NoWrap"
                         BorderThickness="0"
                         Background="#1E1E1E"
                         Foreground="#D4D4D4"
                         CaretBrush="#FACB01"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>

                <!-- Output Splitter -->
                <GridSplitter Grid.Row="2"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#00275E"
                              Cursor="SizeNS"
                              Height="5"/>

                <!-- Output Console -->
                <Border Grid.Row="3"
                        Background="White"
                        BorderBrush="#3D3D3D"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#F5F5F5"
                                BorderBrush="#E0E0E0"
                                BorderThickness="0,0,0,1"
                                Padding="16,10">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Console"
                                                            Width="16"
                                                            Height="16"
                                                            Foreground="#666"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0"/>
                                <TextBlock Text="Kết quả"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           FontFamily="Be Vietnam Pro, Segoe UI"
                                           Foreground="#333"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="16"
                                      Background="White">
                            <TextBlock Text="{Binding Output, FallbackValue='Nhấn Chạy thử hoặc Nộp bài để xem kết quả...'}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="#333"
                                       LineHeight="20"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

