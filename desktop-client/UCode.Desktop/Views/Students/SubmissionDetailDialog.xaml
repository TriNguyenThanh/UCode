<Window x:Class="UCode.Desktop.Views.Students.SubmissionDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Chi tiet bai nop"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F7"
        FontFamily="Be Vietnam Pro, Segoe UI">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="Chi tiet bai nop" FontSize="20" FontWeight="SemiBold"/>
            
            <!-- Status Chip -->
            <Border Grid.Column="1" Background="#4CAF50" CornerRadius="12" Padding="10,6" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusDisplay}" Foreground="White" FontWeight="SemiBold"/>
            </Border>
        </Grid>
        
        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Submission Info Panel -->
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Row 1 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="Submission ID" FontSize="11" Foreground="#999" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SubmissionId}" FontSize="13" FontFamily="Consolas"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="Thoi gian nop" FontSize="11" Foreground="#999" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SubmittedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}" FontSize="13"/>
                        </StackPanel>
                        
                        <!-- Row 2 -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="Ngon ngu" FontSize="11" Foreground="#999" Margin="0,0,0,4"/>
                            <Border Background="Transparent" BorderBrush="#2196F3" BorderThickness="1" CornerRadius="12" Padding="8,4" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding LanguageCode}" FontSize="11" Foreground="#2196F3" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="Diem" FontSize="11" Foreground="#999" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Score}" FontSize="13" FontWeight="SemiBold" Foreground="#4CAF50"/>
                        </StackPanel>
                        
                        <!-- Row 3 -->
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Thoi gian" FontSize="11" Foreground="#999" Margin="0,0,0,4"/>
                            <TextBlock FontSize="13">
                                <Run Text="{Binding TotalTime, Mode=OneWay}"/>
                                <Run Text=" ms"/>
                            </TextBlock>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="Bo nho" FontSize="11" Foreground="#999" Margin="0,0,0,4"/>
                            <TextBlock FontSize="13">
                                <Run Text="{Binding TotalMemory, Mode=OneWay}"/>
                                <Run Text=" KB"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Source Code -->
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Source Code" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        
                        <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="16">
                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding SourceCode}" 
                                           FontFamily="Consolas" 
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Footer -->
        <Button Grid.Row="2" 
                Content="Dong" 
                Width="100"
                Height="36"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"
                Background="#2196F3"
                Foreground="White"
                BorderThickness="0"
                Click="CloseButton_Click"
                Cursor="Hand"/>
    </Grid>
</Window>
