<mah:MetroWindow x:Class="UCode.Desktop.Views.LanguageDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        mc:Ignorable="d"
        Title="Cấu hình chi tiết ngôn ngữ" 
        Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowTitleBar="True"
        ShowCloseButton="True"
        ShowMinButton="False"
        ShowMaxRestoreButton="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#191970"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Saving Overlay -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}" 
              Panel.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#FACB01"/>
                <TextBlock Text="Đang lưu..." Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,15,0,0"/>
            </StackPanel>
        </Grid>

        <Border Background="White" CornerRadius="8" Margin="20" Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Cấu hình chi tiết ngôn ngữ" FontSize="24" FontWeight="Bold" Foreground="#191970"/>
                    <TextBlock Text="{Binding LanguageDisplayName}" FontSize="16" Foreground="#666" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Resource Limits -->
                        <TextBlock Text="Giới hạn tài nguyên" Style="{StaticResource SectionTitle}" Margin="0,0,0,15"/>
                        
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Time Factor -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Time Factor" Style="{StaticResource Label}"/>
                                <Grid>
                                    <TextBox Text="{Binding TimeFactor, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" 
                                             Height="40" FontSize="14" Padding="10,0"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock Text="x" Foreground="#666" FontSize="14" 
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" 
                                               Margin="0,0,10,0"/>
                                </Grid>
                                <Slider Value="{Binding TimeFactor}" 
                                        Minimum="0.1" Maximum="10" 
                                        TickFrequency="0.1" 
                                        IsSnapToTickEnabled="True"
                                        Margin="0,8,0,0"/>
                                <TextBlock Text="Hệ số nhân với time limit của bài toán (0.1x - 10x)" 
                                           FontSize="12" Foreground="#999" Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- Memory Limit -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Memory Limit" Style="{StaticResource Label}"/>
                                <Grid>
                                    <TextBox Text="{Binding MemoryKb, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" 
                                             Height="40" FontSize="14" Padding="10,0"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock Text="KB" Foreground="#666" FontSize="14" 
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" 
                                               Margin="0,0,10,0"/>
                                </Grid>
                                <StackPanel Margin="0,8,0,0">
                                    <Slider x:Name="MemorySlider" 
                                            Value="{Binding MemoryKb}" 
                                            Minimum="32768" Maximum="524288" 
                                            TickFrequency="32768" 
                                            IsSnapToTickEnabled="True"
                                            TickPlacement="BottomRight"/>
                                    <!-- Memory Labels (MB markers) - Căn đều theo các mốc chính -->
                                    <UniformGrid Columns="5" Margin="0,5,0,0">
                                        <TextBlock Text="32" FontSize="11" Foreground="#999" HorizontalAlignment="Left"/>
                                        <TextBlock Text="128" FontSize="11" Foreground="#999" HorizontalAlignment="Center"/>
                                        <TextBlock Text="256" FontSize="11" Foreground="#999" HorizontalAlignment="Center"/>
                                        <TextBlock Text="384" FontSize="11" Foreground="#999" HorizontalAlignment="Center"/>
                                        <TextBlock Text="512" FontSize="11" Foreground="#999" HorizontalAlignment="Right"/>
                                    </UniformGrid>
                                </StackPanel>
                                <TextBlock Text="Giới hạn bộ nhớ cho ngôn ngữ này (32MB - 512MB)" 
                                           FontSize="12" Foreground="#999" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#E0E0E0" Margin="0,10,0,20"/>

                        <!-- Code Template -->
                        <TextBlock Text="Code Template" Style="{StaticResource SectionTitle}" Margin="0,0,0,15"/>

                        <!-- Head -->
                        <TextBlock Text="Head (Code đầu chương trình)" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding Head, UpdateSourceTrigger=PropertyChanged}"
                                 Height="100" FontSize="13" Padding="10"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 Margin="0,0,0,15"/>

                        <!-- Body -->
                        <TextBlock Text="Body (Code chính - vị trí người dùng viết)" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                                 Height="150" FontSize="13" Padding="10"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 Margin="0,0,0,15"/>

                        <!-- Tail -->
                        <TextBlock Text="Tail (Code cuối chương trình)" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding Tail, UpdateSourceTrigger=PropertyChanged}"
                                 Height="100" FontSize="13" Padding="10"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 Margin="0,0,0,15"/>

                        <!-- Info -->
                        <Border Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="1" 
                                CornerRadius="4" Padding="15" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ" Foreground="#2196F3" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#1976D2" FontSize="13">
                                    Code template sẽ được sử dụng để tạo khung code mặc định cho người dùng. 
                                    Body là phần người dùng sẽ viết code.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Actions -->
                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="HỦY" 
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCommand}"
                            HorizontalAlignment="Left"
                            Width="120"/>

                    <Button Grid.Column="1" Content="💾 LƯU CẤU HÌNH" 
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding SaveCommand}"
                            Width="180"
                            IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</mah:MetroWindow>
