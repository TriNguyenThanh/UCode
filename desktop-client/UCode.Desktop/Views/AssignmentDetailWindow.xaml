<mah:MetroWindow x:Class="UCode.Desktop.Views.AssignmentDetailWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:local="clr-namespace:UCode.Desktop.Helpers"
                 Title="Chi tiết bài tập"
                 Height="800"
                 Width="1400"
                 WindowStartupLocation="CenterScreen"
                 TitleCharacterCasing="Normal"
                 ShowIconOnTitleBar="True"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}">
    
    <Window.Resources>
        <local:AssignmentStatusConverter x:Key="AssignmentStatusConverter"/>
        <local:AssignmentStatusToColorConverter x:Key="AssignmentStatusToColorConverter"/>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:AssignmentTypeConverter x:Key="AssignmentTypeConverter"/>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0"
                Background="#1976D2"
                Height="64"
                Panel.ZIndex="10">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Grid.Column="0"
                        Style="{DynamicResource MahApps.Styles.Button.Flat}"
                        Foreground="White"
                        Command="{Binding NavigateBackCommand}"
                        Cursor="Hand"
                        Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ArrowLeft"
                                                    Width="20"
                                                    Height="20"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>
                        <TextBlock Text="Quay lại"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Title -->
                <TextBlock Grid.Column="1"
                           Text="{Binding Assignment.Title}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Background="#F5F5F5">
            <StackPanel Margin="40,30">
                
                <!-- Assignment Header -->
                <Border Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="30"
                        Margin="0,0,0,30">
                    <Border.Effect>
                        <DropShadowEffect Color="#E0E0E0"
                                          BlurRadius="10"
                                          ShadowDepth="2"
                                          Opacity="0.5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{Binding Assignment.Title}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>
                        <TextBlock Text="{Binding Assignment.Description}"
                                   FontSize="14"
                                   Foreground="#666"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,15"/>
                        
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,15">
                            <Border Background="#E3F2FD"
                                    CornerRadius="12"
                                    Padding="8,4"
                                    Margin="0,0,10,0">
                                <TextBlock>
                                    <TextBlock.Text>
                                        <Binding Path="Assignment.AssignmentType">
                                            <Binding.Converter>
                                                <local:AssignmentTypeConverter/>
                                            </Binding.Converter>
                                        </Binding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>
                            <Border CornerRadius="12"
                                    Padding="8,4"
                                    Margin="0,0,10,0">
                                <Border.Background>
                                    <Binding Path="Assignment.Status">
                                        <Binding.Converter>
                                            <local:AssignmentStatusToColorConverter/>
                                        </Binding.Converter>
                                    </Binding>
                                </Border.Background>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <Binding Path="Assignment.Status">
                                            <Binding.Converter>
                                                <local:AssignmentStatusConverter/>
                                            </Binding.Converter>
                                        </Binding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>
                            <Border BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8,4">
                                <TextBlock FontSize="12"
                                           Foreground="#666">
                                    <Run Text="{Binding Assignment.TotalPoints}"/>
                                    <Run Text="điểm"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <!-- Progress Bar -->
                        <StackPanel Margin="0,15,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Tiến độ hoàn thành"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1"
                                           FontSize="14"
                                           FontWeight="SemiBold">
                                    <Run Text="{Binding CompletedProblemsCount}"/>
                                    <Run Text="/"/>
                                    <Run Text="{Binding Problems.Count}"/>
                                </TextBlock>
                            </Grid>
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ProgressPercentage}"
                                         Height="8"
                                         Margin="0,8,0,0"
                                         Foreground="#4CAF50"/>
                        </StackPanel>

                        <!-- Start Assignment Button (for students) -->
                        <Button Content="Bắt đầu bài tập"
                                Command="{Binding StartAssignmentCommand}"
                                Style="{DynamicResource MahApps.Styles.Button.Flat}"
                                Background="#4CAF50"
                                Foreground="White"
                                Height="40"
                                Margin="0,20,0,0"
                                HorizontalAlignment="Left"
                                Visibility="{Binding AssignmentUser.Status, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- Problems List -->
                <TextBlock Text="Danh sách câu hỏi"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="0,0,0,20"/>

                <ItemsControl ItemsSource="{Binding Problems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,0,0,15"
                                    Padding="20"
                                    Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect Color="#E0E0E0"
                                                      BlurRadius="10"
                                                      ShadowDepth="2"
                                                      Opacity="0.5"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Problem Number -->
                                    <Border Grid.Column="0"
                                            Background="#1976D2"
                                            Width="50"
                                            Height="50"
                                            CornerRadius="25"
                                            Margin="0,0,20,0">
                                        <TextBlock Text="{Binding OrderIndex}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Problem Info -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#FF9800"
                                                    CornerRadius="12"
                                                    Padding="8,4"
                                                    Margin="0,0,10,0">
                                                <TextBlock FontSize="12"
                                                           Foreground="White">
                                                    <Run Text="{Binding Points}"/>
                                                    <Run Text="điểm"/>
                                                </TextBlock>
                                            </Border>
                                            <Border Background="#4CAF50"
                                                    CornerRadius="12"
                                                    Padding="8,4">
                                                <TextBlock Text="Đã hoàn thành"
                                                           FontSize="12"
                                                           Foreground="White"
                                                           Visibility="Collapsed"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick"
                                                  Command="{Binding DataContext.NavigateToProblemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding ProblemId}"/>
                                </Border.InputBindings>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Background="#DD000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <mah:ProgressRing IsActive="True"
                                  Width="80"
                                  Height="80"
                                  Foreground="White"
                                  Margin="0,0,0,20"/>
                <TextBlock Text="Đang tải dữ liệu..."
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</mah:MetroWindow>

