<mah:MetroWindow x:Class="UCode.Desktop.Views.CreateClassDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Tạo lớp học mới" 
        Height="600" Width="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowMinButton="False"
        ShowMaxRestoreButton="False"
        Background="#F5F5F5"
        SizeToContent="Height">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="40,30" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Tạo lớp học mới" FontSize="28" FontWeight="Bold" Foreground="#191970" Margin="0,0,0,5"/>
                <TextBlock Text="Tạo lớp học để quản lý sinh viên và bài tập" FontSize="14" Foreground="#666"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="40,30">
            
            <!-- Class Name -->
            <TextBlock Text="Tên lớp học *" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,8"/>
            <TextBox x:Name="ClassNameTextBox" 
                     Text="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14" 
                     Padding="12"
                     Height="45"
                     Margin="0,0,0,20"
                     mah:TextBoxHelper.Watermark="Nhập tên lớp học"/>

            <!-- Class Code -->
            <TextBlock Text="Mã lớp *" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,8"/>
            <TextBox x:Name="ClassCodeTextBox"
                     Text="{Binding ClassCode, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14" 
                     Padding="12"
                     Height="45"
                     Margin="0,0,0,8"
                     mah:TextBoxHelper.Watermark="Nhập mã lớp"/>
            <TextBlock Text="Mã lớp học (viết tắt), dùng để định danh lớp" 
                       FontSize="12" 
                       Foreground="#999" 
                       Margin="0,0,0,20"/>

            <!-- Description -->
            <TextBlock Text="Mô tả" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,8"/>
            <TextBox x:Name="DescriptionTextBox"
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14" 
                     Padding="12"
                     Height="100"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,20"
                     mah:TextBoxHelper.Watermark="Nhập mô tả về lớp học (tùy chọn)"/>

            <!-- Info Box -->
            <Border Background="#E3F2FD" 
                    BorderBrush="#2196F3" 
                    BorderThickness="1" 
                    CornerRadius="6" 
                    Padding="15">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Top"/>
                    <TextBlock Text="Sau khi tạo lớp học, bạn có thể thêm sinh viên và tạo bài tập cho lớp." 
                               FontSize="13" 
                               Foreground="#1976D2" 
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="40,20" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="HỦY" 
                        Style="{StaticResource SecondaryButton}"
                        Width="120"
                        Margin="0,0,15,0"
                        Click="CancelButton_Click"/>
                <Button Content="🎓 TẠO LỚP HỌC" 
                        Style="{StaticResource YellowButton}"
                        Width="180"
                        Click="CreateButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="3" 
                Background="#DD000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="999" Margin="-10,20,10,-20">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="True" Width="60" Height="60" Foreground="#FACB01"/>
                <TextBlock Text="Đang tạo lớp học..." FontSize="16" Foreground="White" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
