<mah:MetroWindow x:Class="UCode.Desktop.Views.AdminMainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
                 Dialog:DialogParticipation.Register="{Binding}"
                 Title="UCode Admin Panel"
                 Height="750"
                 Width="1300"
                 MinHeight="600"
                 MinWidth="1000"
                 WindowStartupLocation="CenterScreen"
                 TitleCharacterCasing="Normal"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
                 BorderThickness="1"
                 TextOptions.TextFormattingMode="Ideal"
                 TextOptions.TextRenderingMode="Auto"
                RenderOptions.BitmapScalingMode="HighQuality"
                WindowState="Maximized"
                 >

    <mah:MetroWindow.LeftWindowCommands>
        <mah:WindowCommands>
            <Button Command="{Binding GoBackCommand}"
                    ToolTip="Go Back">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ArrowLeft" 
                                              Width="16" 
                                              Height="16"
                                              Margin="0,0,5,0"/>
                    <TextBlock Text="Back" 
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </mah:WindowCommands>
    </mah:MetroWindow.LeftWindowCommands>

    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>
            <Button Command="{Binding LogoutCommand}"
                    ToolTip="Logout">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Logout" 
                                              Width="16" 
                                              Height="16"
                                              Margin="0,0,5,0"/>
                    <TextBlock Text="Logout" 
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0"
                Background="{DynamicResource MahApps.Brushes.Gray10}"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray5}">
            <StackPanel>
                <!-- User Info Section -->
                <Border Background="{DynamicResource MahApps.Brushes.Accent}"
                        Padding="20">
                    <StackPanel>
                        <iconPacks:PackIconMaterial Kind="ShieldAccount"
                                                  Width="60"
                                                  Height="60"
                                                  HorizontalAlignment="Center"
                                                  Foreground="White"
                                                  Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding CurrentUser.FullName}"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="White"
                                  TextAlignment="Center"
                                  TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Administrator"
                                  FontSize="12"
                                  Foreground="White"
                                  Opacity="0.9"
                                  TextAlignment="Center"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Menu -->
                <StackPanel Margin="0,20,0,0">
                    <!-- Dashboard -->
                    <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                            Command="{Binding NavigateToHomeCommand}"
                            Padding="20,15"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ViewDashboard"
                                                      Width="20"
                                                      Height="20"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                            <TextBlock Text="Tổng quan"
                                      FontSize="14"
                                      VerticalAlignment="Center"
                                      Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- User Management -->
                    <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                            Command="{Binding NavigateToUsersCommand}"
                            Padding="20,15"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="AccountGroup"
                                                      Width="20"
                                                      Height="20"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                            <TextBlock Text="Người dùng"
                                      FontSize="14"
                                      VerticalAlignment="Center"
                                      Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Class Management -->
                    <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                            Command="{Binding NavigateToClassesCommand}"
                            Padding="20,15"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="GoogleClassroom"
                                                      Width="20"
                                                      Height="20"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                            <TextBlock Text="Lớp học"
                                      FontSize="14"
                                      VerticalAlignment="Center"
                                      Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- System Logs -->
                    <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                            Command="{Binding NavigateToLogsCommand}"
                            Padding="20,15"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FileDocument"
                                                      Width="20"
                                                      Height="20"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                            <TextBlock Text="Nhật ký hệ thống (đang phát triển)"
                                      FontSize="14"
                                      VerticalAlignment="Center"
                                      Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Settings -->
                    <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                            Command="{Binding NavigateToSettingsCommand}"
                            Padding="20,15"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Cog"
                                                      Width="20"
                                                      Height="20"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                            <TextBlock Text="Cài đặt (Sẽ phát triển)"
                                      FontSize="14"
                                      VerticalAlignment="Center"
                                      Margin="15,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer Section -->
                <StackPanel VerticalAlignment="Bottom"
                           Margin="20"
                           HorizontalAlignment="Center">
                    <TextBlock Text="UCode Admin Panel"
                              FontSize="11"
                              Foreground="{DynamicResource MahApps.Brushes.Gray}"
                              TextAlignment="Center"/>
                    <TextBlock Text="v1.0.0"
                              FontSize="10"
                              Foreground="{DynamicResource MahApps.Brushes.Gray}"
                              TextAlignment="Center"
                              Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <ContentControl x:Name="MainContentFrame"
                       Grid.Column="1"
                       Margin="0"/>
    </Grid>
</mah:MetroWindow>
