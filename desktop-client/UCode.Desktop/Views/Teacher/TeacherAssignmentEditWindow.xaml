<mah:MetroWindow x:Class="UCode.Desktop.Views.TeacherAssignmentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Chỉnh sửa bài tập - UCode" 
        Height="750" Width="1195"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        ResizeMode="NoResize"
        ShowMinButton="False"
        ShowMaxRestoreButton="False"
        WindowStyle="ToolWindow"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <mah:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DataGridStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <DropShadowEffect x:Key="DropShadowEffect" ShadowDepth="2" BlurRadius="8" Opacity="0.1" Color="#191970"/>
        </ResourceDictionary>
    </mah:MetroWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Loading Overlay      -->
        <Grid x:Name="LoadingOverlay" Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" 
              Panel.ZIndex="1000" Grid.RowSpan="2">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="True" Width="60" Height="60" Foreground="#FACB01"/>
                <TextBlock Text="Đang tải dữ liệu..." Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
       
        <!-- Main Content Area (Scrollable) -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <Grid Margin="30,30,30,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Thông tin bài tập" FontSize="24" FontWeight="Bold" Foreground="#191970" Margin="0,0,0,5"/>
                    <TextBlock Text="Điền đầy đủ thông tin bài tập và chọn các bài toán" FontSize="16" Foreground="#666"/>
                </StackPanel>

                <!-- Main Content -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Form Fields -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,14,-21">
                        <StackPanel>
                            <!-- Title -->
                            <TextBlock Text="Tiêu đề *" FontSize="16" FontWeight="SemiBold" Foreground="#191970" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" 
                                     mah:TextBoxHelper.Watermark="Nhập tiêu đề bài tập"
                                     mah:ControlsHelper.CornerRadius="8"
                                     Height="40" FontSize="16" Padding="10" Margin="0,0,0,20"/>

                            <!-- Description -->
                            <TextBlock Text="Mô tả" FontSize="16" FontWeight="SemiBold" Foreground="#191970" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                                     mah:TextBoxHelper.Watermark="Nhập mô tả bài tập"
                                     mah:ControlsHelper.CornerRadius="8"
                                     Height="100" FontSize="16" Padding="10" 
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,20"/>

                            <!-- Assignment Type -->
                            <TextBlock Text="Loại bài tập *" FontSize="16" FontWeight="SemiBold" Foreground="#191970" Margin="0,0,0,5"/>
                            <ComboBox SelectedValue="{Binding AssignmentType}" SelectedValuePath="Tag"
                                      mah:ControlsHelper.CornerRadius="8"
                                      Height="40" FontSize="16" Margin="0,0,0,20">
                                <ComboBoxItem Content="Bài tập về nhà" Tag="HOMEWORK"/>
                                <ComboBoxItem Content="Kiểm tra" Tag="EXAMINATION"/>
                                <ComboBoxItem Content="Bài tập" Tag="PRACTICE"/>
                            </ComboBox>

                            <!-- Status -->
                            <TextBlock Text="Trạng thái *" FontSize="16" FontWeight="SemiBold" Foreground="#191970" Margin="0,0,0,5"/>
                            <ComboBox SelectedValue="{Binding Status}" SelectedValuePath="Tag"
                                      mah:ControlsHelper.CornerRadius="8"
                                      Height="40" FontSize="16" Margin="0,0,0,20">
                                <ComboBoxItem Content="Nháp" Tag="DRAFT"/>
                                <ComboBoxItem Content="Đã xuất bản" Tag="PUBLISHED"/>
                                <ComboBoxItem Content="Đã đóng" Tag="CLOSED"/>
                            </ComboBox>

                            <!-- Start Time -->
                            <TextBlock Text="Thời gian bắt đầu" FontSize="16" FontWeight="SemiBold" Foreground="#191970" Margin="0,0,0,5"/>
                            <mah:DateTimePicker SelectedDateTime="{Binding StartTime}" 
                                                mah:ControlsHelper.CornerRadius="8"
                                                Height="40" FontSize="14" Margin="0,0,0,20"
                                                Culture="vi-VN"
                                                PickerVisibility="All"
                                                HandVisibility="HourMinute"
                                                mah:TextBoxHelper.UseFloatingWatermark="False"/>

                            <!-- End Time -->
                            <TextBlock Text="Thời gian kết thúc" FontSize="16" FontWeight="SemiBold" Foreground="#191970" Margin="0,0,0,5"/>
                            <mah:DateTimePicker SelectedDateTime="{Binding EndTime}" 
                                                mah:ControlsHelper.CornerRadius="8"
                                                Height="40" FontSize="14" Margin="0,0,0,20"
                                                Culture="vi-VN"
                                                PickerVisibility="All"
                                                HandVisibility="HourMinute"
                                                mah:TextBoxHelper.UseFloatingWatermark="False"/>

                            <!-- Allow Late Submission -->
                            <CheckBox IsChecked="{Binding AllowLateSubmission}" 
                                      Content="Cho phép nộp trễ" 
                                      FontSize="16" Foreground="#191970" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Right Column: Problems Selection -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="16,0,10,-21">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header with Add Button -->
                            <Grid Grid.Row="0" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Danh sách đề bài" FontSize="16" FontWeight="Bold" Foreground="#191970" VerticalAlignment="Center"/>

                                <Button Grid.Column="1" 
                                        Command="{Binding AddProblemCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="15,8"
                                        Cursor="Hand" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Plus" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="THÊM BÀI" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Selected Problems List with Scroll -->
                            <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
                                    <ItemsControl ItemsSource="{Binding SelectedProblems}"
                                                  Visibility="{Binding HasSelectedProblems, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                                  Margin="10"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                        <!-- Override ItemsPanel to use modern StackPanel -->
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Background="Transparent"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Clean modern card without shadow -->
                                                <Border Background="White" 
                                                        CornerRadius="8" 
                                                        Padding="12" 
                                                        Margin="0,0,0,10"
                                                        BorderBrush="#D1D5DB" 
                                                        BorderThickness="1"
                                                        UseLayoutRounding="True"
                                                        SnapsToDevicePixels="True">
                                                        <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Background="#191970" Width="30" Height="30" CornerRadius="15" Margin="0,0,15,0">
                                                            <TextBlock Text="{Binding OrderIndex}" 
                                                                       FontSize="14" FontWeight="Bold" Foreground="White" 
                                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#191970"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <TextBlock Text="{Binding Code}" FontSize="12" Foreground="#666" Margin="0,0,10,0"/>
                                                                <TextBlock Text="•" FontSize="12" Foreground="#666" Margin="0,0,5,0"/>
                                                                <TextBox Text="{Binding Points, UpdateSourceTrigger=PropertyChanged}" 
                                                                         mah:ControlsHelper.CornerRadius="4"
                                                                         Width="60" Height="26" FontSize="12" Padding="5,0"
                                                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                                                <TextBlock Text=" điểm" FontSize="12" Foreground="#666" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Orientation="Vertical" Margin="10,0">
                                                            <Button Width="28" Height="28" Padding="0" Margin="0,0,0,4"
                                                                    Command="{Binding DataContext.MoveProblemUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding ProblemId}"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    ToolTip="Di chuyển lên">
                                                                <iconPacks:PackIconMaterial Kind="ChevronUp" Width="14" Height="14"/>
                                                            </Button>
                                                            <Button Width="28" Height="28" Padding="0"
                                                                    Command="{Binding DataContext.MoveProblemDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding ProblemId}"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    ToolTip="Di chuyển xuống">
                                                                <iconPacks:PackIconMaterial Kind="ChevronDown" Width="14" Height="14"/>
                                                            </Button>
                                                        </StackPanel>

                                                        <Button Grid.Column="3" Width="32" Height="32" 
                                                                Command="{Binding DataContext.RemoveProblemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding ProblemId}"
                                                                Style="{StaticResource DangerButtonStyle}"
                                                                Padding="0"
                                                                ToolTip="Xóa khỏi bài tập">
                                                            <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Fixed Footer with Actions -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderThickness="0,1,0,0" 
                BorderBrush="#E0E0E0"
                Padding="30,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Command="{Binding CancelCommand}" 
                        Width="120" 
                        Height="40"
                        Margin="0,0,15,0"/>
                <Button Content="Lưu" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Command="{Binding SaveCommand}" 
                        IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}"
                        Width="120"
                        Height="40"/>
            </StackPanel>
        </Border>

        <!-- Saving Overlay 
        <Grid Grid.RowSpan="2" Background="#80000000" 
              Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}" 
              Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="True" Width="60" Height="60" Foreground="#FACB01"/>
                <TextBlock Text="Đang lưu..." Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid> -->
    </Grid>
</mah:MetroWindow>

