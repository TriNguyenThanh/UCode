<mah:MetroWindow x:Class="UCode.Desktop.Views.AttendanceQRDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="QR Code Điểm Danh" 
        Height="700" Width="731"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderThickness="1"
        BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
        Background="White"
        ResizeMode="NoResize"
        ShowMinButton="False"
        ShowCloseButton="True"
        TitleCharacterCasing="Normal"
        NonActiveGlowBrush="#CCCCCC">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#191970" Padding="25,20">
            <StackPanel>
                <TextBlock Text="📱 QR Code Điểm Danh" 
                           Foreground="#FACB01" 
                           FontSize="24" 
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding SessionTitle}" 
                           Foreground="White" 
                           FontSize="14" 
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!--ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30" -->
        <StackPanel>
            <!-- QR Code -->
            <Border Background="White" 
                        BorderBrush="#d2d2d7" 
                        BorderThickness="2" 
                        CornerRadius="20" 
                        Padding="10"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,20" Height="416" Width="446">
                <Image Source="{Binding QRCodeImage}" Stretch="Uniform"/>
            </Border>

            <!-- URL Section -->
            <Border Background="#F5F5F7" 
                        BorderBrush="#d2d2d7" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="15"
                        Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                                   Text="🔗 Link điểm danh:" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Foreground="#191970"
                                   Margin="0,0,0,10"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                     Text="{Binding AttendanceUrl, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontSize="13"
                                     Padding="10"
                                     VerticalAlignment="Center"
                                     Background="White"
                                     BorderBrush="#d2d2d7"
                                     BorderThickness="1"
                                     TextWrapping="Wrap"/>

                        <Button Grid.Column="1"
                                    Command="{Binding CopyUrlCommand}"
                                    Background="#0071E3"
                                    BorderThickness="0"
                                    Padding="12,8"
                                    Margin="10,0,0,0"
                                    Cursor="Hand"
                                    ToolTip="Sao chép link">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <iconPacks:PackIconMaterial Kind="ContentCopy" 
                                                                                        Width="16" 
                                                                                        Height="16" 
                                                                                        Foreground="White"
                                                                                        Margin="0,0,6,0"/>
                                                        <TextBlock Text="Sao chép" 
                                                                       Foreground="White" 
                                                                       FontWeight="SemiBold"
                                                                       FontSize="13"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#005BB5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
        <!--/ScrollViewer-->

        <!-- Footer -->
        <Border Grid.Row="1" 
                Background="#F5F5F7" 
                BorderBrush="#d2d2d7"
                BorderThickness="0,1,0,0" 
                Padding="30,15">
            <Button Content="Đóng" 
                    Style="{StaticResource SecondaryButton}"
                    Click="Close_Click"
                    HorizontalAlignment="Center"
                    Margin="0,0,10,0"
                    Padding="20, 0"
                    FontSize="15"/>
        </Border>
    </Grid>
</mah:MetroWindow>
