<mah:MetroWindow x:Class="UCode.Desktop.Views.AttendanceQRDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="QR Code Điểm Danh" 
        Height="750" Width="731"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderThickness="1"
        BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
        Background="#F8FAFC"
        ResizeMode="NoResize"
        ShowMinButton="False"
        ShowCloseButton="True"
        TitleCharacterCasing="Normal"
        NonActiveGlowBrush="#CCCCCC"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="30,20,30,0" Padding="20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="Qrcode" Width="24" Height="24" Foreground="#191970" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="QR Code Điểm Danh" 
                               Foreground="#191970" 
                               FontSize="24" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding SessionTitle}" 
                           Foreground="#666" 
                           FontSize="14" 
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!--ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30" -->
        <StackPanel Grid.Row="1" Margin="30,20,30,0">
            <!-- QR Code -->
            <Border Style="{StaticResource CardStyle}" 
                    Padding="10"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20" Height="400" Width="446">
                <Image Source="{Binding QRCodeImage}" Stretch="Uniform"/>
            </Border>

            <!-- URL Section -->
            <Border Style="{StaticResource CardStyle}" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <iconPacks:PackIconMaterial Kind="Link" Width="16" Height="16" Foreground="#191970" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Link điểm danh:" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Foreground="#191970"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding AttendanceUrl, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontSize="13"
                                 Padding="10"
                                 VerticalAlignment="Center"
                                 mah:ControlsHelper.CornerRadius="8"
                                 TextWrapping="Wrap"/>

                        <Button Grid.Column="1"
                                Command="{Binding CopyUrlCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="10,0,0,0"
                                ToolTip="Sao chép link">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ContentCopy" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Sao chép" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
        <!--/ScrollViewer-->

        <!-- Footer -->
        <Border Grid.Row="2" 
                Background="White" 
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0" 
                Padding="30,15">
            <Button Style="{StaticResource SecondaryButtonStyle}"
                    Click="Close_Click"
                    HorizontalAlignment="Center"
                    Margin="0,0,10,0"
                    Width="120">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Đóng" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Border>
    </Grid>
</mah:MetroWindow>
