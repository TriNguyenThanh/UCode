<mah:MetroWindow x:Class="UCode.Desktop.Views.AttendanceConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Cấu hình điểm danh" 
        Height="750" Width="900"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderThickness="1"
        BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
        Background="White"
        ResizeMode="NoResize"
        ShowMinButton="False"
        ShowMaxRestoreButton="False"
        ShowCloseButton="True"
        TitleCharacterCasing="Normal"
        NonActiveGlowBrush="#CCCCCC">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Saving Overlay -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}" 
              Panel.ZIndex="1000"
              Grid.RowSpan="3">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="True" Width="60" Height="60" Foreground="#FACB01"/>
                <TextBlock Text="Đang lưu..." Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Header -->
        <Border Grid.Row="0" Background="#191970" Padding="30,20">
            <StackPanel>
                <TextBlock Text="⚙ Cấu hình điểm danh" 
                           Foreground="#FACB01" 
                           FontSize="24" 
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding SessionTitle}" 
                           Foreground="White" 
                           FontSize="14" 
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30">
            <StackPanel>
                <!-- Time Settings -->
                <Border Background="#FFF9E6" BorderBrush="#FACB01" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="⏰ Thời gian" FontSize="18" FontWeight="Bold" Foreground="#191970" Margin="0,0,0,15"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Start Time -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Thời gian bắt đầu *" FontSize="14" FontWeight="SemiBold" Foreground="#1d1d1f" Margin="0,0,0,8"/>
                                <DatePicker SelectedDate="{Binding StartDate}" 
                                            Height="40" 
                                            FontSize="14" 
                                            Margin="0,0,0,10"
                                            mah:ControlsHelper.CornerRadius="15"/>
                                <mah:TimePicker SelectedDateTime="{Binding StartTime}" 
                                                Height="40" 
                                                FontSize="14"
                                                mah:TextBoxHelper.UseFloatingWatermark="False"
                                                mah:ControlsHelper.CornerRadius="15"
                                                HandVisibility="HourMinute"
                                                PickerVisibility="HourMinute"
                                                Culture="vi-VN"/>
                            </StackPanel>

                            <!-- End Time -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Thời gian kết thúc *" FontSize="14" FontWeight="SemiBold" Foreground="#1d1d1f" Margin="0,0,0,8"/>
                                <DatePicker SelectedDate="{Binding EndDate}" 
                                            Height="40" 
                                            FontSize="14" 
                                            Margin="0,0,0,10"
                                            mah:ControlsHelper.CornerRadius="15"/>
                                <mah:TimePicker SelectedDateTime="{Binding EndTime}" 
                                                Height="40" 
                                                FontSize="14"
                                                mah:TextBoxHelper.UseFloatingWatermark="False"
                                                mah:ControlsHelper.CornerRadius="15"
                                                HandVisibility="HourMinute"
                                                PickerVisibility="HourMinute"
                                                Culture="vi-VN"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- IP Check Settings -->
                <Border Background="#E8F4FD" BorderBrush="#2196F3" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding RequireIpCheck}" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#191970"
                                  Margin="0,0,0,15">
                            <TextBlock Text="🌐 Kiểm tra IP Address"/>
                        </CheckBox>

                        <StackPanel Visibility="{Binding RequireIpCheck, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text=" Địa chỉ IP cho phép" FontSize="14" FontWeight="SemiBold" Foreground="#1d1d1f" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding AllowedIpSubnet, UpdateSourceTrigger=PropertyChanged}"
                                     Height="40" 
                                     FontSize="14" 
                                     Padding="10"
                                     mah:TextBoxHelper.Watermark="VD: 192.168.1.0"
                                     mah:ControlsHelper.CornerRadius="15"/>
                            <TextBlock Text="Định dạng: xxx.xxx.xxx.xxx" 
                                       FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- GPS Check Settings -->
                <Border Background="#E8F5E9" BorderBrush="#34C759" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding RequireGpsCheck}" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#191970"
                                  Margin="0,0,0,15">
                            <TextBlock Text="📍 Kiểm tra vị trí GPS"/>
                        </CheckBox>

                        <StackPanel Visibility="{Binding RequireGpsCheck, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Latitude -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Latitude (Vĩ độ)" FontSize="14" FontWeight="SemiBold" Foreground="#1d1d1f" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding AllowedLatitude, UpdateSourceTrigger=PropertyChanged}"
                                             Height="40" 
                                             FontSize="14" 
                                             Padding="10"
                                             mah:TextBoxHelper.Watermark="VD: 10.762622"
                                             mah:ControlsHelper.CornerRadius="15"/>
                                </StackPanel>

                                <!-- Longitude -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Longitude (Kinh độ)" FontSize="14" FontWeight="SemiBold" Foreground="#1d1d1f" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding AllowedLongitude, UpdateSourceTrigger=PropertyChanged}"
                                             Height="40" 
                                             FontSize="14" 
                                             Padding="10"
                                             mah:TextBoxHelper.Watermark="VD: 106.660172"
                                             mah:ControlsHelper.CornerRadius="15"/>
                                </StackPanel>

                                <!-- Radius -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Bán kính (m)" FontSize="14" FontWeight="SemiBold" Foreground="#1d1d1f" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding AllowedRadiusMeters, UpdateSourceTrigger=PropertyChanged}"
                                             Height="40" 
                                             FontSize="14" 
                                             Padding="10"
                                             mah:TextBoxHelper.Watermark="VD: 100"
                                             mah:ControlsHelper.CornerRadius="15"/>
                                </StackPanel>
                            </Grid>

                            <!-- Map Button -->
                            <Button Content="🗺 Chọn vị trí trên bản đồ" 
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenMapCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,15,0,0"
                                    Padding="15,10"/>

                            <Border Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,15,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ℹ️" Foreground="#2196F3" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="#1976D2" FontSize="13">
                                        Sinh viên chỉ có thể điểm danh khi ở trong bán kính cho phép từ vị trí đã chọn
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" 
                Background="#F5F5F7" 
                BorderBrush="#d2d2d7"
                BorderThickness="0,1,0,0" 
                Padding="30,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" 
                        Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click"
                        Margin="0,0,15,0"
                        Padding="30,0"
                        FontSize="15"/>
                <Button Content="Lưu cấu hình" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}"
                        Padding="30,12"
                        FontSize="15"/>
            </StackPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
