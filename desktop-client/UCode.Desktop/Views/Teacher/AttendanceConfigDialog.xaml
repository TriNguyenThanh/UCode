<mah:MetroWindow x:Class="UCode.Desktop.Views.AttendanceConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Cấu hình điểm danh" 
        Height="750" Width="900"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderThickness="1"
        BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
        Background="#F8FAFC"
        ResizeMode="NoResize"
        ShowMinButton="False"
        ShowMaxRestoreButton="False"
        ShowCloseButton="True"
        TitleCharacterCasing="Normal"
        NonActiveGlowBrush="#CCCCCC"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Saving Overlay -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}" 
              Panel.ZIndex="1000"
              Grid.RowSpan="3">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="True" Width="60" Height="60" Foreground="#FACB01"/>
                <TextBlock Text="Đang lưu..." Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="30,20,30,0" Padding="20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="Cog" Width="24" Height="24" Foreground="#191970" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Cấu hình điểm danh" 
                               Foreground="#191970" 
                               FontSize="24" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Editable Title -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <iconPacks:PackIconMaterial Kind="Pencil" Width="14" Height="14" Foreground="#666" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SessionTitle, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14"
                             Foreground="#666"
                             BorderThickness="0,0,0,1"
                             BorderBrush="#E0E0E0"
                             Background="Transparent"
                             Padding="4,2"
                             MinWidth="200"
                             HorizontalContentAlignment="Center"
                             VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30">
            <StackPanel>
                <!-- Time Settings -->
                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <iconPacks:PackIconMaterial Kind="ClockOutline" Width="20" Height="20" Foreground="#191970" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Thời gian" FontSize="18" FontWeight="Bold" Foreground="#191970" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Active Status -->
                        <CheckBox IsChecked="{Binding IsActive}" Margin="0,0,0,15">
                            <TextBlock Text="Kích hoạt phiên điểm danh" FontSize="14" FontWeight="SemiBold"/>
                        </CheckBox>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Start Time -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Thời gian bắt đầu *" FontSize="14" FontWeight="SemiBold" Foreground="#191970" Margin="0,0,0,8"/>
                                <DatePicker SelectedDate="{Binding StartDate}" 
                                            Height="40" 
                                            FontSize="14" 
                                            Margin="0,0,0,10"
                                            mah:ControlsHelper.CornerRadius="8"/>
                                <mah:TimePicker SelectedDateTime="{Binding StartTime}" 
                                                Height="40" 
                                                FontSize="14"
                                                mah:TextBoxHelper.UseFloatingWatermark="False"
                                                mah:ControlsHelper.CornerRadius="8"
                                                HandVisibility="HourMinute"
                                                PickerVisibility="HourMinute"
                                                Culture="vi-VN"/>
                            </StackPanel>

                            <!-- End Time -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Thời gian kết thúc *" FontSize="14" FontWeight="SemiBold" Foreground="#191970" Margin="0,0,0,8"/>
                                <DatePicker SelectedDate="{Binding EndDate}" 
                                            Height="40" 
                                            FontSize="14" 
                                            Margin="0,0,0,10"
                                            mah:ControlsHelper.CornerRadius="8"/>
                                <mah:TimePicker SelectedDateTime="{Binding EndTime}" 
                                                Height="40" 
                                                FontSize="14"
                                                mah:TextBoxHelper.UseFloatingWatermark="False"
                                                mah:ControlsHelper.CornerRadius="8"
                                                HandVisibility="HourMinute"
                                                PickerVisibility="HourMinute"
                                                Culture="vi-VN"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- IP Check Settings -->
                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding RequireIpCheck}" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#191970"
                                  Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Web" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Kiểm tra IP Address" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>

                        <StackPanel Visibility="{Binding RequireIpCheck, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="⚡ Địa chỉ IP cho phép" FontSize="14" FontWeight="SemiBold" Foreground="#191970" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBox Grid.Column="0"
                                         Text="{Binding AllowedIpSubnet, UpdateSourceTrigger=PropertyChanged}"
                                         Height="40" 
                                         FontSize="14" 
                                         Padding="10"
                                         mah:TextBoxHelper.Watermark="VD: 192.168.1.0"
                                         mah:ControlsHelper.CornerRadius="8"/>
                                
                                <Button Grid.Column="2"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding RefreshIpCommand}"
                                        Height="40"
                                        Width="40"
                                        Padding="0"
                                        ToolTip="Lấy IP mới">
                                    <iconPacks:PackIconMaterial Kind="Refresh" Width="18" Height="18"/>
                                </Button>
                            </Grid>
                            <TextBlock Text="Định dạng: xxx.xxx.xxx.xxx" 
                                       FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- GPS Check Settings -->
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding RequireGpsCheck}" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#191970"
                                  Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="MapMarker" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Kiểm tra vị trí GPS" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>

                        <StackPanel Visibility="{Binding RequireGpsCheck, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- GPS Coordinates (combined) -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Tọa độ GPS (Vĩ độ, Kinh độ)" FontSize="14" FontWeight="SemiBold" Foreground="#191970" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding GpsCoordinates, UpdateSourceTrigger=PropertyChanged}"
                                             Height="40" 
                                             FontSize="14" 
                                             Padding="10"
                                             mah:TextBoxHelper.Watermark="VD: 11.169625, 108.931672"
                                             mah:ControlsHelper.CornerRadius="8"/>
                                </StackPanel>

                                <!-- Radius -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Bán kính (m)" FontSize="14" FontWeight="SemiBold" Foreground="#191970" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding AllowedRadiusMeters, UpdateSourceTrigger=PropertyChanged}"
                                             Height="40" 
                                             FontSize="14" 
                                             Padding="10"
                                             mah:TextBoxHelper.Watermark="VD: 100"
                                             mah:ControlsHelper.CornerRadius="8"/>
                                </StackPanel>
                            </Grid>

                            <!-- Map Button -->
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenMapCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,15,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="MapMarker" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Mở Google Maps để lấy tọa độ" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Info Box -->
                            <Border Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,15,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="InformationOutline" Foreground="#2196F3" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="#1976D2" FontSize="13">
                                        <Run Text="Cách lấy tọa độ từ Google Maps:" FontWeight="SemiBold"/>
                                        <LineBreak/>
                                        <Run Text="1. Click nút 'Mở Google Maps' ở trên"/>
                                        <LineBreak/>
                                        <Run Text="2. Click chuột phải vào vị trí bạn muốn trên bản đồ"/>
                                        <LineBreak/>
                                        <Run Text="3. Click vào tọa độ đầu tiên (dạng: 10.762622, 106.660172)"/>
                                        <LineBreak/>
                                        <Run Text="4. Tọa độ sẽ được copy, paste vào ô Vĩ độ và Kinh độ"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Face Check Settings -->
                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,20,0,0">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding RequireFaceCheck}" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#191970"
                                  Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FaceRecognition" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Yêu cầu xác thực khuôn mặt" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>

                        <Border Background="#FFF3E0" BorderBrush="#FF9800" BorderThickness="1" CornerRadius="8" Padding="12"
                                Visibility="{Binding RequireFaceCheck, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Information" Foreground="#F57C00" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#E65100" FontSize="13">
                                    Sinh viên sẽ phải xác thực khuôn mặt khi điểm danh. Đảm bảo sinh viên đã đăng ký khuôn mặt trong hệ thống.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" 
                Background="White" 
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0" 
                Padding="30,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Click="Cancel_Click"
                        Margin="0,0,15,0"
                        Width="120">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Hủy" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}"
                        Width="150">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ContentSave" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Lưu cấu hình" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
