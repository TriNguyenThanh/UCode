<mah:MetroWindow x:Class="UCode.Desktop.Views.EditClassDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Chỉnh sửa lớp học" 
        Height="650" Width="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowMinButton="False"
        ShowMaxRestoreButton="False"
        Background="#F8FAFC"
        SizeToContent="Height"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="40,30,40,0">
            <StackPanel>
                <TextBlock Text="Chỉnh sửa lớp học" FontSize="28" FontWeight="Bold" Foreground="#191970" Margin="0,0,0,5"/>
                <TextBlock Text="Cập nhật thông tin lớp học" FontSize="14" Foreground="#666"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30">
            
                <!-- Class Name -->
                <TextBlock Text="Tên lớp học" FontSize="14" FontWeight="SemiBold" Foreground="#191970" Margin="0,0,0,8"/>
                <TextBox x:Name="ClassNameTextBox" 
                         Text="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" 
                         Padding="12"
                         Height="45"
                         Margin="0,0,0,20"
                         mah:ControlsHelper.CornerRadius="8"
                         mah:TextBoxHelper.Watermark="Nhập tên lớp học"/>

                <!-- Class Code -->
                <TextBlock Text="Mã lớp học" FontSize="14" FontWeight="SemiBold" Foreground="#191970" Margin="0,0,0,8"/>
                <TextBox x:Name="ClassCodeTextBox" 
                         Text="{Binding ClassCode, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" 
                         Padding="12"
                         Height="45"
                         Margin="0,0,0,20"
                         mah:ControlsHelper.CornerRadius="8"
                         mah:TextBoxHelper.Watermark="Nhập mã lớp học"/>

                <!-- Description -->
                <TextBlock Text="Mô tả" FontSize="14" FontWeight="SemiBold" Foreground="#191970" Margin="0,0,0,8"/>
                <TextBox x:Name="DescriptionTextBox"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" 
                         Padding="12"
                         Height="100"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,20"
                         mah:ControlsHelper.CornerRadius="8"
                         mah:TextBoxHelper.Watermark="Nhập mô tả về lớp học (tùy chọn)"/>

                <!-- Subject -->
                

                
                

                <!-- Info Box -->
                <Border Background="#FFF3E0" 
                        BorderBrush="#FF9800" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="15">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Information" Foreground="#FF9800" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Top"/>
                        <TextBlock Text="Chỉ giáo viên tạo lớp mới có quyền cập nhật thông tin lớp học." 
                                   FontSize="13" 
                                   Foreground="#E65100" 
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="40,20" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Width="120"
                        Margin="0,0,15,0"
                        Click="CancelButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="HỦY" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Width="180"
                        Click="SaveButton_Click"
                        IsEnabled="{Binding CanSave}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ContentSave" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="LƯU THAY ĐỔI" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="3" 
                Background="#DD000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="True" Width="60" Height="60" Foreground="#FACB01"/>
                <TextBlock Text="Đang lưu thay đổi..." FontSize="16" Foreground="White" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
