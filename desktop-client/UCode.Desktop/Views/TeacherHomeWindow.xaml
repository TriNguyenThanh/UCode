<mah:MetroWindow x:Class="UCode.Desktop.Views.TeacherHomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="UCode - Trang Giảng viên" 
        Height="900" Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        WindowState="Maximized"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0" Background="#003d8f" Height="60">
            <Grid Margin="40,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back Button & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" 
                            Style="{StaticResource BackButton}"
                            Click="BackButton_Click"
                            Visibility="Collapsed"
                            ToolTip="Quay lại">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M15,12 L7,12 M10,15 L7,12 L10,9" Stroke="White" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="QUAY LẠI" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="📚" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="UCode" FontSize="24" FontWeight="Bold" Foreground="#FACB01" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="DashboardTab" Content="DASHBOARD" 
                            Style="{StaticResource TabButtonActive}"
                            Click="DashboardTab_Click"/>
                    <Button x:Name="ProblemsTab" Content="NGÂN HÀNG BÀI" 
                            Style="{StaticResource TabButton}"
                            Margin="20,0,0,0"
                            Click="ProblemsTab_Click"/>
                </StackPanel>

                <!-- User Info with Dropdown -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Button x:Name="UserMenuButton" 
                            Style="{StaticResource UserMenuButton}"
                            Click="UserMenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="UserNameText" Text="Teacher" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                            <Path Data="M7,10 L12,15 L17,10" Stroke="White" StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" Margin="8,2,0,0"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Dropdown Menu -->
                    <Popup x:Name="UserMenuPopup" 
                           PlacementTarget="{Binding ElementName=UserMenuButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="White" 
                                BorderBrush="#E0E0E0" 
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="0"
                                Margin="0,5,0,0"
                                MinWidth="200">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.2"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Email Header -->
                                <Border Background="#F5F5F5" Padding="15,10" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <TextBlock x:Name="UserEmailText" Text="teacher01@ucode.io.vn" 
                                               FontSize="15" Foreground="#666" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                
                                <!-- Menu Items -->
                                <Button x:Name="ProfileButton" 
                                        Style="{StaticResource DropdownMenuItem}"
                                        Click="ProfileButton_Click">
                                    <TextBlock Text="Hồ sơ" FontSize="16" Foreground="#333"/>
                                </Button>
                                
                                <Button x:Name="SettingsButton" 
                                        Style="{StaticResource DropdownMenuItem}"
                                        Click="SettingsButton_Click">
                                    <TextBlock Text="Cài đặt" FontSize="16" Foreground="#333"/>
                                </Button>
                                
                                <Separator Margin="0" Background="#E0E0E0"/>
                                
                                <Button x:Name="LogoutButton" 
                                        Style="{StaticResource DropdownMenuItem}"
                                        Click="LogoutButton_Click">
                                    <TextBlock Text="Đăng xuất" FontSize="16" Foreground="#dc3545" FontWeight="SemiBold"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Content Area - Navigation Frame -->
        <!-- This will show either home content or navigated pages -->
        <ContentControl x:Name="NavigationFrame" Grid.Row="1"/>
    </Grid>
</mah:MetroWindow>