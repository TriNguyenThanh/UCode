<UserControl x:Class="UCode.Desktop.Views.Admin.AddUserDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="500">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Thêm người dùng mới" FontSize="24" FontWeight="Bold" Foreground="#191970"/>
            <TextBlock Text="Điền thông tin để tạo tài khoản mới" FontSize="13" Foreground="#666" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Full Name -->
                <TextBlock Text="Họ và tên *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#333"/>
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         FontSize="14" Padding="12,10" Margin="0,0,0,5"
                         mah:TextBoxHelper.Watermark="Nhập họ và tên"
                         mah:TextBoxHelper.ClearTextButton="True"/>
                <TextBlock Text="{Binding FullNameError}" 
                           Foreground="#DC143C" FontSize="11" Margin="2,0,0,15"
                           Visibility="{Binding FullNameError, Converter={StaticResource NullToVisibilityConverter}}"/>

                <!-- Email -->
                <TextBlock Text="Email *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#333"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                         FontSize="14" Padding="12,10" Margin="0,0,0,5"
                         mah:TextBoxHelper.Watermark="example@email.com"
                         mah:TextBoxHelper.ClearTextButton="True"/>
                <TextBlock Text="{Binding EmailError}" 
                           Foreground="#DC143C" FontSize="11" Margin="2,0,0,15"
                           Visibility="{Binding EmailError, Converter={StaticResource NullToVisibilityConverter}}"/>

                <!-- Password -->
                <TextBlock Text="Mật khẩu *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#333"/>
                <PasswordBox x:Name="PasswordBox" 
                             PasswordChanged="PasswordBox_OnPasswordChanged"
                             FontSize="14" Padding="12,10" Margin="0,0,0,5"
                             mah:TextBoxHelper.Watermark="Tối thiểu 6 ký tự"/>
                <TextBlock Text="{Binding PasswordError}" 
                           Foreground="#DC143C" FontSize="11" Margin="2,0,0,15"
                           Visibility="{Binding PasswordError, Converter={StaticResource NullToVisibilityConverter}}"/>

                <!-- Confirm Password -->
                <TextBlock Text="Xác nhận mật khẩu *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#333"/>
                <PasswordBox x:Name="ConfirmPasswordBox" 
                             PasswordChanged="ConfirmPasswordBox_OnPasswordChanged"
                             FontSize="14" Padding="12,10" Margin="0,0,0,5"
                             mah:TextBoxHelper.Watermark="Nhập lại mật khẩu"/>
                <TextBlock Text="{Binding ConfirmPasswordError}" 
                           Foreground="#DC143C" FontSize="11" Margin="2,0,0,15"
                           Visibility="{Binding ConfirmPasswordError, Converter={StaticResource NullToVisibilityConverter}}"/>

                <!-- Role -->
                <TextBlock Text="Vai trò *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#333"/>
                <ComboBox ItemsSource="{Binding AvailableRoles}" 
                          SelectedItem="{Binding SelectedRole}"
                          FontSize="14" Padding="12,10" Margin="0,0,0,5">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="{Binding Icon}" Width="16" Height="16" 
                                                           Foreground="{Binding Color}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding RoleError}" 
                           Foreground="#DC143C" FontSize="11" Margin="2,0,0,15"
                           Visibility="{Binding RoleError, Converter={StaticResource NullToVisibilityConverter}}"/>

                <!-- Student Code (visible only for Student role) -->
                <StackPanel Visibility="{Binding IsStudentRole, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Mã sinh viên *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#333"/>
                    <TextBox Text="{Binding StudentCode, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Padding="12,10" Margin="0,0,0,5"
                             mah:TextBoxHelper.Watermark="VD: B21DCCN001"
                             mah:TextBoxHelper.ClearTextButton="True"/>
                    <TextBlock Text="{Binding StudentCodeError}" 
                               Foreground="#DC143C" FontSize="11" Margin="2,0,0,15"
                               Visibility="{Binding StudentCodeError, Converter={StaticResource NullToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Teacher Code (visible only for Teacher role) -->
                <StackPanel Visibility="{Binding IsTeacherRole, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Mã giảng viên *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#333"/>
                    <TextBox Text="{Binding TeacherCode, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Padding="12,10" Margin="0,0,0,5"
                             mah:TextBoxHelper.Watermark="VD: GV001"
                             mah:TextBoxHelper.ClearTextButton="True"/>
                    <TextBlock Text="{Binding TeacherCodeError}" 
                               Foreground="#DC143C" FontSize="11" Margin="2,0,0,15"
                               Visibility="{Binding TeacherCodeError, Converter={StaticResource NullToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Phone (optional, visible for Teacher) -->
                <StackPanel Visibility="{Binding IsTeacherRole, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Số điện thoại" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#333"/>
                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Padding="12,10" Margin="0,0,0,15"
                             mah:TextBoxHelper.Watermark="VD: 0912345678"
                             mah:TextBoxHelper.ClearTextButton="True"/>
                </StackPanel>

                <!-- Active Status -->
                <CheckBox IsChecked="{Binding IsActive}" Margin="0,5,0,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CheckCircle" Width="16" Height="16" 
                                                   Foreground="{Binding IsActive, Converter={StaticResource BoolToColorConverter}}" 
                                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Kích hoạt tài khoản ngay" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Hủy" 
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource MahApps.Styles.Button}"
                    Width="100" Height="40" Margin="0,0,10,0"
                    Background="#E0E0E0" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
                        <Setter Property="Foreground" Value="#333"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D0D0D0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Grid.Column="2" Content="Thêm người dùng" 
                    Command="{Binding ConfirmCommand}"
                    Width="150" Height="40"
                    Background="#DC143C" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B81030"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3" Background="#80FFFFFF" 
              Visibility="{Binding IsSubmitting, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="True" Width="60" Height="60" Foreground="#DC143C"/>
                <TextBlock Text="Đang tạo người dùng..." FontSize="14" FontWeight="SemiBold" 
                           Margin="0,15,0,0" HorizontalAlignment="Center" Foreground="#333"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
