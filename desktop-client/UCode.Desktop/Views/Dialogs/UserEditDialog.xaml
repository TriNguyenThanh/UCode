<mah:MetroWindow x:Class="UCode.Desktop.Views.Dialogs.UserEditDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 Title="Edit User" 
                 Height="600" 
                 Width="600"
                 WindowStartupLocation="CenterOwner"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
                 ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Edit User" 
                      FontSize="24"
                      FontWeight="Bold"
                      Foreground="#1976D2"/>
            <TextBlock Text="{Binding UserEmail}" 
                      FontSize="14"
                      Foreground="#666"
                      Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Full Name -->
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="Full Name *"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Margin="0,0,0,15"/>

                <!-- Email (Read-only) -->
                <TextBox Text="{Binding Email}"
                        materialDesign:HintAssist.Hint="Email"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        IsReadOnly="True"
                        Background="#F5F5F5"
                        Margin="0,0,0,15"/>

                <!-- Role -->
                <ComboBox SelectedValue="{Binding SelectedRole}"
                         materialDesign:HintAssist.Hint="Role *"
                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                         Margin="0,0,0,15">
                    <ComboBoxItem Content="Admin" Tag="Admin"/>
                    <ComboBoxItem Content="Teacher" Tag="Teacher"/>
                    <ComboBoxItem Content="Student" Tag="Student"/>
                </ComboBox>

                <!-- Active Status -->
                <CheckBox IsChecked="{Binding IsActive}"
                         Content="Active"
                         Style="{StaticResource MaterialDesignCheckBox}"
                         Margin="0,0,0,20"/>

                <!-- Phone Number -->
                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="Phone Number"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Margin="0,0,0,15"/>

                <!-- Address -->
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="Address"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        MinHeight="60"
                        Margin="0,0,0,15"/>

                <!-- Student Code (only for students) -->
                <TextBox Text="{Binding StudentCode, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="Student Code"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Visibility="{Binding IsStudent, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0,0,0,15"/>

                <!-- Department (only for teachers) -->
                <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="Department"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Visibility="{Binding IsTeacher, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0,0,0,15"/>

                <!-- Validation Message -->
                <TextBlock Text="{Binding ValidationMessage}"
                          Foreground="#D32F2F"
                          FontSize="12"
                          TextWrapping="Wrap"
                          Margin="0,0,0,10"
                          Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                   Content="Cancel"
                   Style="{StaticResource MaterialDesignOutlinedButton}"
                   Width="120"
                   Margin="0,0,10,0"
                   Click="CancelButton_Click"/>

            <Button Grid.Column="2"
                   Content="Save Changes"
                   Style="{StaticResource MaterialDesignRaisedButton}"
                   Width="120"
                   Click="SaveButton_Click"
                   IsEnabled="{Binding CanSave}"/>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3"
              Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                            IsIndeterminate="True"
                            Width="50"
                            Height="50"/>
                <TextBlock Text="Saving changes..."
                          Foreground="White"
                          FontSize="14"
                          Margin="0,15,0,0"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</mah:MetroWindow>
