<mah:MetroWindow x:Class="UCode.Desktop.Views.Dialogs.ClassEditDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                Title="Edit Class"
                Width="500"
                Height="450"
                WindowStartupLocation="CenterOwner"
                ResizeMode="NoResize"
                ShowInTaskbar="False"
                Loaded="Window_Loaded"
                Style="{StaticResource MaterialDesignWindow}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Edit Class"
                      Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                      Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="Update class information and reassign teacher"
                      Style="{StaticResource MaterialDesignBody2TextBlock}"
                      Foreground="{DynamicResource MaterialDesignBodyLight}"
                      Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Class Name -->
                <TextBox Text="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="Class Name *"
                        materialDesign:HintAssist.IsFloating="True"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Margin="0,0,0,15"
                        MaxLength="100"/>

                <!-- Description -->
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="Description"
                        materialDesign:HintAssist.IsFloating="True"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        Height="100"
                        VerticalScrollBarVisibility="Auto"
                        Margin="0,0,0,15"
                        MaxLength="500"/>

                <!-- Teacher -->
                <ComboBox ItemsSource="{Binding Teachers}"
                         SelectedItem="{Binding SelectedTeacher}"
                         DisplayMemberPath="FullName"
                         materialDesign:HintAssist.Hint="Teacher *"
                         materialDesign:HintAssist.IsFloating="True"
                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                         Margin="0,0,0,15"/>

                <!-- Active Status -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <materialDesign:PackIcon Kind="Information" 
                                           Width="20" Height="20"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                    <TextBlock Text="Class Status:" 
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                    <ToggleButton IsChecked="{Binding IsActive}"
                                 Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                 ToolTip="Toggle class active status"/>
                    <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToActiveStatusConverter}}"
                              VerticalAlignment="Center"
                              Margin="10,0,0,0"
                              FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Validation Message -->
                <Border Background="#FFEBEE"
                       BorderBrush="#F44336"
                       BorderThickness="1"
                       CornerRadius="4"
                       Padding="10"
                       Margin="0,10,0,0"
                       Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircle"
                                               Width="20" Height="20"
                                               Foreground="#F44336"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding ValidationMessage}"
                                  Foreground="#C62828"
                                  TextWrapping="Wrap"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2"
                   Orientation="Horizontal"
                   HorizontalAlignment="Right"
                   Margin="0,20,0,0">
            <Button Content="CANCEL"
                   Style="{StaticResource MaterialDesignOutlinedButton}"
                   Width="100"
                   Margin="0,0,10,0"
                   Click="CancelButton_Click"/>
            <Button Content="UPDATE"
                   Style="{StaticResource MaterialDesignRaisedButton}"
                   Width="100"
                   IsEnabled="{Binding CanUpdate}"
                   Click="UpdateButton_Click">
                <Button.CommandParameter>
                    <materialDesign:PackIcon Kind="Check"/>
                </Button.CommandParameter>
            </Button>
        </StackPanel>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3"
             Background="#80000000"
             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                            Width="50" Height="50"
                            IsIndeterminate="True"
                            Foreground="White"/>
                <TextBlock Text="Updating class..."
                          Foreground="White"
                          FontSize="14"
                          Margin="0,10,0,0"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</mah:MetroWindow>
