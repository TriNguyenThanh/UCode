<mah:MetroWindow x:Class="UCode.Desktop.Views.MainWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                      xmlns:local="clr-namespace:UCode.Desktop.Helpers"
                      xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
                      Dialog:DialogParticipation.Register="{Binding}"
                      Title="UCode - Trang chủ"
                      Height="800"
                      Width="1400"
                      WindowStartupLocation="CenterScreen"
                      WindowState="Maximized"
                      TextOptions.TextFormattingMode="Display"
                      TextOptions.TextRenderingMode="ClearType"
                      RenderOptions.BitmapScalingMode="HighQuality"
                      Icon="pack://application:,,,/Resources/favicon.ico">

    <!-- Left Window Commands - Back Button -->
    <mah:MetroWindow.LeftWindowCommands>
        <mah:WindowCommands>
            <Button Command="{Binding GoBackCommand}"
                    ToolTip="Quay lại"
                    Cursor="Hand"
                    Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ArrowLeft" 
                                              Width="16" 
                                              Height="16"
                                              Margin="0,0,5,0"/>
                    <TextBlock Text="Quay lại" 
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </mah:WindowCommands>
    </mah:MetroWindow.LeftWindowCommands>

    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <local:DaysLeftToBackgroundConverter x:Key="DaysLeftToBackgroundConverter"/>
        <local:InverseCountToVisibilityConverter x:Key="InverseCountToVisibilityConverter"/>
        <local:ClassIdToGradientConverter x:Key="ClassIdToGradientConverter"/>

        <!-- Custom Navigation Button Style - No gray background -->
        <Style x:Key="NavButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MahApps.Styles.Button.Flat}">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#1AFFFFFF"/>
                    <Setter Property="Foreground"
                            Value="#FACB01"/>
                </Trigger>
                <Trigger Property="IsPressed"
                         Value="True">
                    <Setter Property="Background"
                            Value="#33FFFFFF"/>
                    <Setter Property="Foreground"
                            Value="#FACB01"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Gradient Brush for Class Cards -->
        <LinearGradientBrush x:Key="ClassCardGradientBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#667eea"
                          Offset="0"/>
            <GradientStop Color="#764ba2"
                          Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar - Blue background like Web -->
        <Border x:Name="TopNavigationBar"
                Grid.Row="0"
                Background="#00275E"
                Height="64"
                Panel.ZIndex="10"
                Visibility="{Binding IsNavigationBarVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect Color="Black"
                                  BlurRadius="10"
                                  ShadowDepth="2"
                                  Opacity="0.1"/>
            </Border.Effect>
            <Grid Margin="0,0,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo & Title -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="24,0,0,0">
                    <iconPacks:PackIconMaterial Kind="CodeBraces"
                                                Width="28"
                                                Height="28"
                                                Foreground="#FACB01"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0"/>
                    <TextBlock Text="UCode"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#FACB01"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="60,0,0,0"
                            VerticalAlignment="Center">
                    <Button Foreground="#FACB01"
                            FontSize="15"
                            FontWeight="SemiBold"
                            FontFamily="Be Vietnam Pro, Segoe UI"
                            Margin="0,0,8,0"
                            Height="40"
                            Padding="16,0"
                            Cursor="Hand"
                            Focusable="False"
                            ClickMode="Press"
                            Command="{Binding NavigateToHomeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <!-- Active State for Home -->
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Home">
                                        <Setter Property="Background" Value="#33FFFFFF"/>
                                        <Setter Property="BorderBrush" Value="#FACB01"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,3"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="TRANG CHỦ"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <Button Foreground="#FACB01"
                            FontSize="15"
                            FontWeight="SemiBold"
                            FontFamily="Be Vietnam Pro, Segoe UI"
                            Margin="0,0,8,0"
                            Height="40"
                            Padding="16,0"
                            Cursor="Hand"
                            Focusable="False"
                            ClickMode="Press"
                            Command="{Binding NavigateToAssignmentsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <!-- Active State for Assignments -->
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Assignments">
                                        <Setter Property="Background" Value="#33FFFFFF"/>
                                        <Setter Property="BorderBrush" Value="#FACB01"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,3"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="BÀI TẬP"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <Button Foreground="#FACB01"
                            FontSize="15"
                            FontWeight="SemiBold"
                            FontFamily="Be Vietnam Pro, Segoe UI"
                            Margin="0,0,8,0"
                            Height="40"
                            Padding="16,0"
                            Cursor="Hand"
                            Focusable="False"
                            ClickMode="Press"
                            Command="{Binding NavigateToSubmissionsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <!-- Active State for Submissions -->
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Submissions">
                                        <Setter Property="Background" Value="#33FFFFFF"/>
                                        <Setter Property="BorderBrush" Value="#FACB01"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,3"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="LỊCH SỬ NỘP BÀI"
                                   VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- User Menu -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,0">
                    <!-- Account Circle Icon with Context Menu -->
                    <Button Style="{StaticResource NavButtonStyle}"
                            Foreground="#FACB01"
                            FontSize="24"
                            Cursor="Hand"
                            Padding="8"
                            Name="UserMenuButton"
                            Click="UserMenuButton_Click">
                        <iconPacks:PackIconMaterial Kind="AccountCircle"
                                                    Width="28"
                                                    Height="28"
                                                    VerticalAlignment="Center"/>
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom"
                                         HasDropShadow="True">
                                <ContextMenu.Template>
                                    <ControlTemplate TargetType="ContextMenu">
                                        <Border Background="White"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="4">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black"
                                                        BlurRadius="12"
                                                        ShadowDepth="2"
                                                        Opacity="0.15"/>
                                            </Border.Effect>
                                            <StackPanel IsItemsHost="True"
                                                        MinWidth="240"/>
                                        </Border>
                                    </ControlTemplate>
                                </ContextMenu.Template>
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="FontFamily"
                                                Value="Segoe UI, Be Vietnam Pro"/>
                                        <Setter Property="FontSize"
                                                Value="14"/>
                                        <Setter Property="Height"
                                                Value="44"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Border x:Name="Border"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Margin="4,2"
                                                            CornerRadius="4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ContentPresenter Grid.Column="0"
                                                                              ContentSource="Icon"
                                                                              Margin="12,0,12,0"
                                                                              VerticalAlignment="Center"/>
                                                            <ContentPresenter Grid.Column="1"
                                                                              ContentSource="Header"
                                                                              VerticalAlignment="Center"
                                                                              Margin="0,0,16,0"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsEnabled"
                                                                Value="False">
                                                            <Setter TargetName="Border"
                                                                    Property="Opacity"
                                                                    Value="1"/>
                                                        </Trigger>
                                                        <Trigger Property="IsHighlighted"
                                                                Value="True">
                                                            <Setter TargetName="Border"
                                                                    Property="Background"
                                                                    Value="#F3F4F6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style TargetType="Separator">
                                        <Setter Property="Height"
                                                Value="1"/>
                                        <Setter Property="Margin"
                                                Value="8,4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Separator">
                                                    <Border Background="#E5E7EB"
                                                            Height="1"
                                                            Margin="0"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.Resources>

                                <!-- Email header -->
                                <MenuItem IsEnabled="False">
                                    <MenuItem.Header>
                                        <TextBlock Text="{Binding UserEmail}"
                                                   Foreground="#9CA3AF"
                                                   FontSize="13"
                                                   FontWeight="Normal"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </MenuItem.Header>
                                </MenuItem>

                                <Separator/>
                                <MenuItem Header="Hồ sơ"
                                          FontSize="14"
                                          Padding="16,8"
                                          Click="ProfileMenuItem_Click">
                                    <MenuItem.Icon>
                                        <iconPacks:PackIconMaterial Kind="Account"
                                                                    Width="20"
                                                                    Height="20"
                                                                    Foreground="#6B7280"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Cài đặt"
                                          FontSize="14"
                                          Padding="16,8"
                                          Click="SettingsMenuItem_Click">
                                    <MenuItem.Icon>
                                        <iconPacks:PackIconMaterial Kind="Cog"
                                                                    Width="20"
                                                                    Height="20"
                                                                    Foreground="#6B7280"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator/>

                                <!-- Logout -->
                                <MenuItem Header="Đăng xuất"
                                          Click="LogoutMenuItem_Click">
                                    <MenuItem.Icon>
                                        <iconPacks:PackIconMaterial Kind="Logout"
                                                                    Width="20"
                                                                    Height="20"
                                                                    Foreground="#EF4444"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area - Navigation Frame -->
        <ContentControl x:Name="NavigationFrame"
                        Grid.Row="1"
                        Background="#F5F5F5"/>

        <!-- Default Home Content (will be replaced by navigation) -->
        <ScrollViewer Grid.Row="1"
                      x:Name="HomeScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      Background="#F5F5F5">
            <Grid Margin="0,0,0,40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1"
                            Margin="0,30,0,0">
                    <!-- Welcome Section -->
                    <StackPanel Margin="0,0,0,30">
                        <TextBlock FontSize="32"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8">
                            <Run Text="Xin chào, "/>
                            <Run Text="{Binding UserName}"/>
                            <Run Text="!"/>
                        </TextBlock>
                        <TextBlock Text="Hôm nay bạn muốn học gì?"
                                   FontSize="16"
                                   Foreground="#666"
                                   Margin="0,0,0,0"/>
                    </StackPanel>

                    <!-- Lớp học của tôi -->
                    <StackPanel Margin="0,0,0,40">
                        <!-- Section Header -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,20">
                            <iconPacks:PackIconMaterial Kind="GoogleClassroom"
                                                        Width="28"
                                                        Height="28"
                                                        Foreground="#FACB01"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,12,0"/>
                            <TextBlock Text="Lớp học của tôi"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Classes Grid -->
                        <ItemsControl ItemsSource="{Binding Classes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.NavigateToClassCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}"
                                            Cursor="Hand"
                                            Margin="0,0,24,24">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="White"
                                                        BorderBrush="#E0E0E0"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Width="350"
                                                        Height="200">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="Black"
                                                                          BlurRadius="10"
                                                                          ShadowDepth="2"
                                                                          Opacity="0.1"/>
                                                    </Border.Effect>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="120"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Class Header with Gradient -->
                                                        <Border Grid.Row="0"
                                                                Background="{Binding Id, Converter={StaticResource ClassIdToGradientConverter}}"
                                                                CornerRadius="8,8,0,0">
                                                            <TextBlock Text="{Binding Code}"
                                                                       FontSize="22"
                                                                       FontWeight="Bold"
                                                                       Foreground="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       TextAlignment="Center"
                                                                       Padding="10"/>
                                                        </Border>

                                                        <!-- Class Info -->
                                                        <StackPanel Grid.Row="1"
                                                                    Margin="20">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="18"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,0,0,8"
                                                                       HorizontalAlignment="Left"/>
                                                            <TextBlock Text="{Binding TeacherName}"
                                                                       FontSize="14"
                                                                       Foreground="#666"
                                                                       Margin="0,0,0,12"
                                                                       HorizontalAlignment="Left"/>
                                                            
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Margin="0,0,0,40"
                            Background="#E0E0E0"
                            Height="1"
                            HorizontalAlignment="Stretch"/>

                    <!-- Việc cần làm (7 ngày tới) -->
                    <StackPanel Margin="0,0,0,40">
                        <!-- Section Header -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,20">
                            <iconPacks:PackIconMaterial Kind="ClockAlertOutline"
                                                        Width="28"
                                                        Height="28"
                                                        Foreground="#F44336"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,12,0"/>
                            <TextBlock Text="Việc cần làm"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Border Background="#FFEBEE"
                                    CornerRadius="12"
                                    Padding="8,4"
                                    Margin="12,0,0,0">
                                <TextBlock FontSize="12"
                                           Foreground="#F44336"
                                           FontWeight="SemiBold">
                                    <Run Text="{Binding UpcomingAssignmentsCount, Mode=OneWay}"/>
                                    <Run Text=" bài tập"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <!-- Assignments List -->
                        <ItemsControl ItemsSource="{Binding UpcomingAssignments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.NavigateToAssignmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}"
                                            Cursor="Hand"
                                            Margin="0,0,0,16">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="White"
                                                        BorderBrush="#E0E0E0"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="20">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="Black"
                                                                          BlurRadius="10"
                                                                          ShadowDepth="2"
                                                                          Opacity="0.1"/>
                                                    </Border.Effect>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Icon -->
                                                        <Border Grid.Column="0"
                                                                Background="#FFEBEE"
                                                                Width="48"
                                                                Height="48"
                                                                CornerRadius="8"
                                                                Margin="0,0,16,0">
                                                            <iconPacks:PackIconMaterial Kind="ClipboardText"
                                                                                        Width="24"
                                                                                        Height="24"
                                                                                        Foreground="#F44336"
                                                                                        HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Info -->
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="18"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,0,0,8"
                                                                       HorizontalAlignment="Left"/>
                                                            <TextBlock Text="{Binding AssignmentType}"
                                                                       FontSize="14"
                                                                       Foreground="#666"
                                                                       Margin="0,0,0,12"
                                                                       HorizontalAlignment="Left"/>
                                                            <WrapPanel Orientation="Horizontal">
                                                                <Border Background="{Binding DaysLeft, Converter={StaticResource DaysLeftToBackgroundConverter}}"
                                                                        CornerRadius="12"
                                                                        Padding="8,4"
                                                                        Margin="0,0,8,0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <iconPacks:PackIconMaterial Kind="ClockOutline"
                                                                                                    Width="14"
                                                                                                    Height="14"
                                                                                                    Foreground="White"
                                                                                                    VerticalAlignment="Center"
                                                                                                    Margin="0,0,5,0"/>
                                                                        <TextBlock FontSize="12"
                                                                                   Foreground="White"
                                                                                   FontWeight="SemiBold">
                                                                            <Run Text="Còn"/>
                                                                            <Run Text="{Binding DaysLeft}"/>
                                                                            <Run Text="ngày"/>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border BorderBrush="#E0E0E0"
                                                                        BorderThickness="1"
                                                                        CornerRadius="12"
                                                                        Padding="8,4"
                                                                        Margin="0,0,8,0">
                                                                    <TextBlock FontSize="12"
                                                                               Foreground="#666">
                                                                        <Run Text="{Binding ProblemCount}"/>
                                                                        <Run Text=" bài"/>
                                                                    </TextBlock>
                                                                </Border>
                                                                <Border BorderBrush="#E0E0E0"
                                                                        BorderThickness="1"
                                                                        CornerRadius="12"
                                                                        Padding="8,4">
                                                                    <TextBlock FontSize="12"
                                                                               Foreground="#666">
                                                                        <Run Text="{Binding TotalPoints}"/>
                                                                        <Run Text=" điểm"/>
                                                                    </TextBlock>
                                                                </Border>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State -->
                        <Border Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="40"
                                Visibility="{Binding UpcomingAssignments.Count, Converter={StaticResource InverseCountToVisibilityConverter}}">
                            <TextBlock Text="Bạn không có bài tập nào sắp đến hạn trong 7 ngày tới 🎉"
                                       FontSize="16"
                                       Foreground="#666"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Margin="0,0,0,40"
                            Background="#E0E0E0"
                            Height="1"
                            HorizontalAlignment="Stretch"/>

                    <!-- Luyện tập -->
                    <!--
                    <StackPanel Margin="0,0,0,40">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,20">
                            <iconPacks:PackIconMaterial Kind="CodeBraces"
                                                        Width="28"
                                                        Height="28"
                                                        Foreground="#4CAF50"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,12,0"/>
                            <TextBlock Text="Luyện tập"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding PracticeCategories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,0,24,24"
                                            Width="280"
                                            Padding="20"
                                            Cursor="Hand">
