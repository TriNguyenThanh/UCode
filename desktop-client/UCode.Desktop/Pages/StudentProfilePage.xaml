<Page x:Class="UCode.Desktop.Pages.StudentProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      Title="Hồ sơ - Sinh viên"
      Background="#F5F5F7"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Stat Card Style -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D2D2D7"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.08" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,30">
            <!-- Top Bar with Refresh Button -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                <Button Style="{DynamicResource MahApps.Styles.Button.Flat}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="#3B82F6"
                        Command="{Binding RefreshCommand}"
                        ToolTip="Làm mới">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Refresh"
                                                    Width="22"
                                                    Height="22"
                                                    VerticalAlignment="Center"/>
                        <TextBlock Text="Làm mới"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <!-- Profile Header Card -->
            <Border Style="{StaticResource StatCardStyle}" Margin="0,0,0,24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#F5F5F7" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar -->
                    <Border Grid.Column="0"
                            Width="140" Height="140"
                            CornerRadius="70"
                            Background="#3B82F6"
                            BorderThickness="4"
                            BorderBrush="White"
                            Margin="0,0,30,0">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.1" Color="Black"/>
                        </Border.Effect>
                        <TextBlock Text="{Binding FirstCharacter}"
                                   FontSize="56"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- User Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- Name and Badges -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="{Binding FullName}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#1D1D1F"
                                       VerticalAlignment="Center"/>
                            
                            <Border Background="#3B82F6"
                                    CornerRadius="4"
                                    Padding="10,6"
                                    Margin="12,0,0,0"
                                    Height="32"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Account"
                                                                Width="16" Height="16"
                                                                Foreground="White"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,6,0"/>
                                    <TextBlock Text="Sinh viên"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!--
                            <Border Background="#FF9500"
                                    CornerRadius="4"
                                    Padding="10,6"
                                    Margin="8,0,0,0"
                                    Height="32"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="TrophyAward"
                                                                Width="16" Height="16"
                                                                Foreground="White"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Rank}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            -->
                        </StackPanel>

                        <!-- Contact Info -->
                        <StackPanel Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <iconPacks:PackIconMaterial Kind="Email"
                                                            Width="20" Height="20"
                                                            Foreground="#86868B"
                                                            Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Email}"
                                           FontSize="15"
                                           FontWeight="Medium"
                                           Foreground="#1D1D1F"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CardAccountDetails"
                                                            Width="20" Height="20"
                                                            Foreground="#86868B"
                                                            Margin="0,0,10,0"/>
                                <TextBlock FontSize="15" FontWeight="Medium" Foreground="#1D1D1F">
                                    <Run Text="Mã sinh viên: "/>
                                    <Run Text="{Binding StudentCode}" FontWeight="Bold"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <!-- Points -->
                        <!--
                        <Border Background="#3B82F6"
                                CornerRadius="8"
                                Padding="16,10"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="TrendingUp"
                                                            Width="24" Height="24"
                                                            Foreground="White"
                                                            Margin="0,0,8,0"/>
                                <TextBlock FontSize="20" FontWeight="Bold" Foreground="White">
                                    <Run Text="{Binding Points}"/>
                                    <Run Text=" điểm"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        -->
                    </StackPanel>

                    <!-- Edit Button -->
                    <!--
                    <Button Grid.Column="2"
                            Content="Chỉnh sửa"
                            Click="EditButton_Click"
                            Style="{StaticResource MahApps.Styles.Button.Flat}"
                            BorderBrush="#D2D2D7"
                            BorderThickness="1"
                            Padding="16,8"
                            FontWeight="SemiBold"
                            VerticalAlignment="Top">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Pencil" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    -->
                </Grid>
            </Border>

            <!-- Student Info Card -->
            <!--
            <Border Style="{StaticResource StatCardStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Thông tin sinh viên"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#1D1D1F"
                               Margin="0,0,0,20"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                     
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <Border Background="#3B82F615"
                                    CornerRadius="8"
                                    Padding="12"
                                    Width="48" Height="48"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <iconPacks:PackIconMaterial Kind="CalendarMonth"
                                                            Width="24" Height="24"
                                                            Foreground="#3B82F6"/>
                            </Border>
                            <TextBlock Text="Năm nhập học"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#86868B"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding EnrollmentYear}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#1D1D1F"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <Border Background="#3B82F615"
                                    CornerRadius="8"
                                    Padding="12"
                                    Width="48" Height="48"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <iconPacks:PackIconMaterial Kind="School"
                                                            Width="24" Height="24"
                                                            Foreground="#3B82F6"/>
                            </Border>
                            <TextBlock Text="Chuyên ngành"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#86868B"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Major}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#1D1D1F"/>
                        </StackPanel>

               
                        <StackPanel Grid.Column="2">
                            <Border Background="#3B82F615"
                                    CornerRadius="8"
                                    Padding="12"
                                    Width="48" Height="48"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <iconPacks:PackIconMaterial Kind="GoogleClassroom"
                                                            Width="24" Height="24"
                                                            Foreground="#3B82F6"/>
                            </Border>
                            <TextBlock Text="Năm học"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#86868B"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ClassYear}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#1D1D1F"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            -->
            
            <!-- Statistics Title -->
            <TextBlock Text="Thống kê hoạt động"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1D1D1F"
                       Margin="0,16,0,16"/>

            <!-- Statistics Grid -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Classes -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Lớp học"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#86868B"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                            <Border Background="#007AFF15"
                                    CornerRadius="8"
                                    Padding="8"
                                    HorizontalAlignment="Right">
                                <iconPacks:PackIconMaterial Kind="School" Width="24" Height="24" Foreground="#007AFF"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding TotalClasses}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#1D1D1F"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Đang tham gia"
                                   FontSize="13"
                                   Foreground="#86868B"/>
                    </StackPanel>
                </Border>

                <!-- Completed Assignments -->
                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Bài tập"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#86868B"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                            <Border Background="#34C75915"
                                    CornerRadius="8"
                                    Padding="8"
                                    HorizontalAlignment="Right">
                                <iconPacks:PackIconMaterial Kind="CheckCircle" Width="24" Height="24" Foreground="#34C759"/>
                            </Border>
                        </Grid>
                        <TextBlock FontSize="32" FontWeight="Bold" Foreground="#1D1D1F" Margin="0,0,0,4">
                            <Run Text="{Binding CompletedAssignments}"/><Run Text="/"/><Run Text="{Binding TotalAssignments}"/>
                        </TextBlock>
                        <TextBlock FontSize="13" Foreground="#86868B">
                            <Run Text="Hoàn thành "/><Run Text="{Binding CompletionRate, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Problems Solved -->
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Bài giải"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#86868B"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                            <Border Background="#AF52DE15"
                                    CornerRadius="8"
                                    Padding="8"
                                    HorizontalAlignment="Right">
                                <iconPacks:PackIconMaterial Kind="CodeBraces" Width="24" Height="24" Foreground="#AF52DE"/>
                            </Border>
                        </Grid>
                        <TextBlock FontSize="32" FontWeight="Bold" Foreground="#1D1D1F" Margin="0,0,0,4">
                            <Run Text="{Binding ProblemsSolved}"/><Run Text="/"/><Run Text="{Binding TotalProblems}"/>
                        </TextBlock>
                        <TextBlock FontSize="13" Foreground="#86868B">
                            <Run Text="Đã giải "/><Run Text="{Binding ProblemSolvedRate, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Current Streak -->
                <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Chuỗi ngày"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#86868B"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                            <Border Background="#FF950015"
                                    CornerRadius="8"
                                    Padding="8"
                                    HorizontalAlignment="Right">
                                <iconPacks:PackIconMaterial Kind="TrophyAward" Width="24" Height="24" Foreground="#FF9500"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding CurrentStreak}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#1D1D1F"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Ngày liên tiếp"
                                   FontSize="13"
                                   Foreground="#86868B"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Progress Title -->
            <TextBlock Text="Tiến độ học tập"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1D1D1F"
                       Margin="0,16,0,16"/>

            <!-- Assignment Progress -->
            <Border Style="{StaticResource StatCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Bài tập đã hoàn thành"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1D1D1F"/>
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="#34C759" HorizontalAlignment="Right">
                            <Run Text="{Binding CompletionRate, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>
                    </Grid>
                    <mah:MetroProgressBar Value="{Binding CompletionRate, Mode=OneWay}"
                                          Minimum="0" Maximum="100"
                                          Height="12"
                                          Foreground="#34C759"
                                          Background="#F5F5F7"
                                          BorderThickness="0"/>
                    <Grid Margin="0,12,0,0">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#86868B">
                            <Run Text="{Binding CompletedAssignments}"/><Run Text=" bài đã nộp"/>
                        </TextBlock>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#86868B" HorizontalAlignment="Right">
                            <Run Text="{Binding TotalAssignments}"/><Run Text=" bài tổng"/>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Problems Progress -->
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Bài tập lập trình đã giải"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1D1D1F"/>
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="#AF52DE" HorizontalAlignment="Right">
                            <Run Text="{Binding ProblemSolvedRate, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>
                    </Grid>
                    <mah:MetroProgressBar Value="{Binding ProblemSolvedRate, Mode=OneWay}"
                                          Minimum="0" Maximum="100"
                                          Height="12"
                                          Foreground="#AF52DE"
                                          Background="#F5F5F7"
                                          BorderThickness="0"/>
                    <Grid Margin="0,12,0,0">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#86868B">
                            <Run Text="{Binding ProblemsSolved}"/><Run Text=" bài đã giải"/>
                        </TextBlock>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#86868B" HorizontalAlignment="Right">
                            <Run Text="{Binding TotalProblems}"/><Run Text=" bài tổng"/>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
