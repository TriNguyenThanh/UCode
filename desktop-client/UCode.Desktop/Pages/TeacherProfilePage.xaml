<UserControl x:Class="UCode.Desktop.Pages.TeacherProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:UCode.Desktop.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1600"
             Background="#F5F5F5">

    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="40,30,40,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Profile Header Card -->
                <Border Grid.Row="0" 
                        Background="White"
                        CornerRadius="12"
                        Padding="40">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Avatar + Button -->
                        <StackPanel Grid.Column="0" Margin="0,0,30,0">
                            <!-- Avatar Circle -->
                            <Border Width="150"
                                    Height="150"
                                    CornerRadius="75"
                                    Background="#7C4DFF"
                                    Margin="0,0,0,15">
                                <TextBlock Text="{Binding Initials}"
                                           FontSize="60"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Edit Button -->
                        </StackPanel>

                        <!-- Right: Profile Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <!-- Name + Badge -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="{Binding FullName}"
                                           FontSize="36"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,15,0"/>
                                <Border Background="#7C4DFF"
                                        CornerRadius="20"
                                        Padding="12,6"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="School"
                                                                    Width="16"
                                                                    Height="16"
                                                                    Foreground="White"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,6,0"/>
                                        <TextBlock Text="Giảng viên"
                                                   FontSize="13"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Email -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <iconPacks:PackIconMaterial Kind="Email"
                                                            Width="20"
                                                            Height="20"
                                                            Foreground="#666"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Email}"
                                           FontSize="16"
                                           Foreground="#666"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Teacher Code -->
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Briefcase"
                                                            Width="20"
                                                            Height="20"
                                                            Foreground="#666"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,10,0"/>
                                <TextBlock FontSize="16"
                                           Foreground="#666"
                                           VerticalAlignment="Center">
                                    <Run Text="Mã giảng viên:"/>
                                    <Run Text="{Binding TeacherCode}"
                                         FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Teacher Information Card -->
                <Border Grid.Row="2"
                        Background="White"
                        CornerRadius="12"
                        Padding="40">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Section Header -->
                        <TextBlock Text="Thông tin giảng viên"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,0,0,30"/>

                        <!-- Info Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Department -->
                            <StackPanel Grid.Column="0">
                                <Border Background="#F3F0FF"
                                        CornerRadius="12"
                                        Width="60"
                                        Height="60"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,15">
                                    <iconPacks:PackIconMaterial Kind="School"
                                                                Width="28"
                                                                Height="28"
                                                                Foreground="#7C4DFF"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Khoa"
                                           FontSize="13"
                                           Foreground="#999"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Department}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#333"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Title -->
                            <StackPanel Grid.Column="2">
                                <Border Background="#F3F0FF"
                                        CornerRadius="12"
                                        Width="60"
                                        Height="60"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,15">
                                    <iconPacks:PackIconMaterial Kind="AccountTie"
                                                                Width="28"
                                                                Height="28"
                                                                Foreground="#7C4DFF"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Chức danh"
                                           FontSize="13"
                                           Foreground="#999"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#333"/>
                            </StackPanel>

                            <!-- Phone -->
                            <StackPanel Grid.Column="4">
                                <Border Background="#F3F0FF"
                                        CornerRadius="12"
                                        Width="60"
                                        Height="60"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,15">
                                    <iconPacks:PackIconMaterial Kind="Phone"
                                                                Width="28"
                                                                Height="28"
                                                                Foreground="#7C4DFF"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Số điện thoại"
                                           FontSize="13"
                                           Foreground="#999"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Phone}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#333"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>


            </Grid>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <!-- <Border Background="#DD000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="True"
                                  Width="80"
                                  Height="80"
                                  Foreground="Yellow"
                                  Margin="0,0,0,20"/>
                <TextBlock Text="Đang xử lý..."
                           FontSize="18"
                           Foreground="Yellow"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border> -->
    </Grid>
</UserControl>
