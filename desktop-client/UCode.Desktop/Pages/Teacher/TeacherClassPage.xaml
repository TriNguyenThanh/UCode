<UserControl x:Class="UCode.Desktop.Pages.TeacherClassPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="#F5F5F5">

    <Grid>
        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" 
              Panel.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="True" Width="60" Height="60" Foreground="#FACB01"/>
                <TextBlock Text="Đang tải dữ liệu..." Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#191970" Padding="30,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding CurrentClass.ClassName}" Foreground="#FACB01" FontSize="28" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Mã lớp: " Foreground="White" FontSize="16" Opacity="0.8"/>
                            <TextBlock Text="{Binding CurrentClass.ClassCode}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                            <!--
                            <TextBlock Text=" • " Foreground="White" FontSize="16" Margin="10,0"/>
                            
                            <TextBlock Text="Học kỳ: " Foreground="White" FontSize="16" Opacity="0.8"/>
                            <TextBlock Text="{Binding CurrentClass.Semester}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                            -->
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource YellowButtonStyle}" 
                                Command="{Binding RefreshCommand}" 
                                Margin="0,0,10,0"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Refresh" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Làm mới" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Button Style="{StaticResource YellowButtonStyle}" 
                                Command="{Binding EditClassCommand}"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Pencil" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Chỉnh sửa" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button -->
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Statistics Cards -->
            <Grid Grid.Row="1" Margin="30,20,30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <iconPacks:PackIconMaterial Kind="AccountGroup" Width="20" Height="20" Foreground="#666" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Sinh viên" FontSize="16" FontWeight="SemiBold" Foreground="#666" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalStudents}" FontSize="32" FontWeight="Bold" Foreground="#191970"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="5,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <iconPacks:PackIconMaterial Kind="BookOpenPageVariant" Width="20" Height="20" Foreground="#666" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Bài tập" FontSize="16" FontWeight="SemiBold" Foreground="#666" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalAssignments}" FontSize="32" FontWeight="Bold" Foreground="#191970"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <iconPacks:PackIconMaterial Kind="CheckCircle" Width="20" Height="20" Foreground="#28a745" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Bài tập đã giao" FontSize="16" FontWeight="SemiBold" Foreground="#666" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ActiveAssignments}" FontSize="32" FontWeight="Bold" Foreground="#28a745"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Tabs -->
            <TabControl Grid.Row="2" Margin="30,20,30,30" 
                        SelectedIndex="{Binding SelectedTabIndex}"
                        BorderThickness="0" Background="Transparent">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Border" Background="White" 
                                            CornerRadius="8,8,0,0" Padding="20,12" Margin="0,0,5,0"
                                            BorderThickness="0,0,0,3" BorderBrush="Transparent">
                                        <ContentPresenter ContentSource="Header" 
                                                        HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="#FACB01"/>
                                            <Setter TargetName="Border" Property="Background" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter TargetName="Border" Property="Background" Value="#F8F9FA"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="#191970"/>
                    </Style>
                </TabControl.Resources>
                <!-- Assignments Tab -->
                <TabItem Header="Bài tập">
                    <Border Style="{StaticResource CardStyle}" Margin="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Title and Create Button -->
                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="Danh sách bài tập" FontSize="24" FontWeight="Bold" 
                                           Foreground="#00275e" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Button  BorderThickness="0"
                                        Padding="15,10"
                                        Command="{Binding CreateAssignmentCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Plus" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="TẠO BÀI TẬP MỚI" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Table Header -->
                            <Grid Grid.Row="1" Background="#00275e" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="Tên bài tập" Foreground="#FACB01" FontWeight="Bold" 
                                           FontSize="16" Padding="20,15" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Hạn nộp" Foreground="#FACB01" FontWeight="Bold" 
                                           FontSize="16" Padding="20,15" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Số bài" Foreground="#FACB01" FontWeight="Bold" 
                                           FontSize="16" Padding="20,15" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Trạng thái" Foreground="#FACB01" FontWeight="Bold" 
                                           FontSize="16" Padding="20,15" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="Thao tác" Foreground="#FACB01" FontWeight="Bold" 
                                           FontSize="16" Padding="20,15" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Assignments List -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Assignments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                                <Grid MinHeight="60">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Tên bài tập -->
                                                    <TextBlock Grid.Column="0" Text="{Binding Title}" 
                                                               FontSize="16" Foreground="#00275e" 
                                                               Padding="20,15" VerticalAlignment="Center" TextWrapping="Wrap"
                                                               Cursor="Hand" TextDecorations="Underline">
                                                        <TextBlock.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" 
                                                                          Command="{Binding DataContext.ViewAssignmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                          CommandParameter="{Binding AssignmentId}"/>
                                                        </TextBlock.InputBindings>
                                                    </TextBlock>

                                                    <!-- Hạn nộp -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,10">
                                                        <TextBlock FontSize="15" Foreground="#333">
                                                            <Run Text="{Binding EndTime, StringFormat='dd/MM/yyyy HH:mm', TargetNullValue='Không giới hạn'}"/>
                                                        </TextBlock>
                                                        <TextBlock FontSize="12" Foreground="#666" Text="{Binding EndTime, Converter={StaticResource DeadlineDisplayConverter}}"/>
                                                    </StackPanel>

                                                    <!-- Số bài -->
                                                    <TextBlock Grid.Column="2" FontSize="15" Foreground="#333"
                                                               Padding="30,15" VerticalAlignment="Center">
                                                        <Run Text="{Binding TotalProblems}"/>
                                                        <Run Text=" bài"/>
                                                    </TextBlock>

                                                    <!-- Trạng thái -->
                                                    <Border Grid.Column="3" 
                                                            Background="{Binding Status, Converter={StaticResource AssignmentStatusToColorConverter}}"
                                                            CornerRadius="20" Padding="15,8" Margin="35,10"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status, Converter={StaticResource AssignmentStatusConverter}}" 
                                                                   Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                    </Border>

                                                    <!-- Thao tác -->
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" 
                                                                VerticalAlignment="Center" Margin="10">
                                                        <Button ToolTip="Chỉnh sửa"
                                                                Background="Transparent" BorderThickness="0"
                                                                Padding="8" Margin="20,0,5,0" Cursor="Hand"
                                                                Command="{Binding DataContext.ViewAssignmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding AssignmentId}">
                                                            <iconPacks:PackIconMaterial Kind="Pencil" Width="18" Height="18" Foreground="#00275e"/>
                                                        </Button>
                                                        <Button ToolTip="Xóa"
                                                                Background="Transparent" BorderThickness="0"
                                                                Padding="8" Cursor="Hand">
                                                            <iconPacks:PackIconMaterial Kind="Delete" Width="18" Height="18" Foreground="#dc3545"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </TabItem>
                
                <!-- Students Tab -->
                <TabItem Header="Sinh viên">
                    <Border Style="{StaticResource CardStyle}" Margin="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" >
                                    <!-- TextBlock Text="Tìm kiếm sinh viên" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,8"/ -->
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Height="45" FontSize="14" Padding="12" Margin="0,0,0,5"
                                             mah:TextBoxHelper.Watermark="Nhập MSSV, họ tên hoặc email..."
                                             mah:ControlsHelper.CornerRadius="10">
                                        <mah:TextBoxHelper.ButtonContent>
                                            <iconPacks:PackIconMaterial Kind="Magnify" Width="16" Height="16"/>
                                        </mah:TextBoxHelper.ButtonContent>
                                    </TextBox>                                  
                                </StackPanel >

                                <Button Grid.Column="1" 
                                        Style="{StaticResource PrimaryButtonStyle}" 
                                        Command="{Binding AddStudentCommand}" 
                                        Margin="20,0,0,0"
                                        Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Plus" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="THÊM SINH VIÊN" FontSize="14" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Students DataGrid -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredStudents}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      RowHeight="60">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8F9FA"/>
                                        <Setter Property="Foreground" Value="#191970"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="15,10"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#F0F0F0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F8F9FA"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="15,10"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.CellStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="STT" Binding="{Binding RowNumber}" Width="100"/>
                                    <DataGridTextColumn Header="MSSV" Binding="{Binding StudentCode}" Width="120"/>
                                    <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="2*"/>
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                                    <DataGridTextColumn Header="Ngành" Binding="{Binding Major}" Width="*"/>
                                    <!--DataGridTextColumn Header="Khóa" Binding="{Binding ClassYear}" Width="80"/-->
                                    
                                    <DataGridTemplateColumn Header="Thao tác" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Xóa" 
                                                        Command="{Binding DataContext.RemoveStudentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding UserId}"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Padding="12,6"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- Attendance Tab -->
                <TabItem Header="Điểm danh">
                    <Border Style="{StaticResource CardStyle}" Margin="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="Quản lý điểm danh" FontSize="24" FontWeight="Bold" 
                                           Foreground="#191970" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource YellowButton}"
                                        Command="{Binding CreateAttendanceSessionCommand}"
                                        HorizontalAlignment="Right"
                                        Padding="15,10">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Plus" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="TẠO PHIÊN ĐIỂM DANH" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Attendance Sessions DataGrid -->
                            <DataGrid Grid.Row="1" 
                                      ItemsSource="{Binding AttendanceSessions}"
                                      Style="{StaticResource ModernDataGrid}"
                                      RowStyle="{StaticResource ModernDataGridRow}"
                                      CellStyle="{StaticResource ModernDataGridCell}"
                                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Title}" Width="2*"/>
                                    <DataGridTextColumn Header="Mã phiên" Binding="{Binding SessionCode}" Width="120"/>
                                    <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartTime, StringFormat='dd/MM/yyyy HH:mm'}" Width="150"/>
                                    <DataGridTextColumn Header="Kết thúc" Binding="{Binding EndTime, StringFormat='dd/MM/yyyy HH:mm'}" Width="150"/>
                                    
                                    <DataGridTemplateColumn Header="Trạng thái" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="12" Padding="8,4" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Background" Value="#34C759"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Background" Value="#999"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Thao tác" Width="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" >
                                                    <Button Content="Chi tiết" 
                                                            Style="{StaticResource SecondaryButton}"
                                                            Command="{Binding DataContext.ViewAttendanceDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding SessionId}"
                                                            Padding="12,6"
                                                            Margin="0,0,5,0"/>
                                                    <Button Content="Xóa" 
                                                            Style="{StaticResource DangerButton}"
                                                            Command="{Binding DataContext.DeleteAttendanceSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding SessionId}"
                                                            Padding="12,6"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</UserControl>

