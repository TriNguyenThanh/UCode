<UserControl x:Class="UCode.Desktop.Pages.TeacherHomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:helpers="clr-namespace:UCode.Desktop.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600"
             Background="#F5F5F5">

    <UserControl.Resources>
        <helpers:ClassIdToGradientConverter x:Key="ClassIdToGradientConverter"/>
    </UserControl.Resources>

    <!-- Loading Overlay -->
    <Grid>
        <Grid x:Name="LoadingOverlay" Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" 
              Panel.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="True" Width="60" Height="60" Foreground="#FACB01"/>
                <TextBlock Text="Đang tải dữ liệu..." Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Welcome Section -->
            <Border Grid.Row="0" Background="White" Padding="40,30">
                <StackPanel>
                    <TextBlock FontSize="32" FontWeight="Bold" Foreground="#191970" Margin="0,0,0,5">
                        <Run Text="Xin chào, "/>
                        <Run Text="{Binding TeacherName}"/>
                        <Run Text="! 👨‍🏫"/>
                    </TextBlock>
                    <TextBlock Text="Quản lý lớp học, bài tập và đánh giá sinh viên" 
                               Foreground="#666" FontSize="16"/>
                </StackPanel>
            </Border>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,30,40,40">
                    
                    <!-- Stats Cards Row -->
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <!--ColumnDefinition Width="*"/-->
                        </Grid.ColumnDefinitions>

                        <!-- Classes Card -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Background="#FACB01" Margin="0,0,12,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="Lớp học" FontSize="16" FontWeight="SemiBold" 
                                               Foreground="#191970" HorizontalAlignment="Left"/>
                                    <TextBlock Text="📚" FontSize="28" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding TotalClasses}" FontSize="56" FontWeight="Bold" 
                                           Foreground="#191970" Margin="0,0,0,5"/>
                                <TextBlock Text="Đang giảng dạy" FontSize="16" Foreground="#191970"/>
                            </StackPanel>
                        </Border>

                        <!-- Assignments Card -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="Bài tập" FontSize="16" FontWeight="SemiBold" 
                                               Foreground="#666" HorizontalAlignment="Left"/>
                                    <TextBlock Text="📝" FontSize="28" Foreground="#28a745" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding ActiveAssignments}" FontSize="56" FontWeight="Bold" 
                                           Foreground="#28a745" Margin="0,0,0,5"/>
                                <TextBlock Text="Đang hoạt động" FontSize="16" Foreground="#666"/>
                            </StackPanel>
                        </Border>

                        <!-- Pending Grading Card -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="Chờ chấm" FontSize="16" FontWeight="SemiBold" 
                                               Foreground="#666" HorizontalAlignment="Left"/>
                                    <TextBlock Text="📋" FontSize="28" Foreground="#ffc107" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding PendingGrading}" FontSize="56" FontWeight="Bold" 
                                           Foreground="#ffc107" Margin="0,0,0,5"/>
                                <TextBlock Text="Bài nộp chưa chấm" FontSize="16" Foreground="#666"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Classes Section -->
                    <StackPanel Margin="0,0,0,40">
                        <Grid Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Text="📚" FontSize="20" Foreground="#191970" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Lớp học của tôi" FontSize="22" FontWeight="Bold" 
                                           Foreground="#191970" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Command="{Binding CreateClassCommand}" 
                                    Style="{StaticResource YellowButton}"
                                    HorizontalAlignment="Right">
                                <TextBlock VerticalAlignment="Center" FontSize="16">
                                    <Run Text="➕ " />
                                    <Run Text="TẠO LỚP MỚI"/>
                                </TextBlock>
                            </Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Classes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,15,15" 
                                            Padding="0" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <TranslateTransform Y="-4"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect ShadowDepth="8" BlurRadius="25" Opacity="0.15" Color="#191970"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding Command="{Binding DataContext.ViewClassCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding ClassId}"
                                                          MouseAction="LeftClick"/>
                                        </Border.InputBindings>
                                        <StackPanel>
                                            <!-- Class Code Header -->
                                            <Border Height="150" CornerRadius="8,8,0,0"
                                                    Background="{Binding ClassId, Converter={StaticResource ClassIdToGradientConverter}}">
                                                <TextBlock Text="{Binding Code}" FontSize="32" FontWeight="Bold" 
                                                           Foreground="White" HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center" TextAlignment="Center"/>
                                            </Border>

                                            <!-- Class Info -->
                                            <StackPanel Margin="20">
                                                <Border Background="Transparent"  BorderThickness="1" CornerRadius="12" Padding="8,4" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" Foreground="#666"/>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="👥" FontSize="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock FontSize="16" Foreground="#666" VerticalAlignment="Center">
                                                        <Run Text="{Binding StudentCount}"/>
                                                        <Run Text=" SV"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Recent Assignments Section -->
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Text="📚" FontSize="20" Foreground="#191970" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Bài tập gần đây" FontSize="22" FontWeight="Bold" 
                                           Foreground="#191970" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- <Button Content="→" Command="{Binding ViewAllAssignmentsCommand}" 
                                    Background="White" Foreground="#191970" BorderThickness="1" BorderBrush="#E0E0E0"
                                    Width="40" Height="40" Padding="0" FontSize="20"
                                    HorizontalAlignment="Right" Cursor="Hand"/> -->
                        </Grid>

                        <ItemsControl ItemsSource="{Binding RecentAssignments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,15" 
                                            Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <TranslateTransform Y="-2"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect ShadowDepth="6" BlurRadius="20" Opacity="0.12" Color="#191970"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding Command="{Binding DataContext.ViewAssignmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding AssignmentId}"
                                                          MouseAction="LeftClick"/>
                                        </Border.InputBindings>
                                        <Grid Margin="25">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon -->
                                            <Border Grid.Column="0" Width="60" Height="60" Background="#FACB01" 
                                                    CornerRadius="8" Margin="0,0,25,0">
                                                <TextBlock Text="📚" FontSize="32" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Content -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" 
                                                           Foreground="#191970" Margin="0,0,0,5"/>
                                                <TextBlock Text="{Binding ClassName}" FontSize="16" Foreground="#666"/>
                                            </StackPanel>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                                
                                                <Button Command="{Binding DataContext.ViewReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding AssignmentId}"
                                                        Style="{StaticResource NavyTransparentButton}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Margin="0,0,5,0">
                                                            <Run Text="👁 "></Run>
                                                            <Run Text="XEM CHI TIẾT" ></Run>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
