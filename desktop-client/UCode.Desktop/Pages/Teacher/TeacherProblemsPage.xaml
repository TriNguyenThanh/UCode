<UserControl x:Class="UCode.Desktop.Pages.TeacherProblemsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:enums="clr-namespace:UCode.Desktop.Models.Enums"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="White">

    <Grid Margin="30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="CodeTags" Foreground="#191970" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Ngân hàng bài" Foreground="#191970" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Quản lý và tạo bài tập cho sinh viên" Foreground="#666" FontSize="16" Margin="0,5,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Content="+ Tạo bài mới" Style="{StaticResource YellowButtonStyle}" 
                    Command="{Binding CreateProblemCommand}"/>
        </Grid>

        <!-- Stats Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Problems Card -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,7.5,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="Tổng số bài" Foreground="#666" FontSize="15" Margin="0,0,0,0"/>
                    <TextBlock Text="{Binding TotalProblems}" Foreground="#191970" FontSize="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Easy Card -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="3.75,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="Dễ" Foreground="#666" FontSize="15" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding EasyProblems}" Foreground="#28A745" FontSize="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Medium Card -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="3.75,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="Trung bình" Foreground="#666" FontSize="15" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding MediumProblems}" Foreground="#FFC107" FontSize="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Hard Card -->
            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="7.5,0,0,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="Khó" Foreground="#666" FontSize="15" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding HardProblems}" Foreground="#DC3545" FontSize="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Search and Filters -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search Box -->
            <TextBox Grid.Row="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Height="45" FontSize="14" Padding="12" Margin="0,0,0,15"
                     mah:TextBoxHelper.Watermark="🔍 Tìm kiếm theo mã bài, tiêu đề..."
                     mah:ControlsHelper.CornerRadius="10"/>

            <!-- Filter Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <Button Content="Tất cả" Command="{Binding FilterAllCommand}" Margin="0,0,5,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="Margin" Value="0,0,5,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                    <Setter Property="Background" Value="#191970"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#191970"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Dễ" Command="{Binding FilterEasyCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="Margin" Value="0,0,5,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterEasy}" Value="True">
                                    <Setter Property="Background" Value="#191970"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#191970"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Trung bình" Command="{Binding FilterMediumCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="Margin" Value="0,0,5,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterMedium}" Value="True">
                                    <Setter Property="Background" Value="#191970"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#191970"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Khó" Command="{Binding FilterHardCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilterHard}" Value="True">
                                    <Setter Property="Background" Value="#191970"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#191970"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Problems Table -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <DataGrid ItemsSource="{Binding Problems}" 
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeight="80"
                      Style="{StaticResource ModernDataGrid}"
                      RowStyle="{StaticResource ModernDataGridRow}"
                      CellStyle="{StaticResource ModernDataGridCell}"
                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}">

                <DataGrid.Columns>
                    <!-- Code / Title Column -->
                    <DataGridTemplateColumn Header="Mã / Tiêu đề" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Code}" Foreground="#666" FontSize="13" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding Title}" Foreground="#191970" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ShortStament}" Foreground="#666" FontSize="12" Opacity="0.7" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                         <!-- Difficulty Column -->
                    <DataGridTemplateColumn Header="Độ khó" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="12,6" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Difficulty}" Value="Dễ">
                                                    <Setter Property="Background" Value="#28A745"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Difficulty}" Value="Trung bình">
                                                    <Setter Property="Background" Value="#FFC107"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Difficulty}" Value="Khó">
                                                    <Setter Property="Background" Value="#DC3545"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Difficulty}" Foreground="White" 
                                               FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Visibility Column -->
                    <DataGridTemplateColumn Header="Hiển thị" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#E8F5E9" CornerRadius="12" Padding="12,6" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Visibility}" Foreground="#28A745" 
                                               FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Time Created Column -->
                    <DataGridTemplateColumn Header="Thời gian tạo" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}" Foreground="#666" FontSize="15"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions Column -->
                    <DataGridTemplateColumn Header="Thao tác" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button ToolTip="Chỉnh sửa"
                                            Command="{Binding DataContext.EditProblemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding ProblemId}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="10" Margin="0,0,5,0">
                                        <iconPacks:PackIconMaterial Kind="Pencil" Width="16" Height="16"/>
                                    </Button>
                                    <Button ToolTip="Xóa"
                                            Command="{Binding DataContext.DeleteProblemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding ProblemId}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Padding="10">
                                        <iconPacks:PackIconMaterial Kind="Delete" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pagination -->
        <Grid Grid.Row="4" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Run Text="Hiển thị trang " Foreground="#666" FontSize="15"/>
                <Run Text="{Binding CurrentPage}" Foreground="#191970" FontWeight="SemiBold" FontSize="15"/>
                <Run Text=" / " Foreground="#666" FontSize="15"/>
                <Run Text="{Binding TotalPages}" Foreground="#191970" FontWeight="SemiBold" FontSize="15"/>
                <Run Text=" (Tổng " Foreground="#666" FontSize="15"/>
                <Run Text="{Binding TotalProblems}" Foreground="#191970" FontWeight="SemiBold" FontSize="15"/>
                <Run Text=" bài)" Foreground="#666" FontSize="15"/>
            </TextBlock>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Command="{Binding PreviousPageCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"
                        ToolTip="Trang trước" Padding="10">
                    <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="16" Height="16"/>
                </Button>
                <Button Command="{Binding NextPageCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Trang sau" Padding="10">
                    <iconPacks:PackIconMaterial Kind="ChevronRight" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
