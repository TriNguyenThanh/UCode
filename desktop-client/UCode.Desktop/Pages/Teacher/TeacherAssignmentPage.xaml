<UserControl x:Class="UCode.Desktop.Pages.TeacherAssignmentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F8FAFC">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DataGridStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Breadcrumb -->
        <StackPanel Grid.Row="0" Margin="30,20,30,0">
            <TextBlock FontSize="15" Foreground="#666">
                <Run Text="Lớp học / Practice Session - Algorithms"/>
            </TextBlock>
        </StackPanel>

        <!-- Header -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="30,20,30,25">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Assignment.Title}" Foreground="#191970" FontSize="32" FontWeight="Bold" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="#191970" CornerRadius="12" Padding="10,5" Margin="0,0,10,0">
                            <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="13">
                                <Run Text="✓ Đã nộp: "/>
                                <Run Text="{Binding Statistics.Submitted, FallbackValue=0}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding Statistics.TotalStudents, FallbackValue=0}"/>
                            </TextBlock>
                        </Border>
                        <Border Background="#28a745" CornerRadius="12" Padding="10,5" Margin="0,0,10,0">
                            <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="13">
                                <Run Text="Đã chấm: "/>
                                <Run Text="{Binding Statistics.Graded, FallbackValue=0}"/>
                            </TextBlock>
                        </Border>
                        <Border Background="#ffc107" CornerRadius="12" Padding="10,5" Margin="0,0,10,0">
                            <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="13">
                                <Run Text="Chưa chấm: "/>
                                <Run Text="{Binding Statistics.Submitted, FallbackValue=0}"/>
                            </TextBlock>
                        </Border>
                        <Border Background="#6c757d" CornerRadius="12" Padding="10,5">
                            <TextBlock Text="{Binding EndTimeDisplay, StringFormat='Hạn: {0}'}" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Assignment.Description}" FontSize="16" Foreground="#666" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Padding="12,8"
                            Command="{Binding EditAssignmentCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Pencil" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="CHỈNH SỬA" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Statistics Cards -->
        <Grid Grid.Row="2" Margin="30,0,30,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <!--ColumnDefinition Width="*"/-->
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,7.5,0" >
                <StackPanel>
                    <TextBlock Text="Tổng SV" FontSize="13" Foreground="#666" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding Statistics.TotalStudents}" FontSize="28" FontWeight="Bold" Foreground="#191970"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="3.75,0">
                <StackPanel>
                    <TextBlock Text="Chưa làm" FontSize="13" Foreground="#666" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding Statistics.NotStarted}" FontSize="28" FontWeight="Bold" Foreground="#6c757d"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="3.75,0">
                <StackPanel>
                    <TextBlock Text="Đang làm" FontSize="13" Foreground="#666" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding Statistics.InProgress}" FontSize="28" FontWeight="Bold" Foreground="#ffc107"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="3.75,0">
                <StackPanel>
                    <TextBlock Text="Đã nộp" FontSize="13" Foreground="#666" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding Statistics.Submitted}" FontSize="28" FontWeight="Bold" Foreground="#17a2b8"/>
                </StackPanel>
            </Border>

            <!--
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Margin="7.5,0,0,0">
                <StackPanel>
                    <TextBlock Text="Đã chấm" FontSize="13" Foreground="#666" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding Statistics.Graded}" FontSize="28" FontWeight="Bold" Foreground="#28a745"/>
                </StackPanel>
            </Border>
            -->
        </Grid>

        <!-- Tabs Content -->
        <Grid Grid.Row="3" Margin="30,0,30,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab Headers -->
            <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0" Margin="0,10,0,20">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ProblemsTab" Content="DANH SÁCH BÀI" 
                            Style="{StaticResource TabButtonActive}"
                            Margin="0,0,10,0"
                            Click="ProblemsTab_Click"/>
                    <Button x:Name="SubmissionsTab" Content="BẢNG ĐIỂM" 
                            Style="{StaticResource TabButton}"
                            Click="SubmissionsTab_Click"/>
                </StackPanel>
            </Border>

            <!-- Tab Content -->
            <Grid Grid.Row="1">
                <!-- Problems Tab Content -->
                <Grid x:Name="ProblemsTabContent" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="#191970" VerticalAlignment="Center">
                            <Run Text="Danh sách bài ("/>
                            <Run Text="{Binding ProblemsCount, FallbackValue=0}"/>
                            <Run Text=" bài)"/>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource RoundedDataGridContainer}">
                        <DataGrid ItemsSource="{Binding Problems}"
                                  Style="{StaticResource ModernDataGrid}"
                                  RowStyle="{StaticResource ModernDataGridRow}"
                                  CellStyle="{StaticResource ModernDataGridCell}"
                                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding OrderIndex}" Width="80"/>
                                <DataGridTextColumn Header="Tên bài" Binding="{Binding Title}" Width="*"/>
                                <DataGridTemplateColumn Header="Độ khó" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12" Padding="8,4" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Difficulty}" Value="EASY">
                                                                <Setter Property="Background" Value="#34C759"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Difficulty}" Value="MEDIUM">
                                                                <Setter Property="Background" Value="#FF9500"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Difficulty}" Value="HARD">
                                                                <Setter Property="Background" Value="#FF3B30"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Difficulty}" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Điểm" Binding="{Binding Points}" Width="100"/>
                                <DataGridTemplateColumn Header="Bài nộp" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    ToolTip="Xem bài nộp"
                                                    Command="{Binding DataContext.ViewSubmissionsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding ProblemId}"
                                                    Padding="8"
                                                    HorizontalAlignment="Left">
                                                <iconPacks:PackIconMaterial Kind="Eye" Width="16" Height="16"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Thao tác" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource DangerButtonStyle}"
                                                    ToolTip="Xóa"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.DeleteProblemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding ProblemId}"
                                                    Padding="8">
                                                <iconPacks:PackIconMaterial Kind="Delete" Width="16" Height="16"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- Bảng điểm Tab Content -->
                <Grid x:Name="SubmissionsTabContent" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="45" FontSize="14" Padding="12" Margin="0,0,0,5"
                                 mah:TextBoxHelper.Watermark="🔍 Nhập MSSV, họ tên hoặc email..."
                                 mah:ControlsHelper.CornerRadius="10"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource RoundedDataGridContainer}">
                        <DataGrid ItemsSource="{Binding Students}"
                              Style="{StaticResource ModernDataGrid}"
                              RowStyle="{StaticResource ModernDataGridRow}"
                              CellStyle="{StaticResource ModernDataGridCell}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MSSV" Binding="{Binding StudentCode}" Width="150"/>
                            <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="2*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                            <DataGridTemplateColumn Header="Trạng thái" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="8,4" Background="{Binding StatusColor}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Điểm" Binding="{Binding ScoreDisplay}" Width="150" FontWeight="Bold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#191970"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Truy cập AI" Binding="{Binding CapturedAICount}" Width="120" FontWeight="SemiBold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#dc3545"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Chi tiết truy cập AI" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Xem chi tiết truy cập AI"
                                                Command="{Binding DataContext.ViewAIDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Padding="8"
                                                HorizontalAlignment="Left">
                                            <iconPacks:PackIconMaterial Kind="Eye" Width="16" Height="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
