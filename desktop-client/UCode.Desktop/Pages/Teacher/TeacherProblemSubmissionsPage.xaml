<UserControl x:Class="UCode.Desktop.Pages.TeacherProblemSubmissionsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Background="#F8FAFC"
        d:DesignHeight="900" d:DesignWidth="1600">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Styles/DataGridStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <local:StatusToColorConverter x:Key="StatusToColorConverter" xmlns:local="clr-namespace:UCode.Desktop.Helpers"/>
            <local:RowNumberConverter x:Key="RowNumberConverter" xmlns:local="clr-namespace:UCode.Desktop.Helpers"/>
            <local:PageStartConverter x:Key="PageStartConverter" xmlns:local="clr-namespace:UCode.Desktop.Helpers"/>
            <local:PageEndConverter x:Key="PageEndConverter" xmlns:local="clr-namespace:UCode.Desktop.Helpers"/>
            
            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"/>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.1"/>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" 
              Panel.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="True" Width="60" Height="60" Foreground="#FACB01"/>
                <TextBlock Text="Đang tải dữ liệu..." Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="30,20,30,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="16" Foreground="#666">
                                <Hyperlink Foreground="#666" Command="{Binding BackCommand}" TextDecorations="None">
                                    <Run Text="Chấm bài: "/>
                                    <Run Text="{Binding ClassData.Name}"/>
                                    <Run Text=" ("/>
                                    <Run Text="{Binding ClassData.ClassCode}"/>
                                    <Run Text=")"/>
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Text=" / " Foreground="#666" FontSize="16" Margin="5,0"/>
                            <TextBlock FontSize="16" Foreground="#666">
                                <Hyperlink Foreground="#666" Command="{Binding BackCommand}" TextDecorations="None">
                                    <Run Text="{Binding Assignment.Title}"/>
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Text=" / " Foreground="#666" FontSize="16" Margin="5,0"/>
                            <TextBlock Text="{Binding Problem.Title}" Foreground="#191970" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="Danh sách bài nộp" Foreground="#191970" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="Quay lại" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding BackCommand}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Problem Info Card -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="30,10,30,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Problem.Title}" FontSize="20" FontWeight="Bold" Foreground="#191970"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Độ khó: " FontSize="16" Foreground="#666"/>
                            <TextBlock Text="{Binding Problem.Difficulty}" FontSize="16" Foreground="#191970" FontWeight="SemiBold"/>
                            <TextBlock Text=" • " FontSize="16" Foreground="#666" Margin="10,0"/>
                            <TextBlock Text="Tổng số bài nộp: " FontSize="16" Foreground="#666"/>
                            <TextBlock Text="{Binding BestSubmissions.Count, Mode=OneWay}" FontSize="16" Foreground="#191970" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Statistics -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <StackPanel Margin="0,0,30,0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PassedCount}" FontSize="32" FontWeight="Bold" Foreground="#28a745" HorizontalAlignment="Center"/>
                            <TextBlock Text="Đạt" FontSize="13" Foreground="#666" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,30,0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PartialCount}" FontSize="32" FontWeight="Bold" Foreground="#FFC107" HorizontalAlignment="Center"/>
                            <TextBlock Text="Một phần" FontSize="13" Foreground="#666" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding FailedCount}" FontSize="32" FontWeight="Bold" Foreground="#dc3545" HorizontalAlignment="Center"/>
                            <TextBlock Text="Chưa đạt" FontSize="13" Foreground="#666" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Submissions Table -->
            <Border Grid.Row="2" Style="{StaticResource RoundedDataGridContainer}" Margin="30,10,30,30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding PaginatedSubmissions}"
                              Style="{StaticResource ModernDataGrid}"
                              CellStyle="{StaticResource ModernDataGridCell}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                              RowHeight="60"
                              AutoGenerateColumns="False"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True">
                        
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}"/>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Width="60" Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource RowNumberConverter}}"/>
                            <DataGridTextColumn Header="Sinh viên" Width="*" Binding="{Binding UserFullName}"/>
                            <DataGridTextColumn Header="MSSV" Width="120" Binding="{Binding UserStudentCode}"/>
                            
                            <DataGridTemplateColumn Header="Trạng thái" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                CornerRadius="12" Padding="8,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StatusDisplay}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Test cases" Width="120" Binding="{Binding TestCaseDisplay}"/>
                            <DataGridTextColumn Header="Thời gian" Width="100" Binding="{Binding ExecutionTimeDisplay}"/>
                            <DataGridTextColumn Header="Bộ nhớ" Width="100" Binding="{Binding MemoryUsedDisplay}"/>
                            <DataGridTextColumn Header="Ngôn ngữ" Width="100" Binding="{Binding LanguageCode}"/>
                            <DataGridTextColumn Header="Ngày nộp" Width="150" Binding="{Binding SubmittedAt, StringFormat='HH:mm dd/MM/yyyy'}"/>
                            <DataGridTextColumn Header="Điểm" Width="80" Binding="{Binding ScoreDisplay}"/>
                            
                            <DataGridTemplateColumn Header="Chi tiết" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.SubmissionClickCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Left"
                                                ToolTip="Xem chi tiết"
                                                Padding="8">
                                            <iconPacks:PackIconMaterial Kind="Eye" Width="16" Height="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination -->
                    <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="10" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Số hàng mỗi trang:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#666"/>
                                <ComboBox SelectedValue="{Binding RowsPerPage, Mode=TwoWay}" 
                                          SelectedValuePath="Tag" 
                                          Width="80" 
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="5" Tag="5"/>
                                    <ComboBoxItem Content="10" Tag="10" IsSelected="True"/>
                                    <ComboBoxItem Content="25" Tag="25"/>
                                    <ComboBoxItem Content="50" Tag="50"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Foreground="#666">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource PageStartConverter}">
                                            <Binding Path="Page"/>
                                            <Binding Path="RowsPerPage"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Text="-" Margin="3,0" Foreground="#666"/>
                                <TextBlock Foreground="#666">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource PageEndConverter}">
                                            <Binding Path="Page"/>
                                            <Binding Path="RowsPerPage"/>
                                            <Binding Path="BestSubmissions.Count"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Text=" trong " Margin="3,0" Foreground="#666"/>
                                <TextBlock Text="{Binding BestSubmissions.Count, Mode=OneWay}" Foreground="#191970" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="&lt;" Width="40" Command="{Binding ChangePageCommand}" CommandParameter="prev" Margin="0,0,5,0" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Content="&gt;" Width="40" Command="{Binding ChangePageCommand}" CommandParameter="next" Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
