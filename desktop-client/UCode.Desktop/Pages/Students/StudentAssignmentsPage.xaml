<UserControl x:Class="UCode.Desktop.Pages.Students.StudentAssignmentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:UCode.Desktop.ViewModels.Students"
             xmlns:local="clr-namespace:UCode.Desktop.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DataGridStyles.xaml"/>
                <ResourceDictionary Source="/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <local:InverseCountToVisibilityConverter x:Key="InverseCountToVisibilityConverter"/>
            <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            
            <!-- Reusing Project Converters for Consistency -->
            <local:AssignmentTypeConverter x:Key="AssignmentTypeConverter"/>
            <local:AssignmentTypeToColorConverter x:Key="AssignmentTypeToColorConverter"/>
            <local:AssignmentStatusConverter x:Key="AssignmentStatusConverter"/>
            <local:AssignmentStatusToColorConverter x:Key="AssignmentStatusToColorConverter"/>
            <local:DeadlineDisplayConverter x:Key="DeadlineDisplayConverter"/>
            <local:NullableDateTimeDisplayConverter x:Key="NullableDateTimeDisplayConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Branding Colors -->
        <Border Grid.Row="0" Background="White" Padding="32,24" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <iconPacks:PackIconMaterial Kind="BookEducation" Width="28" Height="28" Foreground="#00275E" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Danh sách bài tập" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   FontFamily="Be Vietnam Pro, Segoe UI"
                                   Foreground="#00275E"/>
                    </StackPanel>
                    <TextBlock Text="Quản lý và theo dõi tiến độ hoàn thành bài tập của bạn" 
                               FontSize="14" 
                               Foreground="#666666"
                               FontFamily="Be Vietnam Pro, Segoe UI"
                               Margin="40,0,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" 
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource YellowButton}"
                        ToolTip="Làm mới dữ liệu">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Làm mới" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="32">
            <!-- Loading State -->
            <Grid Panel.ZIndex="10" 
                  Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Background="#80F5F5F5">
                <mah:ProgressRing IsActive="True" Width="48" Height="48" Foreground="#00275E"/>
            </Grid>

            <!-- DataGrid Container -->
            <Border Style="{StaticResource RoundedDataGridContainer}">
                <DataGrid ItemsSource="{Binding Assignments}"
                          Style="{StaticResource ModernDataGrid}"
                          ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                          RowStyle="{StaticResource ModernDataGridRow}"
                          CellStyle="{StaticResource ModernDataGridCell}"
                          LoadingRow="DataGrid_LoadingRow">
                    <DataGrid.Columns>
                        <!-- STT -->
                        <DataGridTemplateColumn Header="STT" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Foreground="#666"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status Icon -->
                         <DataGridTemplateColumn Header="" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Viewbox Width="24" Height="24">
                                        <iconPacks:PackIconMaterial Kind="ClipboardTextClock" Foreground="#00275E" />
                                    </Viewbox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Tên bài tập" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,4">
                                        <TextBlock Text="{Binding Title}" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   FontFamily="Be Vietnam Pro, Segoe UI"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1a1a1a"
                                                   ToolTip="{Binding Title}"/>
                                        <TextBlock Text="{Binding Description}" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   FontFamily="Be Vietnam Pro, Segoe UI"
                                                   FontSize="12"
                                                   Foreground="#666666"
                                                   MaxWidth="400"
                                                   Margin="0,2,0,0"
                                                   ToolTip="{Binding Description}"
                                                   Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Loại" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{Binding AssignmentType, Converter={StaticResource AssignmentTypeToColorConverter}}">
                                        <TextBlock Text="{Binding AssignmentType, Converter={StaticResource AssignmentTypeConverter}}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Số câu" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E0E0E0"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="8,4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <TextBlock FontFamily="Be Vietnam Pro, Segoe UI"
                                                   FontSize="12"
                                                   Foreground="#666">
                                            <Run Text="{Binding TotalProblems, Mode=OneWay}"/>
                                            <Run Text=" bài"/>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Điểm" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E0E0E0"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="8,4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <TextBlock FontFamily="Be Vietnam Pro, Segoe UI"
                                                   FontSize="12"
                                                   Foreground="#666">
                                            <Run Text="{Binding TotalPoints, Mode=OneWay}"/>
                                            <Run Text=" đ"/>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Trạng thái" Width="120">
                             <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{Binding Status, Converter={StaticResource AssignmentStatusToColorConverter}}">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource AssignmentStatusConverter}}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Header="Hạn nộp" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <iconPacks:PackIconMaterial Kind="CalendarClock" 
                                                                  Width="14" Height="14" 
                                                                  VerticalAlignment="Center" 
                                                                  Margin="0,0,6,0"
                                                                  Foreground="#666"/>
                                        <TextBlock Text="{Binding EndTime, Converter={StaticResource NullableDateTimeDisplayConverter}}" 
                                                   VerticalAlignment="Center"
                                                   FontFamily="Be Vietnam Pro, Segoe UI"
                                                   FontSize="13"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenAssignmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource InfoActionButton}"
                                            Background="#00275E"
                                            ToolTip="Làm bài ngay">
                                        <iconPacks:PackIconMaterial Kind="ArrowRight" Width="16" Height="16"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Empty State -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding Assignments.Count, Converter={StaticResource InverseCountToVisibilityConverter}}">
                <Border Background="White" CornerRadius="100" Width="120" Height="120" Margin="0,0,0,24">
                    <Border.Effect>
                        <DropShadowEffect Color="#E0E0E0" BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
                    </Border.Effect>
                    <iconPacks:PackIconMaterial Kind="ClipboardCheckOutline" Width="64" Height="64" Foreground="#B0BEC5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="Không có bài tập nào" 
                           FontSize="20" FontWeight="Bold" Foreground="#37474F" 
                           FontFamily="Be Vietnam Pro, Segoe UI"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Hiện tại bạn chưa được giao bài tập nào." 
                           FontSize="15" Foreground="#78909C" 
                           FontFamily="Be Vietnam Pro, Segoe UI"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
