<Page x:Class="UCode.Desktop.Pages.Admin.AdminClassesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="Quản Lý Lớp Học"
      Loaded="Page_Loaded">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:Card Grid.Row="0" Margin="20,20,20,10" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Quản Lý Lớp Học" 
                               FontSize="28" 
                               FontWeight="Bold"
                               Foreground="#FF6F00"/>
                    <TextBlock Text="Quản lý lớp học, giáo viên và học sinh" 
                               FontSize="14" 
                               Foreground="#666"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding CreateClassCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" 
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,5,0"/>
                            <TextBlock Text="Tạo Lớp Học"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Download" 
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,5,0"/>
                            <TextBlock Text="Xuất File"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}">
                        <materialDesign:PackIcon Kind="Refresh"/>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Filters -->
        <materialDesign:Card Grid.Row="1" Margin="20,0,20,10" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Tìm theo tên lớp"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,10,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Teachers}"
                          SelectedValue="{Binding SelectedTeacherFilter}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="FullName"
                          materialDesign:HintAssist.Hint="Giáo Viên"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,10,0"/>

                <ComboBox Grid.Column="2"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          materialDesign:HintAssist.Hint="Trạng Thái"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,10,0">
                    <ComboBox.Items>
                        <ComboBoxItem Content="Tất Cả"/>
                        <ComboBoxItem Content="Hoạt Động" Tag="True"/>
                        <ComboBoxItem Content="Không Hoạt Động" Tag="False"/>
                    </ComboBox.Items>
                </ComboBox>

                <Button Grid.Column="3"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Magnify" 
                                                VerticalAlignment="Center"
                                                Margin="0,0,5,0"/>
                        <TextBlock Text="Tìm Kiếm"/>
                    </StackPanel>
                </Button>
            </Grid>
        </materialDesign:Card>

        <!-- Classes DataGrid -->
        <materialDesign:Card Grid.Row="2" Margin="20,0,20,10">
            <Grid>
                <DataGrid ItemsSource="{Binding Classes}"
                          SelectedItem="{Binding SelectedClass}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên Lớp" 
                                           Binding="{Binding Name}" 
                                           Width="*"/>
                        <DataGridTextColumn Header="Giáo Viên" 
                                           Binding="{Binding TeacherName}" 
                                           Width="*"/>
                        <DataGridTextColumn Header="Học Sinh" 
                                           Binding="{Binding StudentCount}" 
                                           Width="100"/>
                        <DataGridTextColumn Header="Bài Tập" 
                                           Binding="{Binding AssignmentCount}" 
                                           Width="120"/>
                        <DataGridTextColumn Header="Trạng Thái" 
                                           Binding="{Binding StatusText}" 
                                           Width="100"/>
                        <DataGridTextColumn Header="Ngày Tạo" 
                                           Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy'}" 
                                           Width="120"/>
                        <DataGridTemplateColumn Header="Thao Tác" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.ViewStatisticsCommand, 
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               Style="{StaticResource MaterialDesignFlatButton}"
                                               ToolTip="Xem Thống Kê"
                                               Margin="0,0,5,0">
                                            <materialDesign:PackIcon Kind="ChartBar"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.EditClassCommand, 
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               Style="{StaticResource MaterialDesignFlatButton}"
                                               ToolTip="Sửa"
                                               Margin="0,0,5,0">
                                            <materialDesign:PackIcon Kind="Pencil"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.ReassignTeacherCommand, 
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               Style="{StaticResource MaterialDesignFlatButton}"
                                               ToolTip="Đổi Giáo Viên"
                                               Margin="0,0,5,0">
                                            <materialDesign:PackIcon Kind="AccountSwitch"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteClassCommand, 
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               Style="{StaticResource MaterialDesignFlatButton}"
                                               ToolTip="Xóa"
                                               Foreground="#D32F2F">
                                            <materialDesign:PackIcon Kind="Delete"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Background="#80000000" 
                      Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                IsIndeterminate="True"
                                Width="50"
                                Height="50"/>
                </Grid>
            </Grid>
        </materialDesign:Card>

        <!-- Pagination -->
        <materialDesign:Card Grid.Row="3" Margin="20,0,20,20" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center">
                    <Run Text="Trang"/>
                    <Run Text="{Binding CurrentPage}" FontWeight="Bold"/>
                    <Run Text="•"/>
                    <Run Text="{Binding ClassesCount, Mode=OneWay}"/>
                    <Run Text="lớp học"/>
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding PreviousPageCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChevronLeft" 
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,5,0"/>
                            <TextBlock Text="Trước"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NextPageCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Sau"/>
                            <materialDesign:PackIcon Kind="ChevronRight" 
                                                    VerticalAlignment="Center"
                                                    Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Page>
