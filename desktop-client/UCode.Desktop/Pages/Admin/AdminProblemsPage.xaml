<Page x:Class="UCode.Desktop.Pages.Admin.AdminProblemsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="Quản Lý Bài Tập"
      Loaded="Page_Loaded">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:Card Grid.Row="0" Margin="20,20,20,10" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Quản Lý Bài Tập" 
                               FontSize="28" 
                               FontWeight="Bold"
                               Foreground="#7B1FA2"/>
                    <TextBlock Text="Quản lý ngân hàng bài tập, duyệt bài và kiểm duyệt nội dung" 
                               FontSize="14" 
                               Foreground="#666"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ExportCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Download" 
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,5,0"/>
                            <TextBlock Text="Xuất File"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}">
                        <materialDesign:PackIcon Kind="Refresh"/>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Filters -->
        <materialDesign:Card Grid.Row="1" Margin="20,0,20,10" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Tìm theo tiêu đề bài tập"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,10,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <ComboBox Grid.Column="1"
                          SelectedItem="{Binding SelectedDifficultyFilter}"
                          materialDesign:HintAssist.Hint="Độ Khó"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,10,0">
                    <ComboBox.Items>
                        <ComboBoxItem Content="Tất Cả"/>
                        <ComboBoxItem Content="Dễ"/>
                        <ComboBoxItem Content="Trung Bình"/>
                        <ComboBoxItem Content="Khó"/>
                    </ComboBox.Items>
                </ComboBox>

                <ComboBox Grid.Column="2"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          materialDesign:HintAssist.Hint="Trạng Thái"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,10,0">
                    <ComboBox.Items>
                        <ComboBoxItem Content="Tất Cả"/>
                        <ComboBoxItem Content="Bản Nháp"/>
                        <ComboBoxItem Content="Chờ Duyệt"/>
                        <ComboBoxItem Content="Đã Duyệt"/>
                        <ComboBoxItem Content="Bị Từ Chối"/>
                    </ComboBox.Items>
                </ComboBox>

                <ComboBox Grid.Column="3"
                          SelectedItem="{Binding SelectedVisibilityFilter}"
                          materialDesign:HintAssist.Hint="Hiển Thị"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,10,0">
                    <ComboBox.Items>
                        <ComboBoxItem Content="Tất Cả"/>
                        <ComboBoxItem Content="Công Khai"/>
                        <ComboBoxItem Content="Riêng Tư"/>
                        <ComboBoxItem Content="Chỉ Lớp"/>
                    </ComboBox.Items>
                </ComboBox>

                <Button Grid.Column="4"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Magnify" 
                                                VerticalAlignment="Center"
                                                Margin="0,0,5,0"/>
                        <TextBlock Text="Tìm Kiếm"/>
                    </StackPanel>
                </Button>
            </Grid>
        </materialDesign:Card>

        <!-- Problems DataGrid -->
        <materialDesign:Card Grid.Row="2" Margin="20,0,20,10">
            <Grid>
                <DataGrid ItemsSource="{Binding Problems}"
                          SelectedItem="{Binding SelectedProblem}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tiêu Đề" 
                                           Binding="{Binding Title}" 
                                           Width="2*"/>
                        <DataGridTextColumn Header="Tác Giả" 
                                           Binding="{Binding CreatedByName}" 
                                           Width="*"/>
                        <DataGridTextColumn Header="Độ Khó" 
                                           Binding="{Binding DifficultyText}" 
                                           Width="100"/>
                        <DataGridTextColumn Header="Trạng Thái" 
                                           Binding="{Binding StatusText}" 
                                           Width="100"/>
                        <DataGridTextColumn Header="Hiển Thị" 
                                           Binding="{Binding VisibilityText}" 
                                           Width="100"/>
                        <DataGridTextColumn Header="Bài Nộp" 
                                           Binding="{Binding TotalSubmissions}" 
                                           Width="110"/>
                        <DataGridTextColumn Header="Tỷ Lệ Đúng" 
                                           Binding="{Binding SuccessRateText}" 
                                           Width="110"/>
                        <DataGridTemplateColumn Header="Thao Tác" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.ApproveProblemCommand, 
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               Style="{StaticResource MaterialDesignFlatButton}"
                                               ToolTip="Duyệt"
                                               Foreground="#4CAF50"
                                               Margin="0,0,5,0">
                                            <materialDesign:PackIcon Kind="Check"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.RejectProblemCommand, 
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               Style="{StaticResource MaterialDesignFlatButton}"
                                               ToolTip="Từ Chối"
                                               Foreground="#FF9800"
                                               Margin="0,0,5,0">
                                            <materialDesign:PackIcon Kind="Close"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.ChangeVisibilityCommand, 
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               Style="{StaticResource MaterialDesignFlatButton}"
                                               ToolTip="Đổi Hiển Thị"
                                               Margin="0,0,5,0">
                                            <materialDesign:PackIcon Kind="Eye"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteProblemCommand, 
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               Style="{StaticResource MaterialDesignFlatButton}"
                                               ToolTip="Xóa"
                                               Foreground="#D32F2F">
                                            <materialDesign:PackIcon Kind="Delete"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Background="#80000000" 
                      Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                IsIndeterminate="True"
                                Width="50"
                                Height="50"/>
                </Grid>
            </Grid>
        </materialDesign:Card>

        <!-- Pagination -->
        <materialDesign:Card Grid.Row="3" Margin="20,0,20,20" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center">
                    <Run Text="Trang"/>
                    <Run Text="{Binding CurrentPage}" FontWeight="Bold"/>
                    <Run Text="•"/>
                    <Run Text="{Binding ProblemsCount, Mode=OneWay}"/>
                    <Run Text="bài tập"/>
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding PreviousPageCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChevronLeft" 
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,5,0"/>
                            <TextBlock Text="Trước"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NextPageCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Sau"/>
                            <materialDesign:PackIcon Kind="ChevronRight" 
                                                    VerticalAlignment="Center"
                                                    Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Page>
