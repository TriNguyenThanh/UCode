<UserControl x:Class="UCode.Desktop.Pages.Admin.AdminUsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
             Dialog:DialogParticipation.Register="{Binding}"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600"
             Background="#f8f9fa">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="30,25" BorderBrush="#e9ecef" BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="AccountGroup" Width="40" Height="40" 
                                               Foreground="#191970" VerticalAlignment="Center"/>
                    <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Quản lý người dùng" FontSize="24" FontWeight="Bold" Foreground="#191970"/>
                        <TextBlock Text="{Binding TotalUsers, StringFormat='Tổng số: {0} người dùng'}" 
                                   FontSize="14" Foreground="#6c757d" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2" Command="{Binding RefreshCommand}"
                        Style="{StaticResource NavyButton}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="18" Height="18" 
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Làm mới" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Search & Filters -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="30,20,30,0">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <TextBox Grid.Column="0" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         mah:TextBoxHelper.Watermark="Tìm kiếm theo tên, email..."
                         mah:TextBoxHelper.ClearTextButton="True"
                         FontSize="14" Padding="10">
                     <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Role Filter -->
                <ComboBox Grid.Column="2" Width="150"
                          ItemsSource="{Binding Roles}"
                          SelectedItem="{Binding SelectedRole}"
                          mah:TextBoxHelper.Watermark="Vai trò"
                          FontSize="14" Padding="10"/>

                <!-- Status Filter -->
                <ComboBox Grid.Column="4" Width="150"
                          ItemsSource="{Binding Statuses}"
                          SelectedItem="{Binding SelectedStatus}"
                          mah:TextBoxHelper.Watermark="Trạng thái"
                          FontSize="14" Padding="10"/>

                <!-- Search Button -->
                <Button Grid.Column="6" Command="{Binding SearchCommand}"
                        Style="{StaticResource PrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Magnify" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Tìm kiếm" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Bulk Actions -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="20" Margin="30,20,30,0">
             <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.1"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding CreateUserCommand}"
                        Style="{StaticResource SuccessButton}"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Plus" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Thêm mới" FontSize="14"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding BulkActivateCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Check" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Kích hoạt" FontSize="14"/>
                    </StackPanel>
                </Button>
                
                 <Button Command="{Binding BulkDeactivateCommand}"
                        Style="{StaticResource WarningButton}"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Pause" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Vô hiệu hóa" FontSize="14"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding BulkDeleteCommand}"
                        Style="{StaticResource DangerButton}"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Delete" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Xóa" FontSize="14"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="3" Style="{StaticResource RoundedDataGridContainer}" Margin="30,20,30,20">
            <DataGrid ItemsSource="{Binding Users}"
                      Style="{StaticResource ModernDataGrid}"
                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                      RowStyle="{StaticResource ModernDataGridRow}"
                      CellStyle="{StaticResource ModernDataGridCell}">
                <DataGrid.Columns>
                    <!-- Checkbox -->
                    <DataGridTemplateColumn Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource SelectionCheckBox}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>
                    <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="200"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220"/>

                    <!-- Role -->
                    <DataGridTemplateColumn Header="Vai trò" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusBadge}" Background="{Binding Role, Converter={StaticResource RoleToBrushConverter}}">
                                    <TextBlock Text="{Binding Role}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status -->
                    <DataGridTemplateColumn Header="Trạng thái" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusBadge}" Background="{Binding IsActive, Converter={StaticResource StatusToBrushConverter}}">
                                    <TextBlock Text="{Binding StatusDisplay}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Đăng nhập cuối" Binding="{Binding LastLoginDisplay}" Width="130"/>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="Thao tác" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- View Details -->
                                    <!--<Button Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Xem chi tiết"
                                            Background="#17a2b8" Foreground="White" BorderThickness="0"
                                            Width="35" Height="35" Cursor="Hand" Margin="0,0,5,0">
                                         <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#138496"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <iconPacks:PackIconMaterial Kind="Eye" Width="16" Height="16"/>
                                    </Button>-->

                                    <!-- Edit -->
                                    <!-- <Button Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Chỉnh sửa"
                                            Background="#ffc107" Foreground="White" BorderThickness="0"
                                            Width="35" Height="35" Cursor="Hand" Margin="0,0,5,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#e0a800"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <iconPacks:PackIconMaterial Kind="Pencil" Width="16" Height="16"/>
                                    </Button> -->

                                    <!-- Toggle Active -->
                                    <!-- <Button Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding IsActive, Converter={StaticResource BooleanToYesNoConverter}, ConverterParameter='Vô hiệu hóa|Kích hoạt'}"
                                            BorderThickness="0"
                                            Width="35" Height="35" Cursor="Hand" Margin="0,0,5,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
