<Page x:Class="UCode.Desktop.Pages.Admin.AdminUsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="Quản Lý Người Dùng"
      Loaded="Page_Loaded">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:Card Grid.Row="0" Margin="20,20,20,10" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Quản Lý Người Dùng" 
                               FontSize="28" 
                               FontWeight="Bold"
                               Foreground="#1976D2"/>
                    <TextBlock Text="Quản lý người dùng hệ thống, vai trò và quyền hạn" 
                               FontSize="14" 
                               Foreground="#666"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding CreateUserCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" 
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,5,0"/>
                            <TextBlock Text="Tạo Người Dùng"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Download" 
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,5,0"/>
                            <TextBlock Text="Xuất File"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}">
                        <materialDesign:PackIcon Kind="Refresh" 
                                                VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Filters -->
        <materialDesign:Card Grid.Row="1" Margin="20,0,20,10" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Tìm theo tên hoặc email"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,10,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Role Filter -->
                <ComboBox Grid.Column="1"
                          SelectedItem="{Binding SelectedRoleFilter}"
                          materialDesign:HintAssist.Hint="Vai Trò"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,10,0">
                    <ComboBox.ItemsSource>
                        <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                            <sys:String>Tất Cả</sys:String>
                            <sys:String>Admin</sys:String>
                            <sys:String>Giáo Viên</sys:String>
                            <sys:String>Học Sinh</sys:String>
                        </x:Array>
                    </ComboBox.ItemsSource>
                </ComboBox>

                <!-- Status Filter -->
                <ComboBox Grid.Column="2"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          materialDesign:HintAssist.Hint="Trạng Thái"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,10,0">
                    <ComboBox.Items>
                        <ComboBoxItem Content="Tất Cả"/>
                        <ComboBoxItem Content="Hoạt Động" Tag="True"/>
                        <ComboBoxItem Content="Không Hoạt Động" Tag="False"/>
                    </ComboBox.Items>
                </ComboBox>

                <Button Grid.Column="3"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Magnify" 
                                                VerticalAlignment="Center"
                                                Margin="0,0,5,0"/>
                        <TextBlock Text="Tìm Kiếm"/>
                    </StackPanel>
                </Button>
            </Grid>
        </materialDesign:Card>

        <!-- Users DataGrid -->
        <materialDesign:Card Grid.Row="2" Margin="20,0,20,10">
            <Grid>
                <DataGrid ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Họ Tên" 
                                           Binding="{Binding FullName}" 
                                           Width="*"/>
                        <DataGridTextColumn Header="Email" 
                                           Binding="{Binding Email}" 
                                           Width="*"/>
                        <DataGridTextColumn Header="Vai Trò" 
                                           Binding="{Binding RoleText}" 
                                           Width="100"/>
                        <DataGridTextColumn Header="Trạng Thái" 
                                           Binding="{Binding StatusText}" 
                                           Width="100"/>
                        <DataGridTextColumn Header="Lớp Học" 
                                           Binding="{Binding TotalClasses}" 
                                           Width="80"/>
                        <DataGridTextColumn Header="Bài Nộp" 
                                           Binding="{Binding TotalSubmissions}" 
                                           Width="100"/>
                        <DataGridTextColumn Header="Đăng Nhập Cuối" 
                                           Binding="{Binding LastLoginText}" 
                                           Width="150"/>
                        <DataGridTemplateColumn Header="Thao Tác" Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.EditUserCommand, 
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               Style="{StaticResource MaterialDesignFlatButton}"
                                               ToolTip="Sửa"
                                               Margin="0,0,5,0">
                                            <materialDesign:PackIcon Kind="Pencil"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.ResetPasswordCommand, 
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               Style="{StaticResource MaterialDesignFlatButton}"
                                               ToolTip="Đặt Lại Mật Khẩu"
                                               Margin="0,0,5,0">
                                            <materialDesign:PackIcon Kind="Key"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteUserCommand, 
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               Style="{StaticResource MaterialDesignFlatButton}"
                                               ToolTip="Xóa"
                                               Foreground="#D32F2F">
                                            <materialDesign:PackIcon Kind="Delete"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Loading Overlay -->
                <Grid Background="#80000000" 
                      Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                IsIndeterminate="True"
                                Width="50"
                                Height="50"/>
                </Grid>
            </Grid>
        </materialDesign:Card>

        <!-- Pagination -->
        <materialDesign:Card Grid.Row="3" Margin="20,0,20,20" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center">
                    <Run Text="Trang"/>
                    <Run Text="{Binding CurrentPage}" FontWeight="Bold"/>
                    <Run Text="•"/>
                    <Run Text="{Binding UsersCount, Mode=OneWay}"/>
                    <Run Text="người dùng"/>
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding PreviousPageCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChevronLeft" 
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,5,0"/>
                            <TextBlock Text="Trước"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NextPageCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Sau"/>
                            <materialDesign:PackIcon Kind="ChevronRight" 
                                                    VerticalAlignment="Center"
                                                    Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Page>
