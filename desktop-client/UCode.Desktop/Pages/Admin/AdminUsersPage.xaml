<UserControl x:Class="UCode.Desktop.Pages.Admin.AdminUsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
             Dialog:DialogParticipation.Register="{Binding}"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600"
             Background="#F5F5F5">

    <Grid>
        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" 
              Panel.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#DC143C"/>
                <TextBlock Text="Đang tải..." Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Quản lý người dùng" FontSize="28" FontWeight="Bold" Foreground="#191970"/>
                <TextBlock FontSize="14" Foreground="#666" Margin="0,5,0,0">
                    <Run Text="Tổng số:"/>
                    <Run Text="{Binding TotalUsers}" FontWeight="Bold"/>
                    <Run Text="người dùng"/>
                </TextBlock>
            </StackPanel>

            <!-- Filters & Actions -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.1"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search & Filters Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <TextBox Grid.Column="0" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14" Padding="12,10" Margin="0,0,10,0"
                                 BorderBrush="#ddd" BorderThickness="1">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <iconPacks:PackIconMaterial Kind="Magnify" Width="18" Height="18" 
                                                                                   Foreground="#999" Margin="12,0,8,0" 
                                                                                   VerticalAlignment="Center"/>
                                                        <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" 
                                                                     VerticalAlignment="Center" Margin="0,10,12,10"/>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Role Filter -->
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Roles}" 
                                  SelectedItem="{Binding SelectedRole}"
                                  FontSize="14" Padding="10" Margin="5,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="14"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Status Filter -->
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Statuses}" 
                                  SelectedItem="{Binding SelectedStatus}"
                                  FontSize="14" Padding="10" Margin="5,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="14"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Refresh Button -->
                        <Button Grid.Column="3" Command="{Binding RefreshCommand}" 
                                Background="#f8f9fa" BorderBrush="#ddd" BorderThickness="1"
                                Padding="15,10" Margin="10,0,0,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Refresh" Width="18" Height="18" 
                                                           Foreground="#666" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Action Buttons Row -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Command="{Binding CreateUserCommand}" 
                                Background="#DC143C" Foreground="White" BorderThickness="0"
                                Padding="20,12" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#B8112D"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Plus" Width="18" Height="18" 
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Thêm người dùng" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding BulkActivateCommand}" 
                                Background="#28a745" Foreground="White" BorderThickness="0"
                                Padding="15,12" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#218838"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                            <Setter Property="Cursor" Value="Arrow"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Check" Width="16" Height="16" 
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Kích hoạt" FontSize="14"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding BulkDeactivateCommand}" 
                                Background="#ffc107" Foreground="White" BorderThickness="0"
                                Padding="15,12" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#e0a800"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                            <Setter Property="Cursor" Value="Arrow"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Pause" Width="16" Height="16" 
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Vô hiệu hóa" FontSize="14"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding BulkDeleteCommand}" 
                                Background="#dc3545" Foreground="White" BorderThickness="0"
                                Padding="15,12" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#c82333"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                            <Setter Property="Cursor" Value="Arrow"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Delete" Width="16" Height="16" 
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Xóa" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Users DataGrid -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.1"/>
                </Border.Effect>
                <DataGrid ItemsSource="{Binding Users}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          RowHeight="60"
                          BorderThickness="0"
                          Background="White"
                          EnableRowVirtualization="False"
                          VirtualizingPanel.IsVirtualizing="False">
                    
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#f8f9fa"/>
                            <Setter Property="Foreground" Value="#191970"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Padding" Value="15,12"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#e9ecef"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#f1f1f1"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#f8f9fa"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="15,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <!-- Checkbox -->
                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Username -->
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>

                        <!-- Full Name -->
                        <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="200"/>

                        <!-- Email -->
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220"/>

                        <!-- Role -->
                        <DataGridTemplateColumn Header="Vai trò" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Role, Converter={StaticResource RoleToBrushConverter}}"
                                            CornerRadius="12" Padding="10,4" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Role}" Foreground="White" 
                                                   FontSize="12" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status -->
                        <DataGridTemplateColumn Header="Trạng thái" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsActive, Converter={StaticResource StatusToBrushConverter}}"
                                            CornerRadius="12" Padding="10,4" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding StatusDisplay}" Foreground="White" 
                                                   FontSize="12" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Last Login -->
                        <DataGridTextColumn Header="Đăng nhập cuối" Binding="{Binding LastLoginDisplay}" Width="150"/>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Thao tác" Width="*" MinWidth="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.ViewDetailsCommand, 
                                                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="Xem chi tiết"
                                               Background="#17a2b8" Foreground="White" BorderThickness="0"
                                               Width="36" Height="36" Margin="2" Cursor="Hand">
                                            <iconPacks:PackIconMaterial Kind="Eye" Width="18" Height="18"/>
                                        </Button>

                                        <Button Command="{Binding DataContext.EditUserCommand, 
                                                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="Chỉnh sửa"
                                               Background="#ffc107" Foreground="White" BorderThickness="0"
                                               Width="36" Height="36" Margin="2" Cursor="Hand">
                                            <iconPacks:PackIconMaterial Kind="Pencil" Width="18" Height="18"/>
                                        </Button>

                                        <Button Command="{Binding DataContext.ResetPasswordCommand, 
                                                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="Đặt lại mật khẩu"
                                               Background="#6c757d" Foreground="White" BorderThickness="0"
                                               Width="36" Height="36" Margin="2" Cursor="Hand">
                                            <iconPacks:PackIconMaterial Kind="LockReset" Width="18" Height="18"/>
                                        </Button>

                                        <Button Command="{Binding DataContext.ToggleActiveCommand, 
                                                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="Kích hoạt/Vô hiệu hóa"
                                               Background="#28a745" Foreground="White" BorderThickness="0"
                                               Width="36" Height="36" Margin="2" Cursor="Hand">
                                            <iconPacks:PackIconMaterial Kind="Power" Width="18" Height="18"/>
                                        </Button>

                                        <Button Command="{Binding DataContext.DeleteUserCommand, 
                                                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="Xóa"
                                               Background="#dc3545" Foreground="White" BorderThickness="0"
                                               Width="36" Height="36" Margin="2" Cursor="Hand">
                                            <iconPacks:PackIconMaterial Kind="Delete" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Pagination -->
            <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="20" Margin="0,20,0,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.1"/>
                </Border.Effect>
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="Hiển thị " FontSize="14" Foreground="#666" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Users.Count}" FontSize="14" FontWeight="Bold" 
                                   Foreground="#191970" VerticalAlignment="Center"/>
                        <TextBlock Text=" / " FontSize="14" Foreground="#666" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalUsers}" FontSize="14" FontWeight="Bold" 
                                   Foreground="#191970" VerticalAlignment="Center"/>
                        <TextBlock Text=" người dùng" FontSize="14" Foreground="#666" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Command="{Binding PreviousPageCommand}" 
                                Background="#f8f9fa" BorderBrush="#ddd" BorderThickness="1"
                                Padding="15,10" Margin="0,0,10,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="18" Height="18" 
                                                           Foreground="#191970" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Trước" FontSize="14" Foreground="#191970" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Background="#f8f9fa" BorderBrush="#ddd" BorderThickness="1" 
                                CornerRadius="6" Padding="15,10">
                            <TextBlock FontSize="14" Foreground="#191970">
                                <Run Text="Trang"/>
                                <Run Text="{Binding CurrentPage}" FontWeight="Bold"/>
                                <Run Text="/"/>
                                <Run Text="{Binding TotalPages}" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>

                        <Button Command="{Binding NextPageCommand}" 
                                Background="#f8f9fa" BorderBrush="#ddd" BorderThickness="1"
                                Padding="15,10" Margin="10,0,0,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Sau" FontSize="14" Foreground="#191970" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <iconPacks:PackIconMaterial Kind="ChevronRight" Width="18" Height="18" 
                                                           Foreground="#191970" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
