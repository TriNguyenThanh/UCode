<UserControl x:Class="UCode.Desktop.Pages.Admin.AdminHomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
             Dialog:DialogParticipation.Register="{Binding}"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600"
             Background="#F5F5F5">

    <Grid>
        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" 
              Panel.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#DC143C"/>
                <TextBlock Text="Đang tải dữ liệu..." Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Border Grid.Row="0" Background="White" Padding="40,30">
                <Grid>
                    <StackPanel>
                        <TextBlock FontSize="32" FontWeight="Bold" Foreground="#DC143C" Margin="0,0,0,5">
                            <Run Text="Admin Dashboard 🔐"/>
                        </TextBlock>
                        <TextBlock Text="Quản lý toàn bộ hệ thống UCode" 
                                   Foreground="#666" FontSize="16"/>
                    </StackPanel>
                    <Button Command="{Binding RefreshCommand}" 
                            Background="#DC143C" 
                            Foreground="White"
                            BorderThickness="0"
                            Padding="20,12"
                            Cursor="Hand"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Làm mới" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#B8112D"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,30,40,40">

                    <!-- Quick Stats Row 1 -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total Users Card -->
                        <Border Grid.Column="0" Background="#DC143C" CornerRadius="8" Padding="25" Margin="0,0,12,0" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToUsersCommand}"/>
                            </Border.InputBindings>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.2"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="Tổng người dùng" FontSize="16" FontWeight="SemiBold" 
                                               Foreground="White" HorizontalAlignment="Left"/>
                                    <iconPacks:PackIconMaterial Kind="AccountGroup" Width="32" Height="32" 
                                                               Foreground="White" Opacity="0.8" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding TotalUsers}" FontSize="56" FontWeight="Bold" 
                                           Foreground="White" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="TrendingUp" Width="16" Height="16" 
                                                               Foreground="White" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding NewUsersThisWeek, StringFormat='+{0} tuần này'}" 
                                               FontSize="14" Foreground="White" Opacity="0.9"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Total Students Card -->
                        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="25" Margin="6,0" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToUsersCommand}"/>
                            </Border.InputBindings>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.1"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="Sinh viên" FontSize="16" FontWeight="SemiBold" 
                                               Foreground="#666" HorizontalAlignment="Left"/>
                                    <iconPacks:PackIconMaterial Kind="School" Width="32" Height="32" 
                                                               Foreground="#17a2b8" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding TotalStudents}" FontSize="56" FontWeight="Bold" 
                                           Foreground="#17a2b8" Margin="0,0,0,5"/>
                                <TextBlock Text="Đang hoạt động" FontSize="14" Foreground="#666"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Teachers Card -->
                        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="25" Margin="6,0" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToUsersCommand}"/>
                            </Border.InputBindings>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.1"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="Giáo viên" FontSize="16" FontWeight="SemiBold" 
                                               Foreground="#666" HorizontalAlignment="Left"/>
                                    <iconPacks:PackIconMaterial Kind="AccountTie" Width="32" Height="32" 
                                                               Foreground="#28a745" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding TotalTeachers}" FontSize="56" FontWeight="Bold" 
                                           Foreground="#28a745" Margin="0,0,0,5"/>
                                <TextBlock Text="Đang giảng dạy" FontSize="14" Foreground="#666"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Classes Card -->
                        <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="25" Margin="12,0,0,0" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToClassesCommand}"/>
                            </Border.InputBindings>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.1"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="Lớp học" FontSize="16" FontWeight="SemiBold" 
                                               Foreground="#666" HorizontalAlignment="Left"/>
                                    <iconPacks:PackIconMaterial Kind="GoogleClassroom" Width="32" Height="32" 
                                                               Foreground="#ffc107" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding TotalClasses}" FontSize="56" FontWeight="Bold" 
                                           Foreground="#ffc107" Margin="0,0,0,5"/>
                                <TextBlock FontSize="14" Foreground="#666">
                                    <Run Text="{Binding TotalActiveClasses, Mode=OneWay}"/>
                                    <Run Text=" đang hoạt động"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Quick Stats Row 2 -->
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Active Users Card -->
                        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="25" Margin="0,0,12,0">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.1"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="Người dùng hoạt động" FontSize="14" FontWeight="SemiBold" 
                                               Foreground="#666" HorizontalAlignment="Left"/>
                                    <iconPacks:PackIconMaterial Kind="AccountCheck" Width="28" Height="28" 
                                                               Foreground="#28a745" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding ActiveUsers}" FontSize="42" FontWeight="Bold" 
                                           Foreground="#28a745" Margin="0,0,0,5"/>
                                <TextBlock FontSize="13" Foreground="#999">
                                    <Run Text="{Binding InactiveUsers, Mode=OneWay}"/>
                                    <Run Text=" không hoạt động"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Archived Classes Card -->
                        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="25" Margin="6,0">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.1"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="Lớp đã archive" FontSize="14" FontWeight="SemiBold" 
                                               Foreground="#666" HorizontalAlignment="Left"/>
                                    <iconPacks:PackIconMaterial Kind="Archive" Width="28" Height="28" 
                                                               Foreground="#6c757d" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding TotalArchivedClasses}" FontSize="42" FontWeight="Bold" 
                                           Foreground="#6c757d" Margin="0,0,0,5"/>
                                <TextBlock Text="Đã lưu trữ" FontSize="13" Foreground="#999"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Problems Card -->
                        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="25" Margin="6,0" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToProblemsCommand}"/>
                            </Border.InputBindings>
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.1"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="Bài tập" FontSize="14" FontWeight="SemiBold" 
                                               Foreground="#666" HorizontalAlignment="Left"/>
                                    <iconPacks:PackIconMaterial Kind="CodeBraces" Width="28" Height="28" 
                                                               Foreground="#007bff" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding TotalProblems}" FontSize="42" FontWeight="Bold" 
                                           Foreground="#007bff" Margin="0,0,0,5"/>
                                <TextBlock Text="Trong hệ thống" FontSize="13" Foreground="#999"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Submissions Card -->
                        <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="25" Margin="12,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.1"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="Bài nộp" FontSize="14" FontWeight="SemiBold" 
                                               Foreground="#666" HorizontalAlignment="Left"/>
                                    <iconPacks:PackIconMaterial Kind="SendCheck" Width="28" Height="28" 
                                                               Foreground="#6f42c1" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding TotalSubmissions}" FontSize="42" FontWeight="Bold" 
                                           Foreground="#6f42c1" Margin="0,0,0,5"/>
                                <TextBlock Text="Tổng số lần nộp" FontSize="13" Foreground="#999"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Quick Actions Section -->
                    <Border Background="White" CornerRadius="8" Padding="30" Margin="0,0,0,30">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Quản lý nhanh" FontSize="20" FontWeight="Bold" 
                                       Foreground="#191970" Margin="0,0,0,20"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Users Management Button -->
                                <Button Grid.Column="0" Command="{Binding NavigateToUsersCommand}" 
                                        Background="#f8f9fa" BorderThickness="0" Padding="20" 
                                        Margin="0,0,12,0" Cursor="Hand" Height="100">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="#e9ecef" BorderThickness="1"
                                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#e9ecef"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel>
                                        <iconPacks:PackIconMaterial Kind="AccountGroup" Width="36" Height="36" 
                                                                   Foreground="#DC143C" Margin="0,0,0,10"/>
                                        <TextBlock Text="Quản lý người dùng" FontSize="14" FontWeight="SemiBold" 
                                                   Foreground="#191970" TextAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Classes Management Button -->
                                <Button Grid.Column="1" Command="{Binding NavigateToClassesCommand}" 
                                        Background="#f8f9fa" BorderThickness="0" Padding="20" 
                                        Margin="6,0" Cursor="Hand" Height="100">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="#e9ecef" BorderThickness="1"
                                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#e9ecef"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel>
                                        <iconPacks:PackIconMaterial Kind="GoogleClassroom" Width="36" Height="36" 
                                                                   Foreground="#ffc107" Margin="0,0,0,10"/>
                                        <TextBlock Text="Quản lý lớp học" FontSize="14" FontWeight="SemiBold" 
                                                   Foreground="#191970" TextAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- System Logs Button -->
                                <Button Grid.Column="2" Command="{Binding NavigateToLogsCommand}" 
                                        Background="#f8f9fa" BorderThickness="0" Padding="20" 
                                        Margin="6,0" Cursor="Hand" Height="100">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="#e9ecef" BorderThickness="1"
                                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#e9ecef"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel>
                                        <iconPacks:PackIconMaterial Kind="FileDocumentOutline" Width="36" Height="36" 
                                                                   Foreground="#17a2b8" Margin="0,0,0,10"/>
                                        <TextBlock Text="Nhật ký hệ thống" FontSize="14" FontWeight="SemiBold" 
                                                   Foreground="#191970" TextAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Settings Button -->
                                <Button Grid.Column="3" Command="{Binding NavigateToSettingsCommand}" 
                                        Background="#f8f9fa" BorderThickness="0" Padding="20" 
                                        Margin="12,0,0,0" Cursor="Hand" Height="100">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="#e9ecef" BorderThickness="1"
                                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#e9ecef"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel>
                                        <iconPacks:PackIconMaterial Kind="Cog" Width="36" Height="36" 
                                                                   Foreground="#6c757d" Margin="0,0,0,10"/>
                                        <TextBlock Text="Cài đặt hệ thống" FontSize="14" FontWeight="SemiBold" 
                                                   Foreground="#191970" TextAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Recent Activities Section (Placeholder) -->
                    <Border Background="White" CornerRadius="8" Padding="30">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Hoạt động gần đây" FontSize="20" FontWeight="Bold" 
                                       Foreground="#191970" Margin="0,0,0,20"/>
                            <TextBlock Text="Sẽ hiển thị các hoạt động gần đây của hệ thống..." 
                                       FontSize="14" Foreground="#999" TextAlignment="Center" Padding="40"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
