<UserControl x:Class="UCode.Desktop.Pages.CreateAttendanceSessionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F5F5F5">

    <Grid>
        <!-- Loading Overlay -->
        <Grid Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" 
              Panel.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="True" Width="60" Height="60" Foreground="#FACB01"/>
                <TextBlock Text="Đang tạo phiên điểm danh..." Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40">
                <!-- Header -->
                <Grid Margin="0,0,0,30">
                    <StackPanel>
                        <TextBlock Text="Tạo phiên điểm danh mới" FontSize="28" FontWeight="Bold" Foreground="#191970" Margin="0,0,0,5"/>
                        <TextBlock Text="Cấu hình phiên điểm danh với kiểm tra IP và GPS" 
                                   FontSize="16" Foreground="#666"/>
                    </StackPanel>
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding BackCommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="12,10"
                            ToolTip="Quay lại">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Quay lại" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Form -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <!-- Basic Info Section -->
                        <TextBlock Text="THÔNG TIN CƠ BẢN" FontSize="18" FontWeight="Bold" Foreground="#191970" Margin="0,0,0,20"/>

                        <!-- Title -->
                        <TextBlock Text="Tiêu đề phiên điểm danh *" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                 Height="45" FontSize="14" Padding="12" Margin="0,0,0,5"
                                 mah:TextBoxHelper.Watermark="VD: Điểm danh tuần 1"/>
                        <TextBlock Text="Tên hiển thị của phiên điểm danh" 
                                   FontSize="12" Foreground="#999" Margin="0,0,0,20"/>

                        <!-- Session Code cái này tự gen ở db
                        <TextBlock Text="Mã phiên *" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding SessionCode, UpdateSourceTrigger=PropertyChanged}"
                                 Height="45" FontSize="14" Padding="12" Margin="0,0,0,5"
                                 mah:TextBoxHelper.Watermark="VD: WEEK01"/>
                        <TextBlock Text="Mã định danh duy nhất cho phiên điểm danh" 
                                   FontSize="12" Foreground="#999" Margin="0,0,0,20"/> -->

                        <!-- Time Range -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Thời gian bắt đầu *" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,8"/>
                                <mah:DateTimePicker SelectedDateTime="{Binding StartTime}"
                                                    Height="45" FontSize="14"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Thời gian kết thúc *" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,8"/>
                                <mah:DateTimePicker SelectedDateTime="{Binding EndTime}"
                                                    Height="45" FontSize="14"/>
                            </StackPanel>
                        </Grid>

                        <!-- Active Status -->
                        <CheckBox IsChecked="{Binding IsActive}" Margin="0,0,0,30">
                            <TextBlock Text="Kích hoạt ngay sau khi tạo" FontSize="14" FontWeight="SemiBold"/>
                        </CheckBox>

                        <!-- Separator -->
                        <Border Height="1" Background="#E0E0E0" Margin="0,10,0,30"/>

                        <!-- IP Check Section -->
                        <TextBlock Text="KIỂM TRA ĐỊA CHỈ IP" FontSize="18" FontWeight="Bold" Foreground="#191970" Margin="0,0,0,20"/>

                        <CheckBox IsChecked="{Binding RequireIpCheck}" Margin="0,0,0,15">
                            <TextBlock Text="Yêu cầu kiểm tra địa chỉ IP" FontSize="14" FontWeight="SemiBold"/>
                        </CheckBox>

                        <StackPanel Visibility="{Binding RequireIpCheck, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="0,0,0,30">
                            <TextBlock Text="Dải IP cho phép" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding AllowedIpSubnet, UpdateSourceTrigger=PropertyChanged}"
                                     Height="45" FontSize="14" Padding="12" Margin="0,0,0,5"
                                     mah:TextBoxHelper.Watermark="VD: 192.168.1.0/24"/>
                            <TextBlock Text="Chỉ sinh viên trong dải IP này mới được điểm danh" 
                                       FontSize="12" Foreground="#999"/>
                        </StackPanel>

                        <!-- Separator -->
                        <Border Height="1" Background="#E0E0E0" Margin="0,0,0,30"/>

                        <!-- GPS Check Section -->
                        <TextBlock Text="KIỂM TRA VỊ TRÍ GPS" FontSize="18" FontWeight="Bold" Foreground="#191970" Margin="0,0,0,20"/>

                        <CheckBox IsChecked="{Binding RequireGpsCheck}" Margin="0,0,0,15">
                            <TextBlock Text="Yêu cầu kiểm tra vị trí GPS" FontSize="14" FontWeight="SemiBold"/>
                        </CheckBox>

                        <StackPanel Visibility="{Binding RequireGpsCheck, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Vĩ độ (Latitude)" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding AllowedLatitude, UpdateSourceTrigger=PropertyChanged}"
                                             Height="45" FontSize="14" Padding="12"
                                             mah:TextBoxHelper.Watermark="VD: 10.762622"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Kinh độ (Longitude)" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding AllowedLongitude, UpdateSourceTrigger=PropertyChanged}"
                                             Height="45" FontSize="14" Padding="12"
                                             mah:TextBoxHelper.Watermark="VD: 106.660172"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Bán kính cho phép (mét)" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding AllowedRadiusMeters, UpdateSourceTrigger=PropertyChanged}"
                                     Height="45" FontSize="14" Padding="12" Margin="0,0,0,5"
                                     mah:TextBoxHelper.Watermark="VD: 100"/>
                            <TextBlock Text="Sinh viên phải ở trong bán kính này để điểm danh" 
                                       FontSize="12" Foreground="#999" Margin="0,0,0,15"/>

                            <!-- Open Google Maps Button -->
                            <Button Content="🗺️ Mở Google Maps để lấy tọa độ"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding GetLocationCommand}"
                                    Height="40" Margin="0,0,0,20"/>
                        </StackPanel>

                        <!-- Info Box -->
                        <Border Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="1" 
                                CornerRadius="6" Padding="15" Margin="0,10,0,20">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💡" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                <TextBlock FontSize="13" Foreground="#0D47A1" TextWrapping="Wrap">
                                    <Run Text="Cách lấy tọa độ từ Google Maps:" FontWeight="SemiBold"/>
                                    <LineBreak/>
                                    <Run Text="1. Click nút 'Mở Google Maps' ở trên"/>
                                    <LineBreak/>
                                    <Run Text="2. Click chuột phải vào vị trí bạn muốn trên bản đồ"/>
                                    <LineBreak/>
                                    <Run Text="3. Click vào tọa độ đầu tiên (dạng: 10.762622, 106.660172)"/>
                                    <LineBreak/>
                                    <Run Text="4. Tọa độ sẽ được copy, paste vào ô Vĩ độ và Kinh độ"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="HỦY" 
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CancelCommand}"
                                    Width="120" Margin="0,0,15,0"/>
                            <Button Content="✓ TẠO PHIÊN ĐIỂM DANH" 
                                    Style="{StaticResource YellowButton}"
                                    Command="{Binding CreateCommand}"
                                    Width="200"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
