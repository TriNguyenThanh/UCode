<UserControl x:Class="UCode.Desktop.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:UCode.Desktop.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1600"
             Background="#F5F5F5">

    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30,40,40" MaxWidth="800" HorizontalAlignment="Center">
                <!-- Header -->
                <TextBlock Text="Cài đặt"
                           FontSize="32"
                           FontWeight="Bold"
                           Margin="0,0,0,30"/>

                <!-- Personal Information Section -->
                <Border Background="White"
                        CornerRadius="12"
                        Padding="32"
                        Margin="0, 0, 0, 30" Width="800" >
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Section Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <iconPacks:PackIconMaterial Kind="Account"
                                                        Width="20"
                                                        Height="20"
                                                        Foreground="#FACB01"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,10,0"/>
                            <TextBlock Text="Thông tin cá nhân"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="#333"/>
                        </StackPanel>

                        <!-- Full Name -->
                        <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                            <Grid>
                                <TextBlock Text="Họ và tên *"
                                           FontSize="12"
                                           Foreground="#999"
                                           Margin="12,8,12,0"
                                           VerticalAlignment="Top"/>
                                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="15"
                                         Padding="12,24,12,8"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#333"/>
                            </Grid>
                        </Border>

                        <!-- Email -->
                        <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                            <Grid>
                                <TextBlock Text="Email *"
                                           FontSize="12"
                                           Foreground="#999"
                                           Margin="12,8,12,0"
                                           VerticalAlignment="Top"/>
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="15"
                                         Padding="12,24,12,8"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#333"/>
                            </Grid>
                        </Border>

                        <!-- Phone -->
                        <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
                            <Grid>
                                <TextBlock Text="Số điện thoại"
                                           FontSize="12"
                                           Foreground="#999"
                                           Margin="12,8,12,0"
                                           VerticalAlignment="Top"/>
                                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="15"
                                         Padding="12,24,12,8"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#333"/>
                            </Grid>
                        </Border>

                        <!-- Student Fields -->
                        <StackPanel Visibility="{Binding IsStudent, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- Major -->
                            <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                                <Grid>
                                    <TextBlock Text="Chuyên ngành"
                                               FontSize="12"
                                               Foreground="#999"
                                               Margin="12,8,12,0"
                                               VerticalAlignment="Top"/>
                                    <TextBox Text="{Binding Major, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="15"
                                             Padding="12,24,12,8"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="#333"/>
                                </Grid>
                            </Border>

                            <!-- Class Year -->
                            <!-- <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                                <Grid>
                                    <TextBlock Text="Năm học"
                                               FontSize="12"
                                               Foreground="#999"
                                               Margin="12,8,12,0"
                                               VerticalAlignment="Top"/>
                                    <TextBox Text="{Binding ClassYear, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="15"
                                             Padding="12,24,12,8"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="#333"/>
                                </Grid>
                            </Border> -->
                        </StackPanel>

                        <!-- Teacher Fields -->
                        <StackPanel Visibility="{Binding IsTeacher, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- Department -->
                            <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                                <Grid>
                                    <TextBlock Text="Khoa"
                                               FontSize="12"
                                               Foreground="#999"
                                               Margin="12,8,12,0"
                                               VerticalAlignment="Top"/>
                                    <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="15"
                                             Padding="12,24,12,8"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="#333"/>
                                </Grid>
                            </Border>

                            <!-- Title -->
                            <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                                <Grid>
                                    <TextBlock Text="Chức danh"
                                               FontSize="12"
                                               Foreground="#999"
                                               Margin="12,8,12,0"
                                               VerticalAlignment="Top"/>
                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="15"
                                             Padding="12,24,12,8"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="#333"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Save Button -->
                        <Button Command="{Binding UpdateProfileCommand}"
                                Background="#FACB01"
                                Foreground="#00275E"
                                FontSize="13"
                                FontWeight="Bold"
                                Height="42"
                                Cursor="Hand"
                                BorderThickness="0"
                                HorizontalAlignment="Left"
                                Padding="24,0"
                                mah:ControlsHelper.CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ContentSave"
                                                            Width="16"
                                                            Height="16"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0"/>
                                <TextBlock Text="LƯU THAY ĐỔI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Change Password Section -->
                <Border Background="White"
                        CornerRadius="12"
                        Padding="32">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Section Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <iconPacks:PackIconMaterial Kind="Lock"
                                                        Width="20"
                                                        Height="20"
                                                        Foreground="#FACB01"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,10,0"/>
                            <TextBlock Text="Đổi mật khẩu"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="#333"/>
                        </StackPanel>

                        <!-- Current Password -->
                        <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,4">
                            <Grid>
                                <TextBlock Text="Mật khẩu hiện tại *"
                                           FontSize="12"
                                           Foreground="#999"
                                           Margin="12,8,12,0"
                                           VerticalAlignment="Top"/>
                                <PasswordBox x:Name="CurrentPasswordBox"
                                             FontSize="15"
                                             Padding="12,24,12,8"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             PasswordChanged="CurrentPasswordBox_PasswordChanged"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding CurrentPasswordError}"
                                   FontSize="11"
                                   Foreground="Red"
                                   Margin="0,4,0,16"
                                   Visibility="{Binding CurrentPasswordError, Converter={StaticResource StringToVisibilityConverter}}"/>
                        <TextBlock Text="Nhập mật khẩu hiện tại của bạn"
                                   FontSize="11"
                                   Foreground="#999"
                                   Margin="0,4,0,16"
                                   Visibility="{Binding CurrentPasswordError, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}"/>

                        <!-- New Password -->
                        <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,4">
                            <Grid>
                                <TextBlock Text="Mật khẩu mới *"
                                           FontSize="12"
                                           Foreground="#999"
                                           Margin="12,8,12,0"
                                           VerticalAlignment="Top"/>
                                <PasswordBox x:Name="NewPasswordBox"
                                             FontSize="15"
                                             Padding="12,24,12,8"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             PasswordChanged="NewPasswordBox_PasswordChanged"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding NewPasswordError}"
                                   FontSize="11"
                                   Foreground="Red"
                                   Margin="0,4,0,16"
                                   Visibility="{Binding NewPasswordError, Converter={StaticResource StringToVisibilityConverter}}"/>
                        <TextBlock Text="Tối thiểu 6 ký tự"
                                   FontSize="11"
                                   Foreground="#999"
                                   Margin="0,4,0,16"
                                   Visibility="{Binding NewPasswordError, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}"/>

                        <!-- Confirm Password -->
                        <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,4">
                            <Grid>
                                <TextBlock Text="Xác nhận mật khẩu mới *"
                                           FontSize="12"
                                           Foreground="#999"
                                           Margin="12,8,12,0"
                                           VerticalAlignment="Top"/>
                                <PasswordBox x:Name="ConfirmPasswordBox"
                                             FontSize="15"
                                             Padding="12,24,12,8"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding ConfirmPasswordError}"
                                   FontSize="11"
                                   Foreground="Red"
                                   Margin="0,4,0,20"
                                   Visibility="{Binding ConfirmPasswordError, Converter={StaticResource StringToVisibilityConverter}}"/>
                        <TextBlock Text="Nhập lại mật khẩu mới"
                                   FontSize="11"
                                   Foreground="#999"
                                   Margin="0,4,0,20"
                                   Visibility="{Binding ConfirmPasswordError, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}"/>

                        <!-- Change Password Button -->
                        <Button Command="{Binding ChangePasswordCommand}"
                                FontSize="13"
                                FontWeight="Bold"
                                Height="42"
                                Cursor="Hand"
                                BorderThickness="0"
                                HorizontalAlignment="Left"
                                Padding="24,0"
                                mah:ControlsHelper.CornerRadius="8">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="#E5E5E5"/>
                                    <Setter Property="Foreground" Value="#666"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPasswordValid}" Value="True">
                                            <Setter Property="Background" Value="#FACB01"/>
                                            <Setter Property="Foreground" Value="#00275E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="LockReset"
                                                            Width="16"
                                                            Height="16"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0"/>
                                <TextBlock Text="ĐỔI MẬT KHẨU" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border Background="#DD000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="True"
                                  Width="80"
                                  Height="80"
                                  Foreground="Yellow"
                                  Margin="0,0,0,20"/>
                <TextBlock Text="Đang xử lý..."
                           FontSize="18"
                           Foreground="Yellow"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
