<mah:MetroWindow x:Class="UCode.Desktop.Controls.PdfUploadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Insert PDF" 
        Height="400" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowMinButton="False"
        ShowMaxRestoreButton="False"
        Background="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tabs -->
        <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTab}" BorderThickness="0" Background="Transparent" Margin="0,0,0,20">
            <TabItem Header="URL"/>
            <TabItem Header="Upload"/>
        </TabControl>

        <!-- Content -->
        <Grid Grid.Row="1">
            <!-- Tab 0: URL -->
            <StackPanel Visibility="{Binding IsUrlTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="PDF URL" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox Text="{Binding PdfUrl, UpdateSourceTrigger=PropertyChanged}"
                         Height="40" FontSize="14" Padding="10"
                         mah:ControlsHelper.CornerRadius="8"
                         BorderBrush="#d2d2d7" BorderThickness="1"
                         Margin="0,0,0,20"/>

                <TextBlock Text="Link Text (Optional)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox Text="{Binding LinkText, UpdateSourceTrigger=PropertyChanged}"
                         Height="40" FontSize="14" Padding="10"
                         mah:ControlsHelper.CornerRadius="8"
                         BorderBrush="#d2d2d7" BorderThickness="1"/>
            </StackPanel>

            <!-- Tab 1: Upload -->
            <StackPanel Visibility="{Binding IsUploadTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Command="{Binding BrowseFileCommand}" 
                        Height="50" Margin="0,0,0,20"
                        Style="{StaticResource SecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FolderOpen" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Choose PDF"/>
                    </StackPanel>
                </Button>

                <StackPanel Visibility="{Binding IsUploading, Converter={StaticResource BooleanToVisibilityConverter}}"
                            HorizontalAlignment="Center" Margin="0,20">
                    <mah:ProgressRing IsActive="True" Width="40" Height="40" Foreground="#191970"/>
                    <TextBlock Text="Uploading..." FontSize="14" Foreground="#666" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Visibility="{Binding IsUploadSuccess, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Background="#E8F5E9" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CheckCircle" Width="20" Height="20" Foreground="#4CAF50" Margin="0,0,10,0"/>
                            <TextBlock Text="✓ PDF uploaded successfully" FontSize="14" Foreground="#2E7D32"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Link Text (Optional)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding LinkText, UpdateSourceTrigger=PropertyChanged}"
                             Height="40" FontSize="14" Padding="10"
                             mah:ControlsHelper.CornerRadius="8"
                             BorderBrush="#d2d2d7" BorderThickness="1"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Actions -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Cancel" Click="OnCancelClick"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="100" Padding="15,10"/>

            <Button Grid.Column="3" Content="Insert" Click="OnInsertClick"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="100" Padding="15,10"
                    IsEnabled="{Binding HasValidUrl}"/>
        </Grid>
    </Grid>
</mah:MetroWindow>
