# Database Configuration
SA_PASSWORD=Mk123456@Abc
ACCEPT_EULA=Y
SQL_SERVER_HOST=sqlserver
SQL_SERVER_PORT=1433

# PostgreSQL Configuration
POSTGRES_USER=ucode
POSTGRES_PASSWORD=Mk123456@Abc
POSTGRES_DB=UserServiceDb
POSTGRES_HOST=ucode-postgres
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5433

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# ASP.NET Core Configuration
ASPNETCORE_ENVIRONMENT=Development
DOTNET_USE_POLLING_FILE_WATCHER=true

# Connection Strings (use port 1433 for internal Docker network)
USER_SERVICE_CONNECTION_STRING=Host=ucode-postgres;Database=UserServiceDb;Username=ucode;Password=Mk123456@Abc
ASSIGNMENT_SERVICE_CONNECTION_STRING=Host=ucode-postgres;Database=AssignmentServiceDb;Username=ucode;Password=Mk123456@Abc

# Service URLs (for API Gateway)
USER_SERVICE_URL=http://user-service:5001/
ASSIGNMENT_SERVICE_URL=http://assignment-service:5002/

# Ports
SQLSERVER_EXTERNAL_PORT=1436
RABBITMQ_PORT_EXTERNAL=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Executor
MAX_CONCURRENT_SUBMISSIONS=10
MAX_WORKERS_PER_SUBMISSION=30
DEFAULT_MEMORY_LIMIT=128
DEFAULT_TIME_LIMIT=2
MEMORY_THRESHOLD=90
CPU_THRESHOLD=90

# AWS S3 Configuration (for file-service) - TODO: Update with real credentials
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=ucode-dev-bucket
AWS_ACCESS_KEY_ID=dummy-key-for-dev
AWS_SECRET_ACCESS_KEY=dummy-secret-for-dev